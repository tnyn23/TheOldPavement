@page "/Lookbook"
@model Web.Pages.LookbookModel
@{
    ViewData["Title"] = "Lookbook - The Old Pavement";
}

<style>
    /* Hotspot Pulse effect */
    .hotspot-dot {
        width: 16px;
        height: 16px;
        background-color: #FFFFFF;
        border-radius: 50%;
        box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.3), 0 4px 10px rgba(0, 0, 0, 0.4);
        position: relative;
        cursor: pointer;
        transition: transform 200ms ease;
    }
    .hotspot-dot:hover {
        transform: scale(1.2);
    }
    .hotspot-dot::after {
        content: '';
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        border: 2px solid #FFFFFF;
        opacity: 0.8;
        animation: pulse-ring 1.5s cubic-bezier(0.215, 0.610, 0.355, 1) infinite;
    }
    @@keyframes pulse-ring {
        0% { transform: scale(0.5); opacity: 1; }
        100% { transform: scale(1.6); opacity: 0; }
    }
</style>

<main class="pt-8 px-4 md:px-8 lg:px-16 max-w-[1400px] mx-auto pb-16">
    <!-- Header -->
    <div class="border-b border-gray-200 pb-6 mb-12">
        <p class="text-xs tracking-widest text-gray-400 font-bold uppercase mb-2">EDITORIAL CAMPAIGNS</p>
        <h1 class="text-4xl md:text-5xl font-black tracking-tight text-gray-950 uppercase">LOOKBOOK</h1>
    </div>

    <!-- Lookbook Campaign List -->
    <div class="space-y-24">
        @foreach (var lb in Model.Lookbooks)
        {
            <div class="space-y-6">
                <!-- Info Header -->
                <div class="max-w-2xl">
                    <span class="text-xs font-mono font-bold text-gray-400 tracking-widest uppercase">CAMPAIGN #0@lb.Id</span>
                    <h2 class="text-2xl md:text-3xl font-black text-gray-950 uppercase mt-1">@lb.Name</h2>
                    <p class="text-sm text-gray-600 leading-relaxed mt-2">@lb.Description</p>
                </div>

                <!-- Lookbook Image Container with Hotspots -->
                <div class="relative bg-gray-150 border border-gray-200 aspect-[16/10] overflow-hidden select-none">
                    <img src="@lb.ImageUrl" alt="@lb.Name" class="w-full h-full object-cover" />
                    
                    <!-- Hotspots Loop -->
                    @foreach (var hs in lb.Hotspots)
                    {
                        <!-- Hotspot Wrapper -->
                        <div class="absolute pointer-events-auto" style="top: @(hs.TopPercent)%; left: @(hs.LeftPercent)%;">
                            <div class="relative group">
                                <!-- Pulsing Dot -->
                                <div class="hotspot-dot"></div>
                                
                                <!-- Floating Tooltip Card (Monochrome Streetwear styling) -->
                                <div class="absolute bottom-6 left-1/2 -translate-x-1/2 bg-black text-white p-4 w-56 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 shadow-xl border border-neutral-800 z-30">
                                    <span class="block text-[8px] font-black text-neutral-400 uppercase tracking-widest mb-1">FEATURED PRODUCT</span>
                                    <h4 class="text-xs font-bold uppercase tracking-wide truncate mb-1">@hs.ProductName</h4>
                                    <span class="block text-xs font-semibold text-neutral-200 mb-3">@hs.ProductPrice.ToString("N0")₫</span>
                                    <a href="/Product/@hs.ProductSlug" class="block text-center bg-white text-black py-2 text-[10px] font-black uppercase tracking-widest hover:bg-neutral-200 transition-colors pointer-events-auto">
                                        MUA NGAY
                                    </a>
                                    <!-- Tip caret pointing down -->
                                    <div class="absolute top-full left-1/2 -translate-x-1/2 w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-t-[6px] border-t-black"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</main>
