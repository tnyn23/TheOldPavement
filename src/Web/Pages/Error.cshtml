@page
@model ErrorModel
@{
    ViewData["Title"] = "Đã có lỗi xảy ra";
}
<main class="page-shell">
    <div class="page-container pb-16 min-h-[70vh] flex items-center justify-center">
        <div class="bg-white border border-gray-200 rounded-3xl p-12 shadow-sm text-center max-w-2xl w-full">
            <div class="mb-6">
                <h1 class="text-5xl font-black text-red-600 mb-4">Oops!</h1>
                <p class="text-lg text-gray-700 mb-2">Có lỗi xảy ra khi xử lý yêu cầu của bạn.</p>
                <p class="text-sm text-gray-500">Vui lòng thử lại hoặc quay lại trang trước.</p>
            </div>

            @if (Model.ShowRequestId)
            {
                <div class="bg-gray-50 border border-gray-200 rounded-2xl p-4 text-left text-sm text-gray-600 mb-6">
                    <span class="font-semibold">Mã yêu cầu:</span> @Model.RequestId
                </div>
            }

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="/" class="inline-flex items-center justify-center px-8 py-3 border border-black bg-black text-white text-sm font-semibold uppercase tracking-wider hover:bg-gray-800 transition-colors">Về trang chủ</a>
                <a href="javascript:history.back()" class="inline-flex items-center justify-center px-8 py-3 border border-gray-300 bg-white text-sm font-semibold uppercase tracking-wider hover:border-black hover:text-black transition-colors">Quay lại</a>
            </div>
        </div>
    </div>
</main>
