@page
@model Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin — The Old Pavement";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="h-full">

@{
    var pendingCount = Model.Orders.Count(o => o.Status == "pending");
    var lowStockCount = Model.ProductVariants.Count(v => v.StockQuantity <= 15);
    var maxDay = Model.SalesByDay.Max();
    var days = new[] { "T2", "T3", "T4", "T5", "T6", "T7", "CN" };
    var lowStockItems = Model.ProductVariants.Where(v => v.StockQuantity <= 15).OrderBy(v => v.StockQuantity).Take(6).ToList();
    var recentOrders = Model.Orders.OrderByDescending(o => o.CreatedAt).Take(8).ToList();
}

<!-- ═══════════════════════════════════════════════════════════
     LAYOUT SHELL
═══════════════════════════════════════════════════════════ -->
<div class="flex h-screen overflow-hidden">

    <!-- Mobile overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-30 lg:hidden" onclick="closeMobileSidebar()"></div>

    <!-- ══════════════════════════════════════════════════════
         SIDEBAR — Desktop
    ══════════════════════════════════════════════════════ -->
    <aside class="hidden lg:flex flex-col w-[220px] border-r border-gray-100 bg-white flex-shrink-0 h-full overflow-y-auto scrollbar-thin">
        <!-- Brand mark -->
        <div class="px-5 pt-6 pb-5 border-b border-gray-100">
            <a href="/" class="flex items-center gap-3 group">
                <div class="w-8 h-8 bg-black flex items-center justify-center flex-shrink-0">
                    <span class="text-white font-black text-[10px] tracking-widest">OP</span>
                </div>
                <div>
                    <p class="text-[11px] font-black tracking-[0.15em] text-gray-900 uppercase leading-none">The Old Pavement</p>
                    <p class="text-[9px] text-gray-400 tracking-widest uppercase mt-0.5">Admin</p>
                </div>
            </a>
        </div>

        <!-- Nav -->
        <nav class="flex-1 px-3 py-4 space-y-0.5">
            <p class="px-3 mb-2 text-[9px] font-bold tracking-[0.12em] text-gray-300 uppercase">Workspace</p>
            <button onclick="switchTab('analytics')" data-tab="analytics" class="nav-link active">
                <i data-lucide="layout-dashboard" class="w-4 h-4 flex-shrink-0"></i>
                <span>Overview</span>
            </button>
            <button onclick="switchTab('orders')" data-tab="orders" class="nav-link">
                <i data-lucide="receipt" class="w-4 h-4 flex-shrink-0"></i>
                <span>Đơn hàng</span>
                @if (pendingCount > 0)
                {
                    <span class="badge-dot bg-amber-100 text-amber-700">@pendingCount</span>
                }
            </button>
            <button onclick="switchTab('products')" data-tab="products" class="nav-link">
                <i data-lucide="package" class="w-4 h-4 flex-shrink-0"></i>
                <span>Sản phẩm</span>
            </button>
            <button onclick="switchTab('inventory')" data-tab="inventory" class="nav-link">
                <i data-lucide="boxes" class="w-4 h-4 flex-shrink-0"></i>
                <span>Tồn kho</span>
                @if (lowStockCount > 0)
                {
                    <span class="badge-dot bg-red-100 text-red-600">@lowStockCount</span>
                }
            </button>
            <button onclick="switchTab('coupons')" data-tab="coupons" class="nav-link">
                <i data-lucide="ticket" class="w-4 h-4 flex-shrink-0"></i>
                <span>Khuyến mãi</span>
            </button>
        </nav>

        <!-- Footer -->
        <div class="px-3 py-4 border-t border-gray-100 space-y-0.5">
            <a href="/" target="_blank" class="nav-link">
                <i data-lucide="external-link" class="w-4 h-4 flex-shrink-0"></i>
                <span>Xem cửa hàng</span>
            </a>
            <a href="/Public/Account/Logout" class="nav-link" style="color:#dc2626">
                <i data-lucide="log-out" class="w-4 h-4 flex-shrink-0"></i>
                <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <!-- ══════════════════════════════════════════════════════
         SIDEBAR — Mobile
    ══════════════════════════════════════════════════════ -->
    <aside id="mobile-sidebar" class="fixed top-0 left-0 h-full w-64 bg-white border-r border-gray-100 z-40 flex flex-col lg:hidden overflow-y-auto scrollbar-thin">
        <div class="px-5 py-5 border-b border-gray-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-7 h-7 bg-black flex items-center justify-center">
                    <span class="text-white font-black text-[9px] tracking-widest">OP</span>
                </div>
                <span class="text-[11px] font-black tracking-widest text-gray-900 uppercase">Admin</span>
            </div>
            <button onclick="closeMobileSidebar()" class="btn-icon">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
        <nav class="flex-1 px-3 py-4 space-y-0.5">
            <button onclick="switchTab('analytics'); closeMobileSidebar();" class="nav-link active" data-tab="analytics-m">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i><span>Overview</span>
            </button>
            <button onclick="switchTab('orders'); closeMobileSidebar();" class="nav-link" data-tab="orders-m">
                <i data-lucide="receipt" class="w-4 h-4"></i><span>Đơn hàng</span>
                @if (pendingCount > 0) { <span class="badge-dot bg-amber-100 text-amber-700 ml-auto">@pendingCount</span> }
            </button>
            <button onclick="switchTab('products'); closeMobileSidebar();" class="nav-link" data-tab="products-m">
                <i data-lucide="package" class="w-4 h-4"></i><span>Sản phẩm</span>
            </button>
            <button onclick="switchTab('inventory'); closeMobileSidebar();" class="nav-link" data-tab="inventory-m">
                <i data-lucide="boxes" class="w-4 h-4"></i><span>Tồn kho</span>
                @if (lowStockCount > 0) { <span class="badge-dot bg-red-100 text-red-600 ml-auto">@lowStockCount</span> }
            </button>
            <button onclick="switchTab('coupons'); closeMobileSidebar();" class="nav-link" data-tab="coupons-m">
                <i data-lucide="ticket" class="w-4 h-4"></i><span>Khuyến mãi</span>
            </button>
        </nav>
        <div class="px-3 py-4 border-t border-gray-100 space-y-0.5">
            <a href="/" target="_blank" class="nav-link"><i data-lucide="external-link" class="w-4 h-4"></i><span>Xem cửa hàng</span></a>
            <a href="/Public/Account/Logout" class="nav-link" style="color:#dc2626"><i data-lucide="log-out" class="w-4 h-4"></i><span>Đăng xuất</span></a>
        </div>
    </aside>

    <!-- ══════════════════════════════════════════════════════
         MAIN CONTENT AREA
    ══════════════════════════════════════════════════════ -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">

        <!-- ── TOPBAR ── -->
        <header class="flex-shrink-0 h-14 border-b border-gray-100 bg-white flex items-center px-4 md:px-6 gap-4 z-20">
            <button onclick="openMobileSidebar()" class="lg:hidden btn-icon">
                <i data-lucide="menu" class="w-4 h-4"></i>
            </button>
            <div class="flex-1 min-w-0">
                <h1 id="page-title" class="text-sm font-semibold text-gray-900 truncate">Overview</h1>
                <p id="page-sub" class="text-[11px] text-gray-400 hidden sm:block">The Old Pavement Admin Panel</p>
            </div>
            <div class="flex items-center gap-2">
                @if (pendingCount > 0)
                {
                    <button onclick="switchTab('orders')"
                        class="hidden sm:flex items-center gap-1.5 text-[11px] font-bold text-amber-700 bg-amber-50 border border-amber-200 px-3 py-1.5 rounded-md hover:bg-amber-100 transition-colors">
                        <i data-lucide="bell" class="w-3.5 h-3.5"></i>
                        @pendingCount đơn chờ
                    </button>
                }
                @if (lowStockCount > 0)
                {
                    <button onclick="switchTab('inventory')"
                        class="hidden sm:flex items-center gap-1.5 text-[11px] font-bold text-red-600 bg-red-50 border border-red-200 px-3 py-1.5 rounded-md hover:bg-red-100 transition-colors">
                        <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>
                        @lowStockCount sắp hết
                    </button>
                }
                <div class="w-8 h-8 rounded-full bg-gray-900 flex items-center justify-center flex-shrink-0">
                    <i data-lucide="user" class="w-3.5 h-3.5 text-white"></i>
                </div>
            </div>
        </header>

        <!-- ── TOAST ── -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div id="toast-msg" class="toast">
                <div class="w-5 h-5 rounded-full bg-emerald-500 flex items-center justify-center flex-shrink-0">
                    <i data-lucide="check" class="w-3 h-3 text-white"></i>
                </div>
                <span>@TempData["SuccessMessage"]</span>
                <button onclick="document.getElementById('toast-msg').remove()" class="ml-2 opacity-60 hover:opacity-100">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div id="toast-err" class="toast" style="background:#dc2626">
                <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
                <span>@TempData["ErrorMessage"]</span>
                <button onclick="document.getElementById('toast-err').remove()" class="ml-2 opacity-60 hover:opacity-100">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                </button>
            </div>
        }

        <!-- ── SCROLLABLE CONTENT ── -->
        <main class="flex-1 overflow-y-auto scrollbar-thin">

            <!-- ════════════════════════════════════════════
                 TAB: OVERVIEW / ANALYTICS
            ════════════════════════════════════════════ -->
            <div id="tab-analytics" class="tab-panel active px-4 md:px-6 py-6 space-y-5">

                <!-- KPI Row -->
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                    <!-- Revenue — hero card -->
                    <div class="stat-card lg:col-span-1 relative overflow-hidden">
                        <div class="flex items-start justify-between mb-3">
                            <span class="stat-label">Doanh thu</span>
                            <div class="w-7 h-7 bg-gray-50 rounded-md flex items-center justify-center">
                                <i data-lucide="trending-up" class="w-3.5 h-3.5 text-gray-500"></i>
                            </div>
                        </div>
                        <p class="stat-value count-animate">@Model.TotalRevenue.ToString("N0")₫</p>
                        <p class="stat-sub">Tổng tất cả đơn hàng</p>
                    </div>
                    <!-- Orders -->
                    <div class="stat-card">
                        <div class="flex items-start justify-between mb-3">
                            <span class="stat-label">Đơn hàng</span>
                            <div class="w-7 h-7 bg-gray-50 rounded-md flex items-center justify-center">
                                <i data-lucide="shopping-bag" class="w-3.5 h-3.5 text-gray-500"></i>
                            </div>
                        </div>
                        <p class="stat-value count-animate">@Model.TotalOrdersCount</p>
                        <p class="stat-sub">@pendingCount đơn đang chờ</p>
                    </div>
                    <!-- Products -->
                    <div class="stat-card">
                        <div class="flex items-start justify-between mb-3">
                            <span class="stat-label">Sản phẩm</span>
                            <div class="w-7 h-7 bg-gray-50 rounded-md flex items-center justify-center">
                                <i data-lucide="package" class="w-3.5 h-3.5 text-gray-500"></i>
                            </div>
                        </div>
                        <p class="stat-value count-animate">@Model.TotalProductsCount</p>
                        <p class="stat-sub">Đang hoạt động</p>
                    </div>
                    <!-- Customers -->
                    <div class="stat-card">
                        <div class="flex items-start justify-between mb-3">
                            <span class="stat-label">Khách hàng</span>
                            <div class="w-7 h-7 bg-gray-50 rounded-md flex items-center justify-center">
                                <i data-lucide="users" class="w-3.5 h-3.5 text-gray-500"></i>
                            </div>
                        </div>
                        <p class="stat-value count-animate">@Model.TotalUsersCount</p>
                        <p class="stat-sub">Thành viên đã đăng ký</p>
                    </div>
                </div>

                <!-- Chart row -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                    <!-- Weekly Revenue Chart -->
                    <div class="panel lg:col-span-2">
                        <div class="panel-header">
                            <div>
                                <p class="panel-title">Doanh thu theo ngày</p>
                                <p class="panel-sub">Tuần hiện tại — T2 đến CN</p>
                            </div>
                            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider bg-gray-50 px-2.5 py-1 rounded-md">7 ngày</span>
                        </div>
                        <div class="px-5 pb-5 pt-4">
                            <div class="flex items-end gap-2" style="height:120px">
                                @for (int i = 0; i < 7; i++)
                                {
                                    var val = Model.SalesByDay[i];
                                    var pct = maxDay > 0 ? (int)(val * 100 / maxDay) : 4;
                                    if (pct < 4) pct = 4;
                                    var isToday = (int)DateTime.Now.DayOfWeek == (i == 6 ? 0 : i + 1);
                                    <div class="flex-1 flex flex-col items-center gap-1.5 h-full justify-end group">
                                        <span class="text-[9px] font-semibold text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">
                                            @(val > 0 ? val.ToString("N0") + "₫" : "—")
                                        </span>
                                        <div class="chart-bar w-full @(isToday ? "bg-gray-900" : "bg-gray-200") group-hover:bg-gray-700"
                                             style="height:@(pct)%"></div>
                                        <span class="text-[10px] font-medium @(isToday ? "text-gray-900 font-bold" : "text-gray-400")">@days[i]</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Payment + Top Products -->
                    <div class="panel">
                        <div class="panel-header">
                            <div>
                                <p class="panel-title">Kênh thanh toán</p>
                                <p class="panel-sub">Phân bổ phương thức</p>
                            </div>
                        </div>
                        <div class="px-5 py-4 space-y-4">
                            <div>
                                <div class="flex justify-between items-center mb-2">
                                    <span class="text-xs font-medium text-gray-600">COD</span>
                                    <span class="text-xs font-bold text-gray-900">@Model.CodPercentage%</span>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill bg-gray-900" style="width:@(Model.CodPercentage)%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between items-center mb-2">
                                    <span class="text-xs font-medium text-gray-600">Chuyển khoản</span>
                                    <span class="text-xs font-bold text-gray-900">@Model.TransferPercentage%</span>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill bg-gray-400" style="width:@(Model.TransferPercentage)%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="px-5 pb-5 pt-1 border-t border-gray-50">
                            <p class="text-[10px] font-bold tracking-[0.1em] text-gray-400 uppercase mb-3 mt-3">Bán chạy nhất</p>
                            <div class="space-y-2.5">
                                @if (Model.TopSellingProducts.Any())
                                {
                                    int rank = 1;
                                    foreach (var tp in Model.TopSellingProducts)
                                    {
                                        <div class="flex items-center gap-2.5">
                                            <span class="text-[10px] font-black text-gray-300 w-4 flex-shrink-0 tabular-nums">@(rank++)</span>
                                            <span class="text-xs font-medium text-gray-700 flex-1 truncate">@tp.Name</span>
                                            <span class="text-[10px] font-bold text-gray-500 flex-shrink-0">×@tp.SalesCount</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-xs text-gray-400">Chưa có dữ liệu.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Orders + Quick Actions + Low Stock -->
                <div class="grid grid-cols-1 lg:grid-cols-5 gap-4">
                    <!-- Recent Orders -->
                    <div class="panel lg:col-span-3">
                        <div class="panel-header">
                            <div class="flex items-center gap-2">
                                <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
                                <p class="panel-title">Đơn hàng gần nhất</p>
                            </div>
                            <button onclick="switchTab('orders')" class="text-[11px] font-semibold text-gray-400 hover:text-gray-900 transition-colors">
                                Xem tất cả →
                            </button>
                        </div>
                        <div class="divide-y divide-gray-50">
                            @if (recentOrders.Any())
                            {
                                foreach (var ro in recentOrders)
                                {
                                    var st = ro.Status?.ToLower() ?? "pending";
                                    var (badgeCls, lbl) = st switch {
                                        "delivered"  => ("badge-delivered",  "Đã giao"),
                                        "shipped"    => ("badge-shipped",    "Đang giao"),
                                        "processing" => ("badge-processing", "Xử lý"),
                                        "cancelled"  => ("badge-cancelled",  "Đã hủy"),
                                        _            => ("badge-pending",    "Chờ xử lý")
                                    };
                                    <div class="flex items-center gap-3 px-5 py-3 hover:bg-gray-50/60 transition-colors">
                                        <div class="flex-1 min-w-0">
                                            <p class="text-xs font-semibold text-gray-900 truncate">@ro.OrderNumber</p>
                                            <p class="text-[11px] text-gray-400 mt-0.5">
                                                @(ro.CreatedAt?.ToString("dd/MM HH:mm") ?? "—")
                                                <span class="mx-1 text-gray-200">·</span>
                                                <span class="font-semibold text-gray-600">@ro.TotalAmount.ToString("N0")₫</span>
                                            </p>
                                        </div>
                                        <span class="badge @badgeCls flex-shrink-0">@lbl</span>
                                        <form method="post" asp-page-handler="UpdateOrderStatus" class="flex-shrink-0">
                                            <input type="hidden" name="orderId" value="@ro.Id" />
                                            <select name="status" onchange="this.form.submit()"
                                                class="form-input form-select text-[11px] py-1 px-2 pr-7 w-auto cursor-pointer">
                                                <option value="pending"    selected="@(st=="pending"    ? "selected" : null)">Chờ</option>
                                                <option value="processing" selected="@(st=="processing" ? "selected" : null)">Xử lý</option>
                                                <option value="shipped"    selected="@(st=="shipped"    ? "selected" : null)">Đang giao</option>
                                                <option value="delivered"  selected="@(st=="delivered"  ? "selected" : null)">Đã giao</option>
                                                <option value="cancelled"  selected="@(st=="cancelled"  ? "selected" : null)">Đã hủy</option>
                                            </select>
                                        </form>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="px-5 py-12 text-center text-xs text-gray-400">Chưa có đơn hàng nào.</div>
                            }
                        </div>
                    </div>

                    <!-- Right column: Quick Actions + Low Stock -->
                    <div class="lg:col-span-2 flex flex-col gap-4">
                        <!-- Quick Actions -->
                        <div class="panel">
                            <div class="panel-header">
                                <p class="panel-title">Thao tác nhanh</p>
                            </div>
                            <div class="p-4 grid grid-cols-2 gap-2">
                                <button onclick="switchTab('products'); setTimeout(openProductModal, 80)" class="quick-action primary">
                                    <i data-lucide="plus" class="w-4 h-4"></i>
                                    Thêm sản phẩm
                                </button>
                                <button onclick="switchTab('orders')" class="quick-action">
                                    <i data-lucide="clipboard-list" class="w-4 h-4"></i>
                                    Quản lý đơn
                                </button>
                                <button onclick="switchTab('inventory')" class="quick-action">
                                    <i data-lucide="boxes" class="w-4 h-4"></i>
                                    Tồn kho
                                </button>
                                <button onclick="switchTab('coupons')" class="quick-action">
                                    <i data-lucide="ticket" class="w-4 h-4"></i>
                                    Khuyến mãi
                                </button>
                            </div>
                        </div>

                        <!-- Low Stock Warning -->
                        @if (lowStockItems.Any())
                        {
                            <div class="panel" style="border-color:#fecaca">
                                <div class="panel-header" style="border-color:#fef2f2">
                                    <div class="flex items-center gap-2">
                                        <i data-lucide="alert-triangle" class="w-4 h-4 text-red-500 flex-shrink-0"></i>
                                        <p class="panel-title">Sắp hết hàng</p>
                                    </div>
                                    <span class="badge badge-low">@lowStockItems.Count</span>
                                </div>
                                <div class="divide-y divide-gray-50">
                                    @foreach (var lv in lowStockItems)
                                    {
                                        var urgCls = lv.StockQuantity <= 5 ? "text-red-600 font-bold" : "text-amber-600 font-semibold";
                                        <div class="flex items-center gap-3 px-5 py-3">
                                            <div class="flex-1 min-w-0">
                                                <p class="text-xs font-medium text-gray-800 truncate">@lv.Product?.Name</p>
                                                <p class="text-[10px] text-gray-400 mt-0.5 uppercase tracking-wide">@lv.Size · @lv.Color</p>
                                            </div>
                                            <span class="text-xs @urgCls flex-shrink-0 tabular-nums">@lv.StockQuantity</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ════════════════════════════════════════════
                 TAB: ORDERS
            ════════════════════════════════════════════ -->
            <div id="tab-orders" class="tab-panel px-4 md:px-6 py-6 space-y-5">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-bold text-gray-900">Đơn hàng</h2>
                        <p class="text-xs text-gray-400 mt-0.5">@Model.TotalOrdersCount đơn hàng · @pendingCount đang chờ xử lý</p>
                    </div>
                </div>
                <div class="panel overflow-x-auto">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Thời gian</th>
                                <th>Sản phẩm</th>
                                <th>Tổng tiền</th>
                                <th>Thanh toán</th>
                                <th>Trạng thái</th>
                                <th>Cập nhật</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Orders.Any())
                            {
                                foreach (var o in Model.Orders.OrderByDescending(x => x.CreatedAt))
                                {
                                    var st = o.Status?.ToLower() ?? "pending";
                                    var (badgeCls, lbl) = st switch {
                                        "delivered"  => ("badge-delivered",  "Đã giao"),
                                        "shipped"    => ("badge-shipped",    "Đang giao"),
                                        "processing" => ("badge-processing", "Xử lý"),
                                        "cancelled"  => ("badge-cancelled",  "Đã hủy"),
                                        _            => ("badge-pending",    "Chờ xử lý")
                                    };
                                    var pm = o.PaymentMethod?.ToLower() == "cod" ? "COD" : "Chuyển khoản";
                                    var itemCount = o.OrderItems?.Count ?? 0;
                                    <tr>
                                        <td>
                                            <span class="font-mono text-xs font-semibold text-gray-900">@o.OrderNumber</span>
                                        </td>
                                        <td class="text-gray-500 whitespace-nowrap">@(o.CreatedAt?.ToString("dd/MM/yy HH:mm") ?? "—")</td>
                                        <td class="text-gray-600">@itemCount sản phẩm</td>
                                        <td class="font-semibold text-gray-900 tabular-nums whitespace-nowrap">@o.TotalAmount.ToString("N0")₫</td>
                                        <td>
                                            <span class="text-xs text-gray-500">@pm</span>
                                        </td>
                                        <td><span class="badge @badgeCls">@lbl</span></td>
                                        <td>
                                            <form method="post" asp-page-handler="UpdateOrderStatus">
                                                <input type="hidden" name="orderId" value="@o.Id" />
                                                <select name="status" onchange="this.form.submit()"
                                                    class="form-input form-select text-[11px] py-1 px-2 pr-7 w-auto cursor-pointer">
                                                    <option value="pending"    selected="@(st=="pending"    ? "selected" : null)">Chờ</option>
                                                    <option value="processing" selected="@(st=="processing" ? "selected" : null)">Xử lý</option>
                                                    <option value="shipped"    selected="@(st=="shipped"    ? "selected" : null)">Đang giao</option>
                                                    <option value="delivered"  selected="@(st=="delivered"  ? "selected" : null)">Đã giao</option>
                                                    <option value="cancelled"  selected="@(st=="cancelled"  ? "selected" : null)">Đã hủy</option>
                                                </select>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center py-12 text-gray-400 text-sm">Chưa có đơn hàng nào.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ════════════════════════════════════════════
                 TAB: PRODUCTS
            ════════════════════════════════════════════ -->
            <div id="tab-products" class="tab-panel px-4 md:px-6 py-6 space-y-5">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-bold text-gray-900">Sản phẩm</h2>
                        <p class="text-xs text-gray-400 mt-0.5">@Model.TotalProductsCount sản phẩm trong kho</p>
                    </div>
                    <button onclick="openProductModal()" class="btn btn-primary">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                        Thêm sản phẩm
                    </button>
                </div>
                <div class="panel overflow-x-auto">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Danh mục</th>
                                <th>Giá</th>
                                <th>Biến thể</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Products.Any())
                            {
                                foreach (var p in Model.Products)
                                {
                                    var img = p.ProductImages?.FirstOrDefault(i => i.IsPrimary == true)?.ImageUrl
                                           ?? p.ProductImages?.FirstOrDefault()?.ImageUrl
                                           ?? "https://images.unsplash.com/photo-1651761179569-4ba2aa054997?w=80&q=60";
                                    var statusCls = p.Status?.ToLower() == "available" ? "badge-active" : "badge-inactive";
                                    var statusLbl = p.Status?.ToLower() == "available" ? "Đang bán" : "Ẩn";
                                    var variantCount = p.ProductVariants?.Count ?? 0;
                                    <tr>
                                        <td>
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 bg-gray-50 border border-gray-100 rounded-md overflow-hidden flex-shrink-0">
                                                    <img src="@img" alt="@p.Name" class="w-full h-full object-cover" loading="lazy" />
                                                </div>
                                                <div class="min-w-0">
                                                    <p class="text-xs font-semibold text-gray-900 truncate max-w-[180px]">@p.Name</p>
                                                    <p class="text-[10px] text-gray-400 font-mono mt-0.5">@p.Slug</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="text-xs text-gray-500 uppercase tracking-wide font-medium">@p.Category</span></td>
                                        <td class="font-semibold text-gray-900 tabular-nums whitespace-nowrap">@p.Price.ToString("N0")₫</td>
                                        <td class="text-gray-500 text-xs">@variantCount biến thể</td>
                                        <td><span class="badge @statusCls">@statusLbl</span></td>
                                        <td class="text-gray-400 text-xs whitespace-nowrap">@(p.CreatedAt?.ToString("dd/MM/yy") ?? "—")</td>
                                        <td>
                                            <div class="flex items-center gap-1">
                                                @{
                                                    var imgSlots = new (string Url, string Color)[3];
                                                    for (int si = 0; si < 3; si++)
                                                    {
                                                        var slotImg = p.ProductImages?.FirstOrDefault(x => x.DisplayOrder == si);
                                                        imgSlots[si] = (slotImg?.ImageUrl ?? "", slotImg?.AltText ?? "");
                                                    }
                                                    var imgJson = System.Text.Json.JsonSerializer.Serialize(
                                                        imgSlots.Select(s => new { url = s.Url, color = s.Color }));
                                                }
                                                <button type="button"
                                                    class="btn-icon edit-product-btn" title="Sửa"
                                                    data-id="@p.Id"
                                                    data-name="@p.Name"
                                                    data-slug="@p.Slug"
                                                    data-price="@p.Price"
                                                    data-category="@p.Category"
                                                    data-status="@p.Status"
                                                    data-images="@imgJson">
                                                    <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                                </button>
                                                <form method="post" asp-page-handler="DeleteProduct" onsubmit="return confirm('Xóa sản phẩm này?')">
                                                    <input type="hidden" name="id" value="@p.Id" />
                                                    <button type="submit" class="btn-icon" style="color:#dc2626;border-color:#fecaca" title="Xóa">
                                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center py-12 text-gray-400 text-sm">Chưa có sản phẩm nào.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ════════════════════════════════════════════
                 TAB: INVENTORY
            ════════════════════════════════════════════ -->
            <div id="tab-inventory" class="tab-panel px-4 md:px-6 py-6 space-y-5">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-bold text-gray-900">Tồn kho</h2>
                        <p class="text-xs text-gray-400 mt-0.5">@Model.ProductVariants.Count biến thể · @lowStockCount sắp hết hàng</p>
                    </div>
                    @if (lowStockCount > 0)
                    {
                        <span class="badge badge-low">
                            <i data-lucide="alert-triangle" class="w-3 h-3"></i>
                            @lowStockCount cảnh báo
                        </span>
                    }
                </div>
                <div class="panel overflow-x-auto">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>SKU</th>
                                <th>Size</th>
                                <th>Màu</th>
                                <th>Tồn kho</th>
                                <th>Trạng thái</th>
                                <th>Cập nhật</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ProductVariants.Any())
                            {
                                foreach (var v in Model.ProductVariants.OrderBy(x => x.StockQuantity))
                                {
                                    var stockCls = v.StockQuantity <= 5 ? "text-red-600 font-bold" : v.StockQuantity <= 15 ? "text-amber-600 font-semibold" : "text-gray-700";
                                    var stockBadge = v.StockQuantity <= 5 ? "badge-low" : v.StockQuantity <= 15 ? "badge badge-pending" : "badge-ok";
                                    var stockLbl = v.StockQuantity <= 5 ? "Nguy hiểm" : v.StockQuantity <= 15 ? "Thấp" : "Ổn";
                                    <tr>
                                        <td>
                                            <p class="text-xs font-medium text-gray-900 truncate max-w-[160px]">@v.Product?.Name</p>
                                        </td>
                                        <td><span class="font-mono text-[11px] text-gray-400">@v.Sku</span></td>
                                        <td><span class="text-xs font-semibold text-gray-700">@v.Size</span></td>
                                        <td>
                                            <div class="flex items-center gap-1.5">
                                                @if (!string.IsNullOrEmpty(v.ColorHex))
                                                {
                                                    <span class="w-3 h-3 rounded-full border border-gray-200 flex-shrink-0" style="background:@v.ColorHex"></span>
                                                }
                                                <span class="text-xs text-gray-600">@v.Color</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="@stockCls tabular-nums text-sm">@v.StockQuantity</span>
                                        </td>
                                        <td><span class="badge @stockBadge">@stockLbl</span></td>
                                        <td>
                                            <form method="post" asp-page-handler="UpdateStock" class="flex items-center gap-1.5">
                                                <input type="hidden" name="variantId" value="@v.Id" />
                                                <input type="number" name="stockQuantity" value="@v.StockQuantity" min="0"
                                                    class="form-input w-20 text-xs py-1 tabular-nums" />
                                                <button type="submit" class="btn btn-secondary btn-sm">Lưu</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center py-12 text-gray-400 text-sm">Chưa có biến thể nào.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ════════════════════════════════════════════
                 TAB: COUPONS
            ════════════════════════════════════════════ -->
            <div id="tab-coupons" class="tab-panel px-4 md:px-6 py-6 space-y-5">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-bold text-gray-900">Mã khuyến mãi</h2>
                        <p class="text-xs text-gray-400 mt-0.5">@Model.PromoCodes.Count mã · @Model.PromoCodes.Count(p => p.IsActive == true) đang hoạt động</p>
                    </div>
                    <button onclick="openPromoModal()" class="btn btn-primary">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                        Thêm mã
                    </button>
                </div>
                <div class="panel overflow-x-auto">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Mã</th>
                                <th>Loại</th>
                                <th>Giá trị</th>
                                <th>Đơn tối thiểu</th>
                                <th>Đã dùng / Giới hạn</th>
                                <th>Hiệu lực</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PromoCodes.Any())
                            {
                                foreach (var pc in Model.PromoCodes.OrderByDescending(x => x.Id))
                                {
                                    var activeCls = pc.IsActive == true ? "badge-active" : "badge-inactive";
                                    var activeLbl = pc.IsActive == true ? "Hoạt động" : "Vô hiệu";
                                    var typeLabel = pc.Type == "percentage" ? "%" : "₫";
                                    var valueStr = pc.Type == "percentage" ? $"-{pc.Value:0}%" : $"-{pc.Value:N0}₫";
                                    <tr>
                                        <td>
                                            <span class="font-mono text-xs font-bold text-gray-900 bg-gray-50 border border-gray-200 px-2 py-0.5 rounded">@pc.Code</span>
                                        </td>
                                        <td><span class="text-xs text-gray-500 uppercase tracking-wide">@(pc.Type == "percentage" ? "Phần trăm" : "Cố định")</span></td>
                                        <td class="font-semibold text-gray-900">@valueStr</td>
                                        <td class="text-gray-500 text-xs tabular-nums">@(pc.MinOrderValue.HasValue ? pc.MinOrderValue.Value.ToString("N0") + "₫" : "—")</td>
                                        <td class="text-gray-500 text-xs tabular-nums">@pc.UsedCount / @(pc.UsageLimit.HasValue ? pc.UsageLimit.Value.ToString() : "∞")</td>
                                        <td class="text-gray-400 text-xs whitespace-nowrap">
                                            @(pc.StartDate.ToString("dd/MM/yy")) → @(pc.EndDate.ToString("dd/MM/yy"))
                                        </td>
                                        <td><span class="badge @activeCls">@activeLbl</span></td>
                                        <td>
                                            <div class="flex items-center gap-1">
                                                <button onclick="openEditPromoModal(@pc.Id, '@pc.Code', '@pc.Type', @pc.Value, @(pc.MinOrderValue.HasValue ? pc.MinOrderValue.Value.ToString() : "0"), @(pc.UsageLimit.HasValue ? pc.UsageLimit.Value.ToString() : "0"), '@pc.StartDate.ToString("yyyy-MM-dd")', '@pc.EndDate.ToString("yyyy-MM-dd")', @(pc.IsActive == true ? "true" : "false"))"
                                                    class="btn-icon" title="Sửa">
                                                    <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                                </button>
                                                <form method="post" asp-page-handler="DeletePromoCode">
                                                    <input type="hidden" name="id" value="@pc.Id" />
                                                    <button type="submit" class="btn-icon" style="color:#dc2626;border-color:#fecaca" title="Vô hiệu hóa">
                                                        <i data-lucide="ban" class="w-3.5 h-3.5"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="8" class="text-center py-12 text-gray-400 text-sm">Chưa có mã khuyến mãi nào.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════
     MODAL: ADD / EDIT PRODUCT
═══════════════════════════════════════════════════════════ -->
<div id="product-modal" class="modal-backdrop" onclick="if(event.target===this)closeProductModal()">
    <div class="modal-box">
        <div class="modal-header">
            <div>
                <h3 id="product-modal-title" class="text-sm font-bold text-gray-900">Thêm sản phẩm mới</h3>
                <p class="text-[11px] text-gray-400 mt-0.5">Điền thông tin sản phẩm bên dưới</p>
            </div>
            <button onclick="closeProductModal()" class="btn-icon">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
        <form method="post" asp-page-handler="SaveProduct" enctype="multipart/form-data">
            <div class="modal-body space-y-4">
                <input type="hidden" id="product-id" name="id" value="" />
                <div class="grid grid-cols-2 gap-4">
                    <div class="col-span-2">
                        <label class="form-label">Tên sản phẩm</label>
                        <input type="text" id="product-name" name="name" required class="form-input" placeholder="VD: Classic Black Tee" />
                    </div>
                    <div class="col-span-2">
                        <label class="form-label">Slug (URL)</label>
                        <input type="text" id="product-slug" name="slug" required class="form-input" placeholder="classic-black-tee" />
                    </div>
                    <div>
                        <label class="form-label">Giá (₫)</label>
                        <input type="number" id="product-price" name="price" required min="0" class="form-input" placeholder="425000" />
                    </div>
                    <div>
                        <label class="form-label">Danh mục</label>
                        <select id="product-category" name="category" class="form-input form-select">
                            <option value="tee">Tee</option>
                            <option value="hoodie">Hoodie</option>
                            <option value="pants">Pants</option>
                            <option value="jacket">Jacket</option>
                            <option value="accessories">Accessories</option>
                        </select>
                    </div>
                    <div class="col-span-2">
                        <label class="form-label">Trạng thái</label>
                        <select id="product-status" name="status" class="form-input form-select">
                            <option value="available">Đang bán</option>
                            <option value="hidden">Ẩn</option>
                        </select>
                    </div>
                </div>
                <!-- Image slots -->
                <div>
                    <label class="form-label">Hình ảnh (tối đa 3 ảnh)</label>
                    <div class="grid grid-cols-3 gap-3">
                        @for (int i = 0; i < 3; i++)
                        {
                            <div class="space-y-1.5">
                                <div class="aspect-square bg-gray-50 border border-dashed border-gray-200 rounded-lg flex items-center justify-center overflow-hidden relative group cursor-pointer"
                                     onclick="document.getElementById('img-@i').click()">
                                    <i data-lucide="image-plus" class="w-6 h-6 text-gray-300 group-hover:text-gray-500 transition-colors"></i>
                                    <input type="file" id="img-@i" name="imageFiles[@i]" accept="image/*" class="hidden"
                                           onchange="previewImage(this, 'preview-@i')" />
                                    <img id="preview-@i" class="absolute inset-0 w-full h-full object-cover hidden" />
                                </div>
                                <input type="text" name="imageColor[@i]" class="form-input text-[11px] py-1" placeholder="Màu (vd: black)" />
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeProductModal()" class="btn btn-secondary">Hủy</button>
                <button type="submit" class="btn btn-primary">
                    <i data-lucide="save" class="w-3.5 h-3.5"></i>
                    Lưu sản phẩm
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════
     MODAL: ADD / EDIT PROMO CODE
═══════════════════════════════════════════════════════════ -->
<div id="promo-modal" class="modal-backdrop" onclick="if(event.target===this)closePromoModal()">
    <div class="modal-box">
        <div class="modal-header">
            <div>
                <h3 id="promo-modal-title" class="text-sm font-bold text-gray-900">Thêm mã khuyến mãi</h3>
                <p class="text-[11px] text-gray-400 mt-0.5">Cấu hình mã giảm giá mới</p>
            </div>
            <button onclick="closePromoModal()" class="btn-icon">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
        <form method="post" asp-page-handler="SavePromoCode">
            <div class="modal-body space-y-4">
                <input type="hidden" id="promo-id" name="id" value="" />
                <div class="grid grid-cols-2 gap-4">
                    <div class="col-span-2">
                        <label class="form-label">Mã giảm giá</label>
                        <input type="text" id="promo-code" name="code" required class="form-input font-mono uppercase" placeholder="SUMMER20" />
                    </div>
                    <div>
                        <label class="form-label">Loại</label>
                        <select id="promo-type" name="promoType" class="form-input form-select">
                            <option value="percentage">Phần trăm (%)</option>
                            <option value="fixed">Cố định (₫)</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Giá trị</label>
                        <input type="number" id="promo-value" name="value" required min="0" step="0.01" class="form-input" placeholder="20" />
                    </div>
                    <div>
                        <label class="form-label">Đơn tối thiểu (₫)</label>
                        <input type="number" id="promo-min" name="minOrderValue" min="0" class="form-input" placeholder="500000" />
                    </div>
                    <div>
                        <label class="form-label">Giới hạn lượt dùng</label>
                        <input type="number" id="promo-limit" name="usageLimit" min="0" class="form-input" placeholder="100" />
                    </div>
                    <div>
                        <label class="form-label">Ngày bắt đầu</label>
                        <input type="date" id="promo-start" name="startDate" required class="form-input" />
                    </div>
                    <div>
                        <label class="form-label">Ngày kết thúc</label>
                        <input type="date" id="promo-end" name="endDate" required class="form-input" />
                    </div>
                    <div class="col-span-2 flex items-center gap-3">
                        <input type="checkbox" id="promo-active" name="isActive" value="true" checked class="w-4 h-4 rounded border-gray-300 accent-gray-900" />
                        <label for="promo-active" class="text-sm font-medium text-gray-700 cursor-pointer">Kích hoạt ngay</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closePromoModal()" class="btn btn-secondary">Hủy</button>
                <button type="submit" class="btn btn-primary">
                    <i data-lucide="save" class="w-3.5 h-3.5"></i>
                    Lưu mã
                </button>
            </div>
        </form>
    </div>
</div>

<script>
// ── Tab switching ──────────────────────────────────────────────────────────
const tabTitles = {
    analytics: { title: 'Overview', sub: 'Analytics & Metrics' },
    orders:    { title: 'Đơn hàng', sub: 'Quản lý & cập nhật trạng thái' },
    products:  { title: 'Sản phẩm', sub: 'Quản lý danh mục sản phẩm' },
    inventory: { title: 'Tồn kho',  sub: 'Theo dõi & cập nhật số lượng' },
    coupons:   { title: 'Khuyến mãi', sub: 'Mã giảm giá & ưu đãi' },
};

function switchTab(name) {
    // Hide all panels
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    // Deactivate all nav links
    document.querySelectorAll('.nav-link[data-tab]').forEach(l => l.classList.remove('active'));

    // Show target panel
    const panel = document.getElementById('tab-' + name);
    if (panel) panel.classList.add('active');

    // Activate nav links (desktop + mobile)
    document.querySelectorAll(`.nav-link[data-tab="${name}"], .nav-link[data-tab="${name}-m"]`)
        .forEach(l => l.classList.add('active'));

    // Update topbar title
    const meta = tabTitles[name] || { title: name, sub: '' };
    const titleEl = document.getElementById('page-title');
    const subEl = document.getElementById('page-sub');
    if (titleEl) titleEl.textContent = meta.title;
    if (subEl) subEl.textContent = meta.sub;

    // Re-init icons for newly visible content
    if (window.lucide) lucide.createIcons();
}

// ── Mobile sidebar ─────────────────────────────────────────────────────────
function openMobileSidebar() {
    document.getElementById('mobile-sidebar').classList.add('open');
    document.getElementById('sidebar-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
}
function closeMobileSidebar() {
    document.getElementById('mobile-sidebar').classList.remove('open');
    document.getElementById('sidebar-overlay').classList.remove('open');
    document.body.style.overflow = '';
}

// ── Product modal ──────────────────────────────────────────────────────────
function openProductModal() {
    document.getElementById('product-modal-title').textContent = 'Thêm sản phẩm mới';
    document.getElementById('product-id').value = '';
    document.getElementById('product-name').value = '';
    document.getElementById('product-slug').value = '';
    document.getElementById('product-price').value = '';
    document.getElementById('product-category').value = 'tee';
    document.getElementById('product-status').value = 'available';
    // Clear previews and color inputs
    for (let i = 0; i < 3; i++) {
        const prev = document.getElementById('preview-' + i);
        if (prev) { prev.classList.add('hidden'); prev.src = ''; }
        const colorInput = document.querySelector(`input[name="imageColor[${i}]"]`);
        if (colorInput) colorInput.value = '';
    }
    document.getElementById('product-modal').classList.add('open');
    if (window.lucide) lucide.createIcons();
}
function openEditProductModal(id, name, slug, price, category, status, images) {
    document.getElementById('product-modal-title').textContent = 'Chỉnh sửa sản phẩm';
    document.getElementById('product-id').value = id;
    document.getElementById('product-name').value = name;
    document.getElementById('product-slug').value = slug;
    document.getElementById('product-price').value = price;
    document.getElementById('product-category').value = category;
    document.getElementById('product-status').value = status;
    // Populate existing images (url preview + color text)
    const slots = images || [];
    for (let i = 0; i < 3; i++) {
        const slot = slots[i] || { url: '', color: '' };
        const prev = document.getElementById('preview-' + i);
        const colorInput = document.querySelector(`input[name="imageColor[${i}]"]`);
        if (prev) {
            if (slot.url) {
                prev.src = slot.url;
                prev.classList.remove('hidden');
            } else {
                prev.src = '';
                prev.classList.add('hidden');
            }
        }
        if (colorInput) colorInput.value = slot.color || '';
    }
    document.getElementById('product-modal').classList.add('open');
    if (window.lucide) lucide.createIcons();
}
function closeProductModal() {
    document.getElementById('product-modal').classList.remove('open');
}

// ── Promo modal ────────────────────────────────────────────────────────────
function openPromoModal() {
    document.getElementById('promo-modal-title').textContent = 'Thêm mã khuyến mãi';
    document.getElementById('promo-id').value = '';
    document.getElementById('promo-code').value = '';
    document.getElementById('promo-type').value = 'percentage';
    document.getElementById('promo-value').value = '';
    document.getElementById('promo-min').value = '';
    document.getElementById('promo-limit').value = '';
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('promo-start').value = today;
    document.getElementById('promo-end').value = '';
    document.getElementById('promo-active').checked = true;
    document.getElementById('promo-modal').classList.add('open');
    if (window.lucide) lucide.createIcons();
}
function openEditPromoModal(id, code, type, value, minVal, limit, start, end, isActive) {
    document.getElementById('promo-modal-title').textContent = 'Chỉnh sửa mã khuyến mãi';
    document.getElementById('promo-id').value = id;
    document.getElementById('promo-code').value = code;
    document.getElementById('promo-type').value = type;
    document.getElementById('promo-value').value = value;
    document.getElementById('promo-min').value = minVal || '';
    document.getElementById('promo-limit').value = limit || '';
    document.getElementById('promo-start').value = start;
    document.getElementById('promo-end').value = end;
    document.getElementById('promo-active').checked = isActive;
    document.getElementById('promo-modal').classList.add('open');
    if (window.lucide) lucide.createIcons();
}
function closePromoModal() {
    document.getElementById('promo-modal').classList.remove('open');
}

// ── Image preview ──────────────────────────────────────────────────────────
function previewImage(input, previewId) {
    const file = input.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
        const img = document.getElementById(previewId);
        if (img) { img.src = e.target.result; img.classList.remove('hidden'); }
    };
    reader.readAsDataURL(file);
}

// ── Auto-slug from name ────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();

    // Edit product buttons — use event delegation to avoid inline onclick issues
    document.addEventListener('click', e => {
        const btn = e.target.closest('.edit-product-btn');
        if (!btn) return;
        const id       = btn.dataset.id;
        const name     = btn.dataset.name;
        const slug     = btn.dataset.slug;
        const price    = btn.dataset.price;
        const category = btn.dataset.category;
        const status   = btn.dataset.status;
        let images = [];
        try { images = JSON.parse(btn.dataset.images || '[]'); } catch(err) {}

        document.getElementById('product-modal-title').textContent = 'Chỉnh sửa sản phẩm';
        document.getElementById('product-id').value    = id;
        document.getElementById('product-name').value  = name;
        document.getElementById('product-slug').value  = slug;
        document.getElementById('product-price').value = price;
        document.getElementById('product-category').value = category;
        document.getElementById('product-status').value   = status;

        for (let i = 0; i < 3; i++) {
            const slot = images[i] || { url: '', color: '' };
            const prev = document.getElementById('preview-' + i);
            const colorInput = document.querySelector(`input[name="imageColor[${i}]"]`);
            if (prev) {
                if (slot.url) { prev.src = slot.url; prev.classList.remove('hidden'); }
                else          { prev.src = '';       prev.classList.add('hidden'); }
            }
            if (colorInput) colorInput.value = slot.color || '';
        }
        document.getElementById('product-modal').classList.add('open');
        if (window.lucide) lucide.createIcons();
    });

    const nameInput = document.getElementById('product-name');
    const slugInput = document.getElementById('product-slug');
    if (nameInput && slugInput) {
        nameInput.addEventListener('input', () => {
            if (!document.getElementById('product-id').value) {
                slugInput.value = nameInput.value
                    .toLowerCase()
                    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                    .replace(/đ/g, 'd').replace(/[^a-z0-9\s-]/g, '')
                    .trim().replace(/\s+/g, '-');
            }
        });
    }

    // Auto-dismiss toast after 4s
    const toast = document.getElementById('toast-msg') || document.getElementById('toast-err');
    if (toast) setTimeout(() => toast.remove(), 4000);
});

// ── Keyboard: Escape closes modals ────────────────────────────────────────
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
        closeProductModal();
        closePromoModal();
        closeMobileSidebar();
    }
});
</script>
</body>
</html>
