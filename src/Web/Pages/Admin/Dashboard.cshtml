    </div>
</div>

<!-- PromoCode Add / Edit Modal -->
<div id="promo-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center hidden">
    <div class="bg-white p-8 rounded-xl shadow-xl max-w-lg w-full border animate-fade-in relative">
        <h3 id="promo-modal-title" class="text-xl font-black uppercase text-gray-950 mb-6 flex items-center gap-2">
            <i data-lucide="ticket" class="w-5 h-5 text-purple-600"></i>
            Thêm mã khuyến mãi
        </h3>

        <form method="post" asp-page-handler="SavePromoCode" class="space-y-4">
            <input type="hidden" name="id" id="promo-id" value="" />

            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Mã giảm giá</label>
                <input type="text" name="code" id="promo-code" required placeholder="Ví dụ: SUMMER2026" class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-semibold focus:outline-none focus:border-black uppercase" />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Loại giảm giá</label>
                    <select name="promoType" id="promo-type" class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-semibold focus:outline-none focus:border-black">
                        <option value="percent">Phần trăm (%)</option>
                        <option value="fixed">Cố định (₫)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Giá trị giảm</label>
                    <input type="number" name="value" id="promo-value" required step="0.01" min="0" placeholder="Ví dụ: 10 hoặc 50000" class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-semibold focus:outline-none focus:border-black" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Đơn hàng tối thiểu (₫)</label>
                    <input type="number" name="minOrderValue" id="promo-min" placeholder="Tùy chọn" class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-semibold focus:outline-none focus:border-black" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Số lần dùng tối đa</label>
                    <input type="number" name="usageLimit" id="promo-limit" placeholder="Không giới hạn" class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-semibold focus:outline-none focus:border-black" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Ngày bắt đầu</label>
                    <input type="date" name="startDate" id="promo-start" required class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-semibold focus:outline-none focus:border-black" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Ngày kết thúc</label>
                    <input type="date" name="endDate" id="promo-end" required class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-semibold focus:outline-none focus:border-black" />
                </div>
            </div>

            <div class="flex items-center gap-3">
                <input type="checkbox" name="isActive" id="promo-active" value="true" checked class="w-4 h-4 rounded border-gray-300 text-black focus:ring-black" />
                <label for="promo-active" class="text-sm font-semibold text-gray-700">Kích hoạt ngay</label>
            </div>

            <div class="flex gap-3 pt-4">
                <button type="button" onclick="closePromoModal()" class="flex-1 border border-gray-300 text-black py-2.5 text-xs font-bold tracking-wider hover:border-black transition-colors uppercase rounded">Hủy</button>
                <button type="submit" class="flex-1 bg-black text-white py-2.5 text-xs font-bold tracking-wider hover:bg-gray-800 transition-colors uppercase rounded">Lưu mã khuyến mãi</button>
            </div>
        </form>
    </div>
</div>

<script>
    function switchTab(event, tabId) {
        if (!event) {
            return;
        }

        // Toggle tab content visibility
        const contents = document.querySelectorAll(".tab-content");
        contents.forEach(content => content.classList.add("hidden"));
        document.getElementById("tab-content-" + tabId).classList.remove("hidden");

        // Toggle button states
        const buttons = document.querySelectorAll(".tab-btn");
        buttons.forEach(btn => btn.classList.remove("active"));
        event.currentTarget.classList.add("active");
    }

    function openProductModal() {
        document.getElementById("modal-title").innerText = "Thêm sản phẩm mới";
        document.getElementById("prod-id").value = "";
        document.getElementById("prod-name").value = "";
        document.getElementById("prod-slug").value = "";
        document.getElementById("prod-price").value = "";
        document.getElementById("prod-category").value = "tee";
        document.getElementById("prod-status").value = "available";
        
        // Reset the three image inputs and color selects
        for (let i = 0; i < 3; i++) {
            const fi = document.getElementById(`prod-imagefile-${i}`);
            if (fi) fi.value = "";
            const sel = document.getElementById(`prod-imagecolor-${i}`);
            if (sel) sel.value = 'white';
        }
        const previewContainer = document.getElementById("image-preview-container");
        previewContainer.classList.add("hidden");
        for (let i = 0; i < 3; i++) {
            const pimg = document.getElementById(`prod-image-preview-${i}`);
            if (pimg) pimg.src = "";
        }
        
        document.getElementById("product-modal").classList.remove("hidden");
    }

    function closeProductModal() {
        document.getElementById("product-modal").classList.add("hidden");
    }

    function editProduct(button) {
        const id = button.dataset.id;
        const name = button.dataset.name;
        const slug = button.dataset.slug;
        const price = button.dataset.price;
        const category = button.dataset.category;
        const status = button.dataset.status;
        const imageUrlsJson = button.dataset.imageUrls || "[]";

        document.getElementById("modal-title").innerText = "Chỉnh sửa sản phẩm";
        document.getElementById("prod-id").value = id;
        document.getElementById("prod-name").value = name;
        document.getElementById("prod-slug").value = slug;
        document.getElementById("prod-price").value = price;
        document.getElementById("prod-category").value = category;
        document.getElementById("prod-status").value = status;
        
        // Reset file inputs and color selects
        for (let i = 0; i < 3; i++) {
            const fi = document.getElementById(`prod-imagefile-${i}`);
            if (fi) fi.value = "";
            const sel = document.getElementById(`prod-imagecolor-${i}`);
            if (sel) sel.value = 'white';
        }

        const previewContainer = document.getElementById("image-preview-container");
        const imageUrls = JSON.parse(imageUrlsJson);
        if (imageUrls.length > 0) {
            for (let i = 0; i < 3; i++) {
                const pimg = document.getElementById(`prod-image-preview-${i}`);
                if (pimg) {
                    pimg.src = imageUrls[i] || "";
                }
            }
            previewContainer.classList.remove('hidden');
        } else {
            for (let i = 0; i < 3; i++) {
                const pimg = document.getElementById(`prod-image-preview-${i}`);
                if (pimg) pimg.src = "";
            }
            previewContainer.classList.add('hidden');
        }

        document.getElementById("product-modal").classList.remove("hidden");
    }

    // Live preview event listeners for up to 3 image inputs
    for (let i = 0; i < 3; i++) {
        const input = document.getElementById(`prod-imagefile-${i}`);
        const previewImg = document.getElementById(`prod-image-preview-${i}`);
        if (input) {
            input.addEventListener('change', function(event) {
                const file = event.target.files[0];
                const previewContainer = document.getElementById('image-preview-container');
                if (file && previewImg) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        previewImg.src = e.target.result;
                        previewContainer.classList.remove('hidden');
                    };
                    reader.readAsDataURL(file);
                }
            });
        }
    }

    // ===== PromoCode Modal Functions =====
    function openPromoModal() {
        document.getElementById("promo-modal-title").innerText = "Thêm mã khuyến mãi";
        document.getElementById("promo-id").value = "";
        document.getElementById("promo-code").value = "";
        document.getElementById("promo-type").value = "percent";
        document.getElementById("promo-value").value = "";
        document.getElementById("promo-min").value = "";
        document.getElementById("promo-limit").value = "";
        document.getElementById("promo-start").value = new Date().toISOString().split('T')[0];
        document.getElementById("promo-end").value = "";
        document.getElementById("promo-active").checked = true;
        document.getElementById("promo-modal").classList.remove("hidden");
    }

    function closePromoModal() {
        document.getElementById("promo-modal").classList.add("hidden");
    }

    function editPromo(id, code, type, value, minOrderValue, usageLimit, startDate, endDate, isActive) {
        document.getElementById("promo-modal-title").innerText = "Chỉnh sửa mã khuyến mãi";
        document.getElementById("promo-id").value = id;
        document.getElementById("promo-code").value = code;
        document.getElementById("promo-type").value = type;
        document.getElementById("promo-value").value = value;
        document.getElementById("promo-min").value = minOrderValue || "";
        document.getElementById("promo-limit").value = usageLimit || "";
        document.getElementById("promo-start").value = startDate;
        document.getElementById("promo-end").value = endDate;
        document.getElementById("promo-active").checked = isActive;
        document.getElementById("promo-modal").classList.remove("hidden");
    }

</script>

