                    <div>
                        <input type="file" name="imageFiles[1]" id="prod-imagefile-1" accept="image/*" class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-semibold focus:outline-none focus:border-black file:mr-4 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-black file:text-white hover:file:bg-gray-800 cursor-pointer" />
                        <select name="imageColor[1]" id="prod-imagecolor-1" class="w-full mt-2 border border-gray-300 rounded px-3 py-2 text-sm font-semibold focus:outline-none focus:border-black">
                            <option value="white">White / Trắng</option>
                            <option value="black">Black / Đen</option>
                            <option value="gray">Gray / Xám</option>
                            <option value="red">Red / Đỏ</option>
                        </select>
                    </div>
                    <div>
                        <input type="file" name="imageFiles[2]" id="prod-imagefile-2" accept="image/*" class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-semibold focus:outline-none focus:border-black file:mr-4 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-black file:text-white hover:file:bg-gray-800 cursor-pointer" />
                        <select name="imageColor[2]" id="prod-imagecolor-2" class="w-full mt-2 border border-gray-300 rounded px-3 py-2 text-sm font-semibold focus:outline-none focus:border-black">
                            <option value="white">White / Trắng</option>
                            <option value="black">Black / Đen</option>
                            <option value="gray">Gray / Xám</option>
                            <option value="red">Red / Đỏ</option>
