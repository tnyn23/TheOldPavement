                    </div>
                </div>
                <div id="image-preview-container" class="mt-3 hidden">
                    <span class="block text-[10px] text-gray-400 font-bold uppercase mb-1">Xem trước / Ảnh hiện tại</span>
                    <div class="flex gap-2">
                        <img id="prod-image-preview-0" src="" class="w-24 h-24 object-cover border rounded-lg shadow-sm" />
                        <img id="prod-image-preview-1" src="" class="w-24 h-24 object-cover border rounded-lg shadow-sm" />
