<script>
// ── Tab switching ──────────────────────────────────────────────────────────
const tabTitles = {
    analytics: { title: 'Overview', sub: 'Analytics & Metrics' },
    orders:    { title: 'Đơn hàng', sub: 'Quản lý & cập nhật trạng thái' },
    products:  { title: 'Sản phẩm', sub: 'Quản lý danh mục sản phẩm' },
    inventory: { title: 'Tồn kho',  sub: 'Theo dõi & cập nhật số lượng' },
    coupons:   { title: 'Khuyến mãi', sub: 'Mã giảm giá & ưu đãi' },
};

function switchTab(name) {
    // Hide all panels
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    // Deactivate all nav links
    document.querySelectorAll('.nav-link[data-tab]').forEach(l => l.classList.remove('active'));

    // Show target panel
    const panel = document.getElementById('tab-' + name);
    if (panel) panel.classList.add('active');

    // Activate nav links (desktop + mobile)
    document.querySelectorAll(`.nav-link[data-tab="${name}"], .nav-link[data-tab="${name}-m"]`)
        .forEach(l => l.classList.add('active'));

    // Update topbar title
    const meta = tabTitles[name] || { title: name, sub: '' };
    const titleEl = document.getElementById('page-title');
    const subEl = document.getElementById('page-sub');
    if (titleEl) titleEl.textContent = meta.title;
    if (subEl) subEl.textContent = meta.sub;

    // Re-init icons for newly visible content
    if (window.lucide) lucide.createIcons();
}

// ── Mobile sidebar ─────────────────────────────────────────────────────────
function openMobileSidebar() {
    document.getElementById('mobile-sidebar').classList.add('open');
    document.getElementById('sidebar-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
}
function closeMobileSidebar() {
    document.getElementById('mobile-sidebar').classList.remove('open');
    document.getElementById('sidebar-overlay').classList.remove('open');
    document.body.style.overflow = '';
}

// ── Product modal ──────────────────────────────────────────────────────────
function openProductModal() {
    document.getElementById('product-modal-title').textContent = 'Thêm sản phẩm mới';
    document.getElementById('product-id').value = '';
    document.getElementById('product-name').value = '';
    document.getElementById('product-slug').value = '';
    document.getElementById('product-price').value = '';
    document.getElementById('product-category').value = 'tee';
    document.getElementById('product-status').value = 'available';
    document.getElementById('product-description').value = '';
    // Sale
    document.getElementById('product-onsale').checked = false;
    document.getElementById('product-original-price').value = '';
    document.getElementById('product-discount').value = '';
    toggleSaleFields(false);
    // Collab
    document.getElementById('product-collab').checked = false;
    document.getElementById('product-collab-partner').value = '';
    toggleCollabFields(false);
    // Featured / Limited
    document.getElementById('product-featured').checked = false;
    document.getElementById('product-limited').checked = false;
    document.getElementById('product-limited-qty').value = '';
    toggleLimitedFields(false);
    // Clear previews and color inputs
    for (let i = 0; i < 3; i++) {
        const prev = document.getElementById('preview-' + i);
        if (prev) { prev.classList.add('hidden'); prev.src = ''; }
        const colorInput = document.querySelector(`input[name="imageColor[${i}]"]`);
        if (colorInput) colorInput.value = '';
    }
    document.getElementById('product-modal').classList.add('open');
    if (window.lucide) lucide.createIcons();
}

// ── Toggle conditional fields ──────────────────────────────────────────────
function toggleSaleFields(show) {
    document.getElementById('sale-fields').style.display = show ? 'grid' : 'none';
}
function toggleCollabFields(show) {
    document.getElementById('collab-fields').style.display = show ? 'block' : 'none';
}
function toggleLimitedFields(show) {
    document.getElementById('limited-fields').style.display = show ? 'block' : 'none';
}
function openEditProductModal(id, name, slug, price, category, status, images) {
    document.getElementById('product-modal-title').textContent = 'Chỉnh sửa sản phẩm';
    document.getElementById('product-id').value = id;
    document.getElementById('product-name').value = name;
    document.getElementById('product-slug').value = slug;
    document.getElementById('product-price').value = price;
    document.getElementById('product-category').value = category;
    document.getElementById('product-status').value = status;
    // Populate existing images (url preview + color text)
    const slots = images || [];
    for (let i = 0; i < 3; i++) {
        const slot = slots[i] || { url: '', color: '' };
        const prev = document.getElementById('preview-' + i);
        const colorInput = document.querySelector(`input[name="imageColor[${i}]"]`);
        if (prev) {
            if (slot.url) {
                prev.src = slot.url;
                prev.classList.remove('hidden');
            } else {
                prev.src = '';
                prev.classList.add('hidden');
            }
        }
        if (colorInput) colorInput.value = slot.color || '';
    }
    document.getElementById('product-modal').classList.add('open');
    if (window.lucide) lucide.createIcons();
}
function closeProductModal() {
    document.getElementById('product-modal').classList.remove('open');
}

// ── Promo modal ────────────────────────────────────────────────────────────
function openPromoModal() {
    document.getElementById('promo-modal-title').textContent = 'Thêm mã khuyến mãi';
    document.getElementById('promo-id').value = '';
    document.getElementById('promo-code').value = '';
    document.getElementById('promo-type').value = 'percentage';
    document.getElementById('promo-value').value = '';
    document.getElementById('promo-min').value = '';
    document.getElementById('promo-limit').value = '';
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('promo-start').value = today;
    document.getElementById('promo-end').value = '';
    document.getElementById('promo-active').checked = true;
    document.getElementById('promo-modal').classList.add('open');
    if (window.lucide) lucide.createIcons();
}
function openEditPromoModal(id, code, type, value, minVal, limit, start, end, isActive) {
    document.getElementById('promo-modal-title').textContent = 'Chỉnh sửa mã khuyến mãi';
    document.getElementById('promo-id').value = id;
    document.getElementById('promo-code').value = code;
    document.getElementById('promo-type').value = type;
    document.getElementById('promo-value').value = value;
    document.getElementById('promo-min').value = minVal || '';
    document.getElementById('promo-limit').value = limit || '';
    document.getElementById('promo-start').value = start;
    document.getElementById('promo-end').value = end;
    document.getElementById('promo-active').checked = isActive;
    document.getElementById('promo-modal').classList.add('open');
    if (window.lucide) lucide.createIcons();
}
function closePromoModal() {
    document.getElementById('promo-modal').classList.remove('open');
}

// ── Image preview ──────────────────────────────────────────────────────────
function previewImage(input, previewId) {
    const file = input.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
        const img = document.getElementById(previewId);
        if (img) { img.src = e.target.result; img.classList.remove('hidden'); }
    };
    reader.readAsDataURL(file);
}

// ── Auto-slug from name ────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
    lucide.createIcons();

    // Edit product buttons — use event delegation to avoid inline onclick issues
    document.addEventListener('click', e => {
        const btn = e.target.closest('.edit-product-btn');
        if (!btn) return;
        const d = btn.dataset;

        document.getElementById('product-modal-title').textContent = 'Chỉnh sửa sản phẩm';
        document.getElementById('product-id').value       = d.id;
        document.getElementById('product-name').value     = d.name;
        document.getElementById('product-slug').value     = d.slug;
        document.getElementById('product-price').value    = d.price;
        document.getElementById('product-category').value = d.category;
        document.getElementById('product-status').value   = d.status;
        document.getElementById('product-description').value = d.description || '';

        // Sale fields
        const onSale = d.onsale === 'true';
        document.getElementById('product-onsale').checked = onSale;
        document.getElementById('product-original-price').value = d.originalprice || '';
        document.getElementById('product-discount').value = d.discount || '';
        toggleSaleFields(onSale);

        // Collab fields
        const isCollab = d.collab === 'true';
        document.getElementById('product-collab').checked = isCollab;
        document.getElementById('product-collab-partner').value = d.collabpartner || '';
        toggleCollabFields(isCollab);

        // Featured
        document.getElementById('product-featured').checked = d.featured === 'true';

        // Limited edition
        const isLimited = d.limited === 'true';
        document.getElementById('product-limited').checked = isLimited;
        document.getElementById('product-limited-qty').value = d.limitedqty || '';
        toggleLimitedFields(isLimited);

        // Images
        let images = [];
        try { images = JSON.parse(d.images || '[]'); } catch {}
        for (let i = 0; i < 3; i++) {
            const slot = images[i] || { url: '', color: '' };
            const prev = document.getElementById('preview-' + i);
            const colorInput = document.querySelector(`input[name="imageColor[${i}]"]`);
            if (prev) {
                if (slot.url) { prev.src = slot.url; prev.classList.remove('hidden'); }
                else          { prev.src = '';       prev.classList.add('hidden'); }
            }
            if (colorInput) colorInput.value = slot.color || '';
        }
        document.getElementById('product-modal').classList.add('open');
        if (window.lucide) lucide.createIcons();
    });

    const nameInput = document.getElementById('product-name');
    const slugInput = document.getElementById('product-slug');
    if (nameInput && slugInput) {
        nameInput.addEventListener('input', () => {
            if (!document.getElementById('product-id').value) {
                slugInput.value = nameInput.value
                    .toLowerCase()
                    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                    .replace(/đ/g, 'd').replace(/[^a-z0-9\s-]/g, '')
                    .trim().replace(/\s+/g, '-');
            }
        });
    }

    // Auto-dismiss toast after 4s
    const toast = document.getElementById('toast-msg') || document.getElementById('toast-err');
    if (toast) setTimeout(() => toast.remove(), 4000);
});

// ── Keyboard: Escape closes modals ────────────────────────────────────────
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
        closeProductModal();
        closePromoModal();
        closeMobileSidebar();
    }
});

// ══════════════════════════════════════════════════════════════════════════
// FILTER + PAGINATION ENGINE
// ══════════════════════════════════════════════════════════════════════════
const PAGE_SIZE = 15;
const tableState = {};

// Config per tab: which data-* attributes to check against which filter inputs
const tableConfig = {
    orders: {
        tbody: 'orders-tbody',
        pagination: 'orders-pagination',
        filters: [
            { input: 'orders-search',  attr: 'search',  type: 'text' },
            { input: 'orders-status',  attr: 'status',  type: 'exact' },
            { input: 'orders-payment', attr: 'payment', type: 'exact' },
        ]
    },
    products: {
        tbody: 'products-tbody',
        pagination: 'products-pagination',
        filters: [
            { input: 'products-search',   attr: 'search',   type: 'text' },
            { input: 'products-category', attr: 'category', type: 'exact' },
            { input: 'products-status',   attr: 'status',   type: 'exact' },
            { input: 'products-tag',      attr: 'tag',      type: 'contains' },
        ]
    },
    inventory: {
        tbody: 'inventory-tbody',
        pagination: 'inventory-pagination',
        filters: [
            { input: 'inventory-search', attr: 'search', type: 'text' },
            { input: 'inventory-stock',  attr: 'stock',  type: 'exact' },
        ]
    },
    coupons: {
        tbody: 'coupons-tbody',
        pagination: 'coupons-pagination',
        filters: [
            { input: 'coupons-search', attr: 'search', type: 'text' },
            { input: 'coupons-active', attr: 'active', type: 'exact' },
            { input: 'coupons-type',   attr: 'type',   type: 'exact' },
        ]
    }
};

function filterTable(tabName) {
    const cfg = tableConfig[tabName];
    if (!cfg) return;

    const tbody = document.getElementById(cfg.tbody);
    if (!tbody) return;

    const rows = Array.from(tbody.querySelectorAll('tr[data-search], tr[data-status], tr[data-stock], tr[data-active]'));

    // Build filter values
    const filterVals = cfg.filters.map(f => ({
        ...f,
        value: (document.getElementById(f.input)?.value || '').trim().toLowerCase()
    }));

    const matched = rows.filter(row => {
        return filterVals.every(f => {
            if (!f.value) return true;
            const attrVal = (row.dataset[f.attr] || '').toLowerCase();
            if (f.type === 'text')     return attrVal.includes(f.value);
            if (f.type === 'exact')    return attrVal === f.value;
            if (f.type === 'contains') return attrVal.split(' ').includes(f.value);
            return true;
        });
    });

    // Store state
    tableState[tabName] = { matched, page: 1 };
    renderPage(tabName);
}

function renderPage(tabName) {
    const cfg = tableConfig[tabName];
    const state = tableState[tabName];
    if (!cfg || !state) return;

    const tbody = document.getElementById(cfg.tbody);
    const pagDiv = document.getElementById(cfg.pagination);
    if (!tbody) return;

    const { matched, page } = state;
    const totalPages = Math.ceil(matched.length / PAGE_SIZE);
    const start = (page - 1) * PAGE_SIZE;
    const end = start + PAGE_SIZE;

    // Show/hide rows
    const allRows = Array.from(tbody.querySelectorAll('tr'));
    allRows.forEach(r => r.style.display = 'none');
    matched.forEach((r, i) => {
        r.style.display = (i >= start && i < end) ? '' : 'none';
    });

    // Show empty state if no results
    const emptyRow = tbody.querySelector('tr:not([data-search]):not([data-status]):not([data-stock]):not([data-active])');
    if (emptyRow) emptyRow.style.display = matched.length === 0 ? '' : 'none';

    // Render pagination
    if (pagDiv) {
        if (totalPages <= 1) {
            pagDiv.innerHTML = matched.length > 0
                ? `<p class="text-[10px] text-gray-400 pt-3 border-t border-gray-50">Hiển thị ${matched.length} kết quả</p>`
                : '';
        } else {
            let html = `<div class="flex items-center justify-between pt-4 border-t border-gray-100">
                <p class="text-[10px] text-gray-400">Hiển thị <span class="font-bold text-gray-700">${start+1}–${Math.min(end, matched.length)}</span> / ${matched.length}</p>
                <div class="flex items-center gap-1">`;

            // Prev
            html += page > 1
                ? `<button onclick="goPage('${tabName}',${page-1})" class="w-7 h-7 flex items-center justify-center border border-gray-200 text-gray-500 hover:border-black hover:text-black transition-colors text-xs"><i data-lucide="chevron-left" class="w-3.5 h-3.5"></i></button>`
                : `<span class="w-7 h-7 flex items-center justify-center border border-gray-100 text-gray-300 text-xs cursor-not-allowed"><i data-lucide="chevron-left" class="w-3.5 h-3.5"></i></span>`;

            // Pages
            const pStart = Math.max(1, page - 2);
            const pEnd   = Math.min(totalPages, page + 2);
            if (pStart > 1) {
                html += `<button onclick="goPage('${tabName}',1)" class="w-7 h-7 flex items-center justify-center border border-gray-200 text-xs font-semibold text-gray-600 hover:border-black hover:text-black transition-colors">1</button>`;
                if (pStart > 2) html += `<span class="w-7 h-7 flex items-center justify-center text-xs text-gray-400">…</span>`;
            }
            for (let pg = pStart; pg <= pEnd; pg++) {
                html += pg === page
                    ? `<span class="w-7 h-7 flex items-center justify-center bg-black text-white text-xs font-bold">${pg}</span>`
                    : `<button onclick="goPage('${tabName}',${pg})" class="w-7 h-7 flex items-center justify-center border border-gray-200 text-xs font-semibold text-gray-600 hover:border-black hover:text-black transition-colors">${pg}</button>`;
            }
            if (pEnd < totalPages) {
                if (pEnd < totalPages - 1) html += `<span class="w-7 h-7 flex items-center justify-center text-xs text-gray-400">…</span>`;
                html += `<button onclick="goPage('${tabName}',${totalPages})" class="w-7 h-7 flex items-center justify-center border border-gray-200 text-xs font-semibold text-gray-600 hover:border-black hover:text-black transition-colors">${totalPages}</button>`;
            }

            // Next
            html += page < totalPages
                ? `<button onclick="goPage('${tabName}',${page+1})" class="w-7 h-7 flex items-center justify-center border border-gray-200 text-gray-500 hover:border-black hover:text-black transition-colors text-xs"><i data-lucide="chevron-right" class="w-3.5 h-3.5"></i></button>`
                : `<span class="w-7 h-7 flex items-center justify-center border border-gray-100 text-gray-300 text-xs cursor-not-allowed"><i data-lucide="chevron-right" class="w-3.5 h-3.5"></i></span>`;

            html += `</div></div>`;
            pagDiv.innerHTML = html;
            if (window.lucide) lucide.createIcons();
        }
    }
}

function goPage(tabName, page) {
    if (tableState[tabName]) {
        tableState[tabName].page = page;
        renderPage(tabName);
    }
}

function clearFilter(tabName) {
    const cfg = tableConfig[tabName];
    if (!cfg) return;
    cfg.filters.forEach(f => {
        const el = document.getElementById(f.input);
        if (el) el.value = '';
    });
    filterTable(tabName);
}

// Initialize all tables on load
document.addEventListener('DOMContentLoaded', () => {
    Object.keys(tableConfig).forEach(tab => filterTable(tab));
});
</script>
</body>
</html>
