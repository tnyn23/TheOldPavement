@page "/rolling-stones"
@model Web.Pages.RollingStonesModel
@{
    ViewData["Title"] = "The Rolling Stones Collab";
    
    // We filter the products that have 'stones' or 'collab' in their name or slug, or take all if none matches
    var stonesProducts = Model.Products.Where(p => p.Name.ToLower().Contains("stones") || p.Slug.ToLower().Contains("stones")).ToList();
    if (!stonesProducts.Any())
    {
        stonesProducts = Model.Products.ToList();
    }
}

<main class="pt-0 pb-16">
    <!-- Hero Section -->
    <div class="relative bg-black text-white py-28 px-4 md:px-8 lg:px-16 mb-16 overflow-hidden border-b border-gray-900">
        <div class="absolute inset-0 opacity-20">
            <img src="https://images.unsplash.com/photo-1501612780327-45045538702b?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1920"
                 alt="Rock concert"
                 class="w-full h-full object-cover" />
        </div>
        <div class="relative z-10 max-w-4xl mx-auto text-center space-y-6">
            <div class="inline-flex items-center gap-2 bg-red-600 text-white px-6 py-2 font-bold text-sm uppercase tracking-widest">
                <i data-lucide="star" class="w-5 h-5"></i>
                OFFICIAL COLLABORATION
            </div>
            <h1 class="text-5xl md:text-7xl lg:text-8xl mb-6 tracking-tight font-black leading-tight uppercase">
                THE OLD PAVEMENT<br />&times;<br />THE ROLLING STONES
            </h1>
            <p class="text-sm md:text-base tracking-widest uppercase text-gray-400 max-w-2xl mx-auto font-light">
                Khi van hoa pho co Ha Noi gap go huyen thoai Rock 'n' Roll bat diet
            </p>
            <div class="flex flex-col md:flex-row items-center justify-center gap-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
                <div class="flex items-center gap-2">
                    <i data-lucide="calendar" class="w-4 h-4"></i>
                    <span>BỘ SƯU TẬP GIỚI HẠN 2026</span>
                </div>
                <span class="hidden md:inline">|</span>
                <div class="flex items-center gap-2">
                    <i data-lucide="music" class="w-4 h-4"></i>
                    <span>SỐ LƯỢNG GIỚI HẠN TOÀN CẦU</span>
                </div>
            </div>
        </div>
    </div>

    <div class="px-4 md:px-8 lg:px-16 max-w-[1400px] mx-auto">
        <!-- Story Section -->
        <div class="mb-20 max-w-4xl mx-auto space-y-12">
            <h2 class="text-3xl md:text-4xl mb-6 tracking-tight text-center font-black uppercase">CÂU CHUYỆN HỢP TÁC</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
                <div class="bg-gray-50 p-8 border border-gray-200 rounded-lg">
                    <h3 class="text-xl font-bold mb-4 uppercase tracking-wide">Hội ngộ Huyền thoại</h3>
                    <p class="text-gray-600 leading-relaxed text-sm">
                        **The Old Pavement** chính thức bắt tay cùng ban nhạc huyền thoại **The Rolling Stones** trong dự án đặc biệt toàn cầu, kết hợp hài hòa văn hóa vỉa hè, phố cổ Hà Nội cùng ngọn lửa Rock 'n' Roll nhiệt huyết bất diệt.
                    </p>
                </div>
                <div class="bg-gray-50 p-8 border border-gray-200 rounded-lg">
                    <h3 class="text-xl font-bold mb-4 uppercase tracking-wide">Thiết kế Giới hạn</h3>
                    <p class="text-gray-600 leading-relaxed text-sm">
                        Biểu tượng Tongue Logo (chiếc lưỡi) trứ danh của The Rolling Stones được tái tạo nghệ thuật, đan xen cùng hình ảnh xích lô truyền thống và nét line-art tinh tế. Sản phẩm đi kèm thẻ chứng nhận số thứ tự giới hạn.
                    </p>
                </div>
            </div>

            <!-- Features -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                <div class="text-center p-6 border-2 border-black space-y-1">
                    <div class="text-4xl font-extrabold">100%</div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-gray-500">OFFICIAL LICENSED</p>
                </div>
                <div class="text-center p-6 border-2 border-black space-y-1">
                    <div class="text-4xl font-extrabold">500</div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-gray-500">LIMITED PIECES</p>
                </div>
                <div class="text-center p-6 border-2 border-black space-y-1">
                    <div class="text-4xl font-extrabold">2026</div>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-gray-500">EXCLUSIVE RELEASE</p>
                </div>
            </div>
        </div>

        <!-- Products Section -->
        <div class="mb-20">
            <div class="flex items-center justify-between mb-8 border-b pb-4">
                <h2 class="text-3xl md:text-4xl tracking-tight font-black uppercase">BỘ SƯU TẬP (THE COLLECTION)</h2>
                <div class="text-xs font-bold uppercase tracking-widest text-gray-500">
                    @stonesProducts.Count SẢN PHẨM
                </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-12">
                @foreach (var product in stonesProducts)
                {
                    @await Html.PartialAsync("_ProductCard", product)
                }
            </div>
        </div>

        <!-- Authenticity Notice -->
        <div class="bg-black text-white p-8 md:p-12 border border-gray-800">
            <div class="max-w-3xl mx-auto text-center space-y-6">
                <h3 class="text-2xl md:text-3xl mb-4 tracking-tight font-black uppercase">CAM KẾT CHÍNH HÃNG 100%</h3>
                <p class="text-gray-400 mb-6 leading-relaxed text-sm">
                    Mỗi sản phẩm thuộc BST The Old Pavement &times; The Rolling Stones khi bán ra đều bao gồm đầy đủ phụ kiện độc quyền đi kèm:
                </p>
                <ul class="space-y-3 text-left max-w-xl mx-auto text-xs font-semibold uppercase tracking-widest divide-y divide-gray-800">
                    <li class="flex items-center gap-3 pt-3 first:pt-0">
                        <i data-lucide="check" class="w-4 h-4 text-red-600"></i>
                        <span>Giấy chứng nhận Authenticity in số serial riêng</span>
                    </li>
                    <li class="flex items-center gap-3 pt-3">
                        <i data-lucide="check" class="w-4 h-4 text-red-600"></i>
                        <span>Nhãn mác hologram bảo mật chống hàng giả từ ban nhạc</span>
                    </li>
                    <li class="flex items-center gap-3 pt-3">
                        <i data-lucide="check" class="w-4 h-4 text-red-600"></i>
                        <span>Hộp đựng Collector's Box thiết kế cứng cáp cao cấp</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</main>

@section Styles {
    <link rel="stylesheet" href="~/css/product-card.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/product-card.js" asp-append-version="true"></script>
}
