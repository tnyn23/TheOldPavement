@page
@model Web.Pages.OutletModel
@{
    ViewData["Title"] = "Outlet Clearance";
    
    // We map Model.Products to the mock outlet format dynamically (calculating a huge 40% discount!)
    var outletProducts = Model.Products.Select(p => {
        var discountPercent = 40; // 40% discount for clearance!
        var outletPriceVal = Math.Round(p.Price * 0.6m);
        var primaryImg = p.ProductImages?.FirstOrDefault(img => img.IsPrimary == true)?.ImageUrl 
            ?? p.ProductImages?.FirstOrDefault()?.ImageUrl 
            ?? "https://images.unsplash.com/photo-1651761179569-4ba2aa054997?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080";
        var sizesList = p.ProductVariants?.Select(v => v.Size).Distinct().ToArray();
        if (sizesList == null || !sizesList.Any())
        {
            sizesList = new[] { "M", "L", "XL" };
        }
        return new {
            Id = p.Id,
            Name = p.Name + " - OUTLET",
            Price = outletPriceVal.ToString("N0") + "đ",
            OriginalPrice = p.Price.ToString("N0") + "đ",
            Discount = $"-{discountPercent}%",
            Image = primaryImg,
            Sizes = sizesList,
            Condition = "new",
            Reason = p.Category == "tee" ? "Discontinued Style" : "End of Season",
            Slug = p.Slug
        };
    }).ToArray();

    var filteredProducts = Model.SelectedCondition == "all"
        ? outletProducts
        : outletProducts.Where(p => p.Condition == Model.SelectedCondition).ToArray();
}

<main class="pt-8 px-4 md:px-8 lg:px-16 max-w-[1400px] mx-auto pb-16">
    <!-- Hero Banner -->
    <div class="relative bg-black text-white py-16 px-8 mb-12 overflow-hidden border border-gray-800">
        <div class="absolute inset-0 opacity-10">
            <div class="absolute top-0 left-0 w-full h-full" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(255,255,255,.05) 10px, rgba(255,255,255,.05) 20px);"></div>
        </div>
        <div class="relative z-10 max-w-3xl mx-auto text-center space-y-4">
            <div class="inline-flex items-center gap-2 bg-white text-black px-4 py-2 font-bold text-sm uppercase tracking-widest">
                <i data-lucide="percent" class="w-5 h-5"></i>
                OUTLET CLEARANCE
            </div>
            <h1 class="text-5xl md:text-6xl lg:text-7xl mb-4 tracking-tight font-black uppercase">
                UP TO 40% OFF
            </h1>
            <p class="text-sm md:text-base tracking-widest text-gray-400 uppercase">
                San pham cuoi mua, so luong co han - Khong ap dung doi tra
            </p>
            <div class="flex items-center justify-center gap-2 text-xs font-semibold uppercase tracking-wider text-gray-500">
                <i data-lucide="package" class="w-4 h-4"></i>
                <span>Mien phi van chuyen cho don tu 300.000đ</span>
            </div>
        </div>
    </div>

    <!-- Info Alert -->
    <div class="bg-gray-50 border-l-4 border-black p-6 mb-8 rounded-none border">
        <div class="flex gap-3">
            <i data-lucide="alert-circle" class="w-6 h-6 text-black flex-shrink-0"></i>
            <div>
                <h3 class="font-bold text-gray-950 mb-2 uppercase tracking-wide text-sm">DIEU KHOAN OUTLET</h3>
                <ul class="text-xs text-gray-600 space-y-1 font-semibold uppercase tracking-wider">
                    <li>• Tat ca san pham outlet deu la hang moi 100%, chua qua su dung.</li>
                    <li>• Khong ap dung chinh sach doi tra - Quy khach vui long chon size can than.</li>
                    <li>• So luong co han theo size thuc te con trong kho.</li>
                    <li>• Khong ap dung cung luc voi cac chuong trinh khuyen mai khac.</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Filter & Count -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 border-b pb-4">
        <h2 class="text-2xl font-black tracking-tight uppercase">
            @filteredProducts.Length SAN PHAM OUTLET
        </h2>

        <div class="flex items-center gap-3">
            <label class="text-xs font-bold uppercase tracking-widest text-gray-500">Loc theo:</label>
            <select onchange="filterCondition(this.value)"
                    class="border border-gray-300 px-4 py-2 font-semibold text-sm outline-none focus:border-black bg-transparent cursor-pointer">
                <option value="all" selected="@(Model.SelectedCondition == "all")">Tat ca san pham</option>
                <option value="new" selected="@(Model.SelectedCondition == "new")">Hang moi</option>
            </select>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-12 mb-16">
        @foreach (var product in filteredProducts)
        {
            <div class="group cursor-pointer" onclick="window.location.href='/Product/@product.Slug'">
                <!-- Image with badges -->
                <div class="relative bg-gray-50 mb-4 overflow-hidden aspect-square border">
                    <img src="@product.Image" alt="@product.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <div class="absolute top-3 left-3 flex flex-col gap-2">
                        <span class="bg-red-600 text-white text-[10px] font-bold px-2 py-0.5 uppercase tracking-wide">@product.Discount</span>
                        <span class="bg-black text-white text-[10px] font-bold px-2 py-0.5 uppercase tracking-wide">@product.Reason</span>
                    </div>
                </div>

                <!-- Info -->
                <h3 class="text-sm font-medium leading-tight uppercase tracking-wide group-hover:opacity-60 transition-opacity">@product.Name</h3>
                <div class="flex items-center gap-2 mt-2">
                    <span class="font-semibold text-gray-900">@product.Price</span>
                    <span class="text-xs line-through text-gray-400 font-medium">@product.OriginalPrice</span>
                </div>
            </div>
        }
    </div>
</main>

<script>
    function filterCondition(val) {
        window.location.href = '?condition=' + val;
    }
</script>
