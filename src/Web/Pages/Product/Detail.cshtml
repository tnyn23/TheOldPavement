@page "/Product/{slug}"
@model Web.Pages.Product.DetailModel
@{
    ViewData["Title"] = Model.Product?.Name ?? "Chi tiết sản phẩm";
    var productImages = Model.ProductImagesList.ToArray();
    var imagesByColorJson = System.Text.Json.JsonSerializer.Serialize(Model.ProductImagesByColor);
    var selectedColor = Model.SelectedColor ?? "white";
    var selectedSize = Model.SelectedSize ?? "L";
    var selectedColorName = Model.Colors.FirstOrDefault(c => c.Value == selectedColor)?.Name ?? selectedColor;
}

<main class="pt-8 px-4 md:px-8 lg:px-16 max-w-[1400px] mx-auto pb-16">
    <!-- Breadcrumb -->
    <nav class="flex mb-8 text-sm font-semibold tracking-wide uppercase" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a href="/" class="text-gray-500 hover:text-black transition-colors">TRANG CHỦ</a>
            </li>
            <li>
                <div class="flex items-center">
                    <span class="mx-2.5 text-gray-400">/</span>
                    <span class="text-black">@Model.Product?.Name</span>
                </div>
            </li>
        </ol>
    </nav>


    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Product Images -->
        <div class="space-y-4">
            <div id="main-image-wrapper" onclick="openLightbox()" class="relative bg-gray-50 aspect-square group overflow-hidden cursor-zoom-in rounded-2xl">
                <img id="main-product-image"
                     src="@(productImages.Length > 0 ? productImages[0] : "https://images.unsplash.com/photo-1651761179569-4ba2aa054997?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080")"
                     alt="@Model.Product?.Name"
                     class="w-full h-full object-cover transition-transform duration-100 origin-center rounded-2xl" />
                


                <!-- Navigation Arrows -->
                <button onclick="event.stopPropagation(); prevImage()"
                        class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/90 p-2 rounded-full opacity-0 group-hover:opacity-100 transition-opacity hover:bg-white border border-gray-200">
                    <i data-lucide="chevron-left" class="w-6 h-6"></i>
                </button>
                <button onclick="event.stopPropagation(); nextImage()"
                        class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/90 p-2 rounded-full opacity-0 group-hover:opacity-100 transition-opacity hover:bg-white border border-gray-200">
                    <i data-lucide="chevron-right" class="w-6 h-6"></i>
                </button>
            </div>

            <!-- Thumbnail Images -->
            <div id="thumbnails-container" class="grid grid-cols-3 gap-4">
                @for (int i = 0; i < productImages.Length; i++)
                {
                    <button onclick="selectImage(@i)"
                            class="thumbnail-btn bg-gray-50 aspect-square overflow-hidden border-2 rounded-xl transition-colors @(i == 0 ? "border-black" : "border-transparent")"
                            data-index="@i">
                        <img src="@productImages[i]"
                             alt="View @(i + 1)"
                             class="w-full h-full object-cover rounded-xl" />
                    </button>
                }
            </div>
        </div>

        <!-- Product Info & Order Form -->
        <div class="space-y-8">
            <div>
                <p class="text-sm tracking-wider mb-2 opacity-60">THE OLD PAVEMENT</p>
                <h1 class="text-4xl md:text-5xl mb-4 tracking-tight uppercase">
                    @Model.Product?.Name
                </h1>
                <p class="text-2xl font-semibold mb-6">@Model.Product?.Price.ToString("N0")₫</p>
                <p class="text-gray-600 leading-relaxed mb-6">
                    @Model.Product?.Description
                </p>
            </div>

            <form method="post" asp-page-handler="AddToCart" asp-route-slug="@Model.Product?.Slug" class="space-y-8">
                <!-- Color Selection -->
                <div>
                    <p class="font-semibold mb-3 tracking-wide">
                        MÀU SẮC: <span id="selected-color-label" class="font-normal">@selectedColorName</span>
                    </p>
                    <div class="flex gap-3">
                        @foreach (var color in Model.Colors)
                        {
                            <button type="button"
                                    onclick="selectColor('@color.Value', '@color.Name')"
                                    class="color-btn w-12 h-12 rounded-full border-2 transition-all duration-200 shadow-sm hover:shadow-md @(color.Value == selectedColor ? "border-black scale-110" : "border-gray-300")"
                                    style="background-color: @color.Hex"
                                    title="@color.Name"
                                    data-color="@color.Value"></button>
                        }
                    </div>
                    <input type="hidden" asp-for="SelectedColor" id="hidden-color" value="@selectedColor" />
                </div>

                <!-- Size Selection -->
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <p class="font-semibold tracking-wide">
                            KÍCH THƯỚC: <span id="selected-size-label" class="font-normal">@selectedSize</span>
                        </p>
                        <button type="button" onclick="toggleSizeGuide()" class="text-sm font-semibold underline hover:opacity-60 transition-opacity">
                            Bảng size
                        </button>
                    </div>
                    <div class="flex gap-3">
                        @foreach (var size in Model.Sizes)
                        {
                            <button type="button"
                                    onclick="selectSize('@size')"
                                    class="size-btn w-14 h-14 border-2 font-semibold rounded-xl transition-all duration-200 @(size == selectedSize ? "border-black bg-black text-white" : "border-gray-300 hover:border-black")"
                                    data-size="@size">
                                @size
                            </button>
                        }
                    </div>
                    <input type="hidden" asp-for="SelectedSize" id="hidden-size" value="@selectedSize" />
                </div>

                <!-- Quantity -->
                <div>
                    <p class="font-semibold mb-3 tracking-wide">SỐ LƯỢNG</p>
                    <div class="flex items-center gap-4">
                        <button type="button"
                                onclick="adjustQuantity(-1)"
                                class="w-10 h-10 border-2 border-gray-300 hover:border-black rounded-lg transition-colors font-semibold flex items-center justify-center">
                            −
                        </button>
                        <span id="quantity-display" class="text-xl font-medium w-12 text-center">1</span>
                        <button type="button"
                                onclick="adjustQuantity(1)"
                                class="w-10 h-10 border-2 border-gray-300 hover:border-black rounded-lg transition-colors font-semibold flex items-center justify-center">
                            +
                        </button>
                        <input type="hidden" asp-for="Quantity" id="hidden-quantity" value="1" />
                    </div>
                </div>

                <!-- Add to Cart Button -->
                <button type="submit"
                        class="w-full text-white py-4 font-semibold tracking-wider rounded-xl transition-colors"
                        style="background-color:#3E503C; hover:background-color:#2e3a2d"
                        onmouseover="this.style.backgroundColor='#2e3a2d'"
                        onmouseout="this.style.backgroundColor='#3E503C'">
                    THÊM VÀO GIỎ HÀNG
                </button>
            </form>

            <form method="post" asp-page-handler="AddToWishlist" asp-route-slug="@Model.Product?.Slug" class="mt-4">
                @{
                    var inWishlist = Web.Helpers.WishlistManager.IsInWishlist(HttpContext.Session, Model.Product?.Id ?? 0);
                }
                <button type="submit"
                        class="w-full py-4 font-semibold tracking-wider rounded-xl transition-colors uppercase flex items-center justify-center gap-2"
                        style="border: 1.5px solid @(inWishlist ? "#FF6F3D" : "rgba(62,80,60,0.3)"); color: @(inWishlist ? "#FF6F3D" : "#3E503C"); background:transparent"
                        onmouseover="this.style.borderColor='#FF6F3D'; this.style.color='#FF6F3D'"
                        onmouseout="this.style.borderColor='@(inWishlist ? "#FF6F3D" : "rgba(62,80,60,0.3)")'; this.style.color='@(inWishlist ? "#FF6F3D" : "#3E503C")'">
                    <i data-lucide="heart" class="w-5 h-5 @(inWishlist ? "fill-current" : "")"></i>
                    @(inWishlist ? "Đã yêu thích" : "Thêm vào yêu thích")
                </button>
            </form>

            <!-- Product Details -->
            <div class="border-t border-gray-200 pt-8 space-y-4">
                <h3 class="font-semibold tracking-wide text-lg">CHI TIẾT SẢN PHẨM</h3>
                <ul class="space-y-2 text-gray-600">
                    <li>• 100% Premium Cotton</li>
                    <li>• Heavyweight fabric (220 GSM)</li>
                    <li>• Oversized, boxy fit với vai trễ</li>
                    <li>• Đã co rút tối thiểu khi giặt</li>
                    <li>• Kết cấu mềm mại, thoáng khí</li>
                    <li>• Họa tiết xích lô vẽ tay độc đáo</li>
                    <li>• Sản xuất tại Việt Nam</li>
                </ul>
            </div>

            <!-- Care Instructions -->
            <div class="border-t border-gray-200 pt-8 space-y-4">
                <h3 class="font-semibold tracking-wide text-lg">HƯỚNG DẪN BẢO QUẢN</h3>
                <ul class="space-y-2 text-gray-600">
                    <li>• Giặt máy ở chế độ lạnh cùng các sản phẩm cùng màu</li>
                    <li>• Không sử dụng chất tẩy mạnh</li>
                    <li>• Phơi khô hoặc sấy ở nhiệt độ thấp</li>
                    <li>• Ủi mặt trong ở nhiệt độ thấp</li>
                    <li>• Không ủi trực tiếp lên hình in</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Product Reviews -->
    <section id="reviews-section" class="mt-24 border-t border-gray-200 pt-16">
        <h2 class="text-2xl md:text-3xl mb-8 tracking-tight font-bold uppercase">Đánh giá khách hàng</h2>
        
        <!-- Premium Rating Summary & Breakdown -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-16 border-b border-gray-100 pb-12">
            <!-- Avg Rating Block -->
            <div class="md:col-span-4 flex flex-col items-center justify-center text-center p-8 bg-gray-50 border border-gray-200 rounded-2xl">
                <span class="text-7xl font-extrabold tracking-tight text-black mb-2">@Model.AverageRating</span>
                <div class="flex text-black mb-3">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i data-lucide="star" class="w-5 h-5 @(i <= Math.Round(Model.AverageRating) ? "fill-black text-black" : "text-gray-300")"></i>
                    }
                </div>
                <span class="text-xs text-gray-500 uppercase tracking-widest font-bold">Dựa trên @Model.TotalReviews đánh giá</span>
            </div>

            <!-- Breakdown Bars -->
            <div class="md:col-span-8 flex flex-col justify-center space-y-3.5">
                @for (int star = 5; star >= 1; star--)
                {
                    var count = Model.RatingCounts.ContainsKey(star) ? Model.RatingCounts[star] : 0;
                    var pct = Model.RatingPercentages.ContainsKey(star) ? Model.RatingPercentages[star] : 0.0;
                    var isSelected = Model.SelectedRatingFilter == star;
                    
                    <a href="?slug=@Model.Product?.Slug&ratingFilter=@(isSelected ? "" : star.ToString())#reviews-section" 
                       class="flex items-center gap-4 group text-sm select-none hover:opacity-85 transition-opacity">
                        <span class="w-12 text-left font-bold tracking-wider flex items-center gap-1.5 text-xs">
                            @star <i data-lucide="star" class="w-3.5 h-3.5 fill-black text-black"></i>
                        </span>
                        
                        <div class="flex-1 h-3 bg-gray-100 border border-gray-200 rounded-full overflow-hidden relative">
                            <div class="h-full bg-black rounded-full transition-all duration-500" style="width: @(pct)%"></div>
                        </div>
                        
                        <span class="w-20 text-right text-xs font-mono text-gray-500 group-hover:text-black transition-colors @(isSelected ? "font-bold text-black underline" : "")">
                            @pct% (@count)
                        </span>
                    </a>
                }
            </div>
        </div>

        @if (Model.SelectedRatingFilter.HasValue)
        {
            <div class="flex items-center justify-between bg-black text-white px-4 py-3 mb-8">
                <span class="text-xs font-bold uppercase tracking-wider">
                    Đang hiển thị đánh giá @Model.SelectedRatingFilter.Value Sao (@Model.Reviews.Count đánh giá)
                </span>
                <a href="?slug=@Model.Product?.Slug#reviews-section" class="text-xs font-bold uppercase tracking-wider underline hover:opacity-80">
                    Xóa bộ lọc
                </a>
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            <!-- Reviews List -->
            <div class="lg:col-span-2 space-y-8">
                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    foreach (var review in Model.Reviews)
                    {
                        <div class="border-b border-gray-100 pb-6">
                            <div class="flex items-center gap-3 mb-2.5 flex-wrap">
                                <div class="flex text-black">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <i data-lucide="star" class="w-4 h-4 @(i < review.Rating ? "fill-black text-black" : "text-gray-300")"></i>
                                    }
                                </div>
                                <span class="text-sm font-bold text-gray-900">@(review.Title ?? "Khách hàng")</span>
                                
                                @if (review.IsVerifiedPurchase == true)
                                {
                                    <span class="inline-flex items-center gap-1 bg-black text-white px-2 py-0.5 text-[9px] font-black uppercase tracking-widest">
                                        <i data-lucide="check" class="w-3 h-3"></i> VERIFIED BUYER
                                    </span>
                                }
                                
                                <span class="text-xs text-gray-400 font-mono ml-auto">@review.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <p class="text-gray-600 text-sm leading-relaxed">
                                @review.Comment
                            </p>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-12 border border-dashed border-gray-300 bg-gray-50">
                        <i data-lucide="message-square" class="w-8 h-8 text-gray-400 mx-auto mb-3"></i>
                        <p class="text-gray-500 italic text-sm">
                            @if (Model.SelectedRatingFilter.HasValue)
                            {
                                <text>Không tìm thấy đánh giá @Model.SelectedRatingFilter.Value sao nào cho sản phẩm này.</text>
                            }
                            else
                            {
                                <text>Chưa có đánh giá nào cho sản phẩm này. Hãy trở thành người đầu tiên đánh giá!</text>
                            }
                        </p>
                    </div>
                }
            </div>

            <!-- Add Review Form -->
            <div class="bg-gray-50 p-6 md:p-8 rounded-xl border border-gray-100 h-fit">
                <h3 class="font-bold text-lg mb-6">VIẾT ĐÁNH GIÁ CỦA BẠN</h3>
                <form method="post" asp-page-handler="AddReview" asp-route-slug="@Model.Product?.Slug" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Đánh giá (Sao)</label>
                        <select asp-for="Rating" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-black">
                            <option value="5">5 Sao - Rất tuyệt vời</option>
                            <option value="4">4 Sao - Hài lòng</option>
                            <option value="3">3 Sao - Bình thường</option>
                            <option value="2">2 Sao - Kém</option>
                            <option value="1">1 Sao - Quá tệ</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Tên của bạn</label>
                        <input asp-for="ReviewerName" type="text" placeholder="Nhập tên (tùy chọn)" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-black" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Nhận xét chi tiết</label>
                        <textarea asp-for="ReviewContent" rows="4" placeholder="Chia sẻ cảm nhận của bạn về sản phẩm này..." required class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-black resize-none"></textarea>
                    </div>
                    <button type="submit" class="w-full bg-black text-white py-3.5 text-sm font-bold tracking-wider hover:bg-gray-800 transition-colors uppercase rounded-xl">
                        Gửi đánh giá
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- Related Products -->
    @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
    {
        <section class="mt-24 border-t border-gray-200 pt-16">
            <h2 class="text-3xl md:text-4xl mb-8 tracking-tight">SẢN PHẨM LIÊN QUAN</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-12">
                @foreach (var p in Model.RelatedProducts)
                {
                    var img = p.ProductImages?.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1651761179569-4ba2aa054997?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080";
                    <div class="group cursor-pointer" onclick="window.location.href='/Product/@p.Slug'">
                        <div class="relative bg-gray-50 mb-4 overflow-hidden aspect-square rounded-2xl">
                            <img src="@img" alt="@p.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 rounded-2xl" />
                            @if (p.IsCollab == true)
                            {
                                <div class="absolute bottom-3 left-3 bg-black text-white px-3 py-1 text-xs font-bold tracking-wide rounded-lg">Collab</div>
                            }
                        </div>
                        <h3 class="text-sm font-medium leading-tight uppercase tracking-wide group-hover:opacity-60 transition-opacity">@p.Name</h3>
                        <p class="font-semibold mt-2">@p.Price.ToString("N0")₫</p>
                    </div>
                }
            </div>
        </section>
    }
</main>

<!-- Size Guide Dialog Modal -->
<div id="size-guide-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden transition-all duration-300">
    <div class="bg-white p-8 max-w-lg w-full relative mx-4 rounded-2xl">
        <button onclick="toggleSizeGuide()" class="absolute top-4 right-4 text-gray-500 hover:text-black">
            <i data-lucide="x" class="w-6 h-6"></i>
        </button>
        <h3 class="text-2xl font-bold mb-6 tracking-tight uppercase">Bảng hướng dẫn chọn size</h3>

        <!-- Interactive Size Calculator -->
        <div class="mb-6 p-5 bg-gray-50 border border-gray-200 rounded-2xl">
            <span class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-3">Tìm size của bạn (AI recommender)</span>
            <div class="grid grid-cols-2 gap-6 mb-4">
                <div>
                    <label class="block text-xs font-bold uppercase mb-1.5">Chiều cao: <span id="height-val" class="font-mono font-normal">170</span> cm</label>
                    <input type="range" id="size-height" min="140" max="210" value="170" oninput="calculateSizeRecommendation()" class="w-full accent-black" />
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase mb-1.5">Cân nặng: <span id="weight-val" class="font-mono font-normal">65</span> kg</label>
                    <input type="range" id="size-weight" min="40" max="120" value="65" oninput="calculateSizeRecommendation()" class="w-full accent-black" />
                </div>
            </div>
            <div id="size-recommendation-result" class="hidden text-xs bg-black text-white px-3 py-2.5 font-bold uppercase tracking-wider text-center rounded-xl">
                Size gợi ý cho bạn: L (Oversized Fit)
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-center border-collapse">
                <thead>
                    <tr class="border-b-2 border-black font-semibold text-xs uppercase">
                        <th class="py-2">SIZE</th>
                        <th class="py-2">RỘNG ÁO (cm)</th>
                        <th class="py-2">DÀI ÁO (cm)</th>
                        <th class="py-2">CHIỀU CAO (m)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    <tr id="size-row-S">
                        <td class="py-3 font-semibold">S</td>
                        <td class="py-3">54</td>
                        <td class="py-3">68</td>
                        <td class="py-3">1.50 - 1.65</td>
                    </tr>
                    <tr id="size-row-M">
                        <td class="py-3 font-semibold">M</td>
                        <td class="py-3">56</td>
                        <td class="py-3">70</td>
                        <td class="py-3">1.60 - 1.72</td>
                    </tr>
                    <tr id="size-row-L">
                        <td class="py-3 font-semibold">L</td>
                        <td class="py-3">58</td>
                        <td class="py-3">72</td>
                        <td class="py-3">1.70 - 1.80</td>
                    </tr>
                    <tr id="size-row-XL">
                        <td class="py-3 font-semibold">XL</td>
                        <td class="py-3">60</td>
                        <td class="py-3">74</td>
                        <td class="py-3">1.78 - 1.85</td>
                    </tr>
                    <tr id="size-row-XXL">
                        <td class="py-3 font-semibold">XXL</td>
                        <td class="py-3">62</td>
                        <td class="py-3">76</td>
                        <td class="py-3">1.82 - 1.95</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="text-xs text-gray-500 mt-6 leading-relaxed">
            * Form dáng áo thun của The Old Pavement là dáng **oversized rộng rãi**, thoải mái. Nếu bạn muốn mặc ôm gọn hơn, hãy cân nhắc giảm 1 size.
        </p>
    </div>
</div>

<!-- Fullscreen Lightbox Modal -->
<div id="lightbox-modal" class="fixed inset-0 bg-black/95 z-50 flex flex-col justify-between hidden transition-opacity duration-300 opacity-0">
    <!-- Top Bar -->
    <div class="flex justify-between items-center px-6 py-4 text-white z-10">
        <span id="lightbox-counter" class="text-xs font-mono font-bold tracking-widest uppercase">1 / 3</span>
        <button onclick="closeLightbox()" class="text-white hover:opacity-75 transition-opacity">
            <i data-lucide="x" class="w-8 h-8"></i>
        </button>
    </div>

    <!-- Main Lightbox Image Viewport -->
    <div class="flex-1 flex items-center justify-center relative p-4 select-none">
        <!-- Prev Button -->
        <button onclick="prevLightboxImage()" class="absolute left-6 text-white hover:opacity-75 transition-opacity bg-black/40 p-3 hover:bg-black/60 rounded-full z-20">
            <i data-lucide="chevron-left" class="w-8 h-8"></i>
        </button>

        <img id="lightbox-image" src="" alt="Zoomed view" class="max-w-full max-h-[80vh] object-contain transition-all duration-300 transform scale-100 rounded-2xl" />

        <!-- Next Button -->
        <button onclick="nextLightboxImage()" class="absolute right-6 text-white hover:opacity-75 transition-opacity bg-black/40 p-3 hover:bg-black/60 rounded-full z-20">
            <i data-lucide="chevron-right" class="w-8 h-8"></i>
        </button>
    </div>

    <!-- Bottom Bar (Thumbnail slides) -->
    <div id="lightbox-thumbnails" class="p-6 bg-neutral-950/80 border-t border-neutral-900 overflow-x-auto whitespace-nowrap scrollbar-none flex justify-center gap-3">
        <!-- thumbnails will be rendered here dynamically -->
    </div>
</div>

<script>
    const imagesByColor = @Html.Raw(imagesByColorJson);
    let currentColor = '@selectedColor';
    let images = (imagesByColor && imagesByColor[currentColor]) ? imagesByColor[currentColor] : (Object.values(imagesByColor)[0] || []);
    let selectedImageIndex = 0;

    function renderThumbnails() {
        const thumbsContainer = document.getElementById('thumbnails-container');
        if (!thumbsContainer) return;
        thumbsContainer.innerHTML = '';
        for (let i = 0; i < images.length; i++) {
            const btn = document.createElement('button');
            btn.className = 'thumbnail-btn bg-gray-50 aspect-square overflow-hidden border-2 rounded-xl transition-colors ' + (i === 0 ? 'border-black' : 'border-transparent');
            btn.setAttribute('data-index', i);
            btn.onclick = (function(index) { return function() { selectImage(index); }; })(i);

            const img = document.createElement('img');
            img.src = images[i];
            img.alt = 'View ' + (i + 1);
            img.className = 'w-full h-full object-cover rounded-xl';
            btn.appendChild(img);
            thumbsContainer.appendChild(btn);
        }
    }

    function selectImage(index) {
        if (!images || images.length === 0) return;
        selectedImageIndex = index;
        const mainImg = document.getElementById('main-product-image');
        if (mainImg) mainImg.src = images[selectedImageIndex];

        // Highlight active thumbnail
        const thumbs = document.querySelectorAll('.thumbnail-btn');
        thumbs.forEach((t, i) => {
            if (i === index) {
                t.classList.add('border-black');
                t.classList.remove('border-transparent');
            } else {
                t.classList.remove('border-black');
                t.classList.add('border-transparent');
            }
        });


    }

    function nextImage() {
        if (!images || images.length === 0) return;
        let nextIdx = (selectedImageIndex + 1) % images.length;
        selectImage(nextIdx);
    }

    function prevImage() {
        if (!images || images.length === 0) return;
        let prevIdx = (selectedImageIndex - 1 + images.length) % images.length;
        selectImage(prevIdx);
    }

    function selectColor(value, name) {
        document.getElementById('selected-color-label').innerText = name;
        const hiddenColor = document.getElementById('hidden-color');
        if (hiddenColor) hiddenColor.value = value;

        // Highlight selected color button
        const colorBtns = document.querySelectorAll('.color-btn');
        colorBtns.forEach(btn => {
            if (btn.getAttribute('data-color') === value) {
                btn.classList.add('border-black', 'scale-110');
                btn.classList.remove('border-gray-300');
            } else {
                btn.classList.remove('border-black', 'scale-110');
                btn.classList.add('border-gray-300');
            }
        });

        // Switch image set for selected color
        currentColor = value;
        images = (imagesByColor && imagesByColor[currentColor]) ? imagesByColor[currentColor] : (Object.values(imagesByColor)[0] || []);
        selectedImageIndex = 0;
        renderThumbnails();
        selectImage(0);
    }

    // Initialize thumbnails on load
    document.addEventListener('DOMContentLoaded', function() {
        renderThumbnails();
        selectImage(0);
    });

    function selectSize(size) {
        document.getElementById('selected-size-label').innerText = size;
        const hiddenSize = document.getElementById('hidden-size');
        if (hiddenSize) hiddenSize.value = size;

        // Highlight selected size button
        const sizeBtns = document.querySelectorAll('.size-btn');
        sizeBtns.forEach(btn => {
            if (btn.getAttribute('data-size') === size) {
                btn.classList.add('border-black', 'bg-black', 'text-white');
                btn.classList.remove('border-gray-300');
            } else {
                btn.classList.remove('border-black', 'bg-black', 'text-white');
                btn.classList.add('border-gray-300');
            }
        });
    }

    function adjustQuantity(amount) {
        const qtyDisplay = document.getElementById('quantity-display');
        const hiddenQty = document.getElementById('hidden-quantity');
        let currentQty = parseInt(hiddenQty.value);
        let newQty = currentQty + amount;
        if (newQty < 1) newQty = 1;
        
        qtyDisplay.innerText = newQty;
        hiddenQty.value = newQty;
    }

    function toggleSizeGuide() {
        const modal = document.getElementById('size-guide-modal');
        modal.classList.toggle('hidden');
    }

    // Lightbox functions
    let lightboxActiveIndex = 0;
    
    function openLightbox() {
        if (!images || images.length === 0) return;
        
        lightboxActiveIndex = selectedImageIndex;
        document.getElementById('lightbox-image').src = images[lightboxActiveIndex];
        
        const thumbsContainer = document.getElementById('lightbox-thumbnails');
        if (thumbsContainer) {
            thumbsContainer.innerHTML = '';
            images.forEach((imgSrc, i) => {
                const btn = document.createElement('button');
                btn.className = 'w-16 h-16 bg-neutral-900 overflow-hidden border-2 rounded-lg transition-colors flex-shrink-0 ' + (i === lightboxActiveIndex ? 'border-white' : 'border-transparent');
                btn.onclick = () => selectLightboxImage(i);
                
                const img = document.createElement('img');
                img.src = imgSrc;
                img.className = 'w-full h-full object-cover rounded-lg';
                btn.appendChild(img);
                thumbsContainer.appendChild(btn);
            });
        }
        
        updateLightboxCounter();
        
        const modal = document.getElementById('lightbox-modal');
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modal.classList.add('opacity-100');
        }, 10);
    }
    
    function closeLightbox() {
        const modal = document.getElementById('lightbox-modal');
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }
    
    function selectLightboxImage(index) {
        lightboxActiveIndex = index;
        const mainImg = document.getElementById('lightbox-image');
        if (mainImg) {
            mainImg.classList.add('opacity-0', 'scale-95');
            setTimeout(() => {
                mainImg.src = images[lightboxActiveIndex];
                mainImg.classList.remove('opacity-0', 'scale-95');
            }, 150);
        }
        
        const thumbs = document.querySelectorAll('#lightbox-thumbnails button');
        thumbs.forEach((t, i) => {
            if (i === index) {
                t.classList.add('border-white');
                t.classList.remove('border-transparent');
            } else {
                t.classList.remove('border-white');
                t.classList.add('border-transparent');
            }
        });
        
        updateLightboxCounter();
        selectImage(index);
    }
    
    function nextLightboxImage() {
        if (!images || images.length === 0) return;
        const nextIdx = (lightboxActiveIndex + 1) % images.length;
        selectLightboxImage(nextIdx);
    }
    
    function prevLightboxImage() {
        if (!images || images.length === 0) return;
        const prevIdx = (lightboxActiveIndex - 1 + images.length) % images.length;
        selectLightboxImage(prevIdx);
    }
    
    function updateLightboxCounter() {
        const counter = document.getElementById('lightbox-counter');
        if (counter) {
            counter.innerText = `${lightboxActiveIndex + 1} / ${images.length}`;
        }
    }

    // Hover zoom magnifier logic
    document.addEventListener('DOMContentLoaded', function() {
        const zoomContainer = document.getElementById('main-image-wrapper');
        const mainImg = document.getElementById('main-product-image');

        if (zoomContainer && mainImg) {
            zoomContainer.addEventListener('mousemove', (e) => {
                if (e.target.closest('button')) {
                    mainImg.style.transform = 'scale(1)';
                    return;
                }
                const rect = zoomContainer.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const xPercent = (x / rect.width) * 100;
                const yPercent = (y / rect.height) * 100;

                mainImg.style.transformOrigin = `${xPercent}% ${yPercent}%`;
                mainImg.style.transform = 'scale(1.8)';
            });

            zoomContainer.addEventListener('mouseleave', () => {
                mainImg.style.transform = 'scale(1)';
                mainImg.style.transformOrigin = 'center center';
            });
        }
    });

    // AI Size guide calculation
    function calculateSizeRecommendation() {
        const height = parseInt(document.getElementById('size-height').value);
        const weight = parseInt(document.getElementById('size-weight').value);
        
        document.getElementById('height-val').innerText = height;
        document.getElementById('weight-val').innerText = weight;
        
        let recommendedSize = 'S';
        
        if (height > 182 || weight > 85) {
            recommendedSize = 'XXL';
        } else if (height > 175 || weight > 75) {
            recommendedSize = 'XL';
        } else if (height > 168 || weight > 65) {
            recommendedSize = 'L';
        } else if (height > 160 || weight > 55) {
            recommendedSize = 'M';
        } else {
            recommendedSize = 'S';
        }
        
        const resultBlock = document.getElementById('size-recommendation-result');
        resultBlock.innerText = `Size gợi ý cho bạn: ${recommendedSize} (Oversized Fit)`;
        resultBlock.classList.remove('hidden');
        
        const rows = ['S', 'M', 'L', 'XL', 'XXL'];
        rows.forEach(r => {
            const rowEl = document.getElementById(`size-row-${r}`);
            if (rowEl) {
                if (r === recommendedSize) {
                    rowEl.className = 'bg-black text-white font-bold transition-all';
                } else {
                    rowEl.className = 'transition-all';
                }
            }
        });

        selectSize(recommendedSize);
    }
</script>

