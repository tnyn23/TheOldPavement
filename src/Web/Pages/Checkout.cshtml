@page
@model Web.Pages.CheckoutModel
@{
    ViewData["Title"] = "Thanh toán — The Old Pavement";
}

<main class="max-w-[1400px] mx-auto px-4 md:px-8 lg:px-16 py-12 pb-20">

    <!-- Page header -->
    <div class="border-b border-gray-100 pb-6 mb-10">
        <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-400 mb-1">The Old Pavement</p>
        <h1 class="text-3xl md:text-4xl font-black uppercase tracking-tight">Thanh toán</h1>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="flex items-start gap-3 bg-red-50 border border-red-200 px-4 py-3 mb-8">
            <i data-lucide="alert-circle" class="w-4 h-4 text-red-500 flex-shrink-0 mt-0.5"></i>
            <div>
                <p class="text-xs font-bold text-red-700 uppercase tracking-wide mb-1">Lỗi nhập liệu</p>
                <div asp-validation-summary="All" class="text-xs text-red-600"></div>
            </div>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

        <!-- ── LEFT: Form ── -->
        <form method="post" asp-page-handler="SubmitOrder" class="lg:col-span-7 space-y-6">
            <input type="hidden" asp-for="PromoCodeId" id="applied-promo-id" />

            <!-- Section: Contact -->
            <div class="border border-gray-100 p-6 md:p-8 space-y-5">
                <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
                    <span class="w-6 h-6 bg-black text-white text-[10px] font-black flex items-center justify-center flex-shrink-0">1</span>
                    <h2 class="text-xs font-black uppercase tracking-[0.18em]">Thông tin liên hệ</h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Họ và tên <span class="text-red-500">*</span></label>
                        <input type="text" asp-for="FullName" required
                               class="w-full border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-black transition-colors" />
                    </div>
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Email <span class="text-red-500">*</span></label>
                        <input type="email" asp-for="Email" required
                               class="w-full border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-black transition-colors" />
                    </div>
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Số điện thoại <span class="text-red-500">*</span></label>
                        <input type="tel" asp-for="Phone" required
                               class="w-full border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-black transition-colors" />
                    </div>
                </div>
            </div>

            <!-- Section: Shipping -->
            <div class="border border-gray-100 p-6 md:p-8 space-y-5">
                <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
                    <span class="w-6 h-6 bg-black text-white text-[10px] font-black flex items-center justify-center flex-shrink-0">2</span>
                    <h2 class="text-xs font-black uppercase tracking-[0.18em]">Địa chỉ giao hàng</h2>
                </div>
                <div class="space-y-4">
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Địa chỉ <span class="text-red-500">*</span></label>
                        <input type="text" asp-for="Address" placeholder="Số nhà, tên đường, ngõ..." required
                               class="w-full border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-black transition-colors" />
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Tỉnh/Thành phố <span class="text-red-500">*</span></label>
                            <select asp-for="City" required
                                    class="w-full border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-black cursor-pointer appearance-none transition-colors">
                                <option value="">Chọn tỉnh/thành</option>
                                <option value="Hà Nội">Hà Nội</option>
                                <option value="TP. Hồ Chí Minh">TP. Hồ Chí Minh</option>
                                <option value="Đà Nẵng">Đà Nẵng</option>
                                <option value="Hải Phòng">Hải Phòng</option>
                                <option value="Cần Thơ">Cần Thơ</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Quận/Huyện</label>
                            <input type="text" asp-for="District"
                                   class="w-full border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-black transition-colors" />
                        </div>
                        <div>
                            <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Phường/Xã</label>
                            <input type="text" asp-for="Ward"
                                   class="w-full border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-black transition-colors" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Ghi chú (tuỳ chọn)</label>
                        <textarea asp-for="Note" rows="3" placeholder="Ghi chú về thời gian giao hàng hoặc hướng dẫn đường đi..."
                                  class="w-full border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-black resize-none transition-colors"></textarea>
                    </div>
                </div>
            </div>

            <!-- Section: Payment -->
            <div class="border border-gray-100 p-6 md:p-8 space-y-4">
                <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
                    <span class="w-6 h-6 bg-black text-white text-[10px] font-black flex items-center justify-center flex-shrink-0">3</span>
                    <h2 class="text-xs font-black uppercase tracking-[0.18em]">Phương thức thanh toán</h2>
                </div>

                <label class="flex items-start gap-4 p-4 border border-gray-200 cursor-pointer hover:border-black transition-colors has-[:checked]:border-black has-[:checked]:bg-gray-50">
                    <input type="radio" asp-for="PaymentMethod" value="cod" checked class="mt-0.5 accent-black" />
                    <div>
                        <p class="text-xs font-black uppercase tracking-widest mb-0.5">Thanh toán khi nhận hàng (COD)</p>
                        <p class="text-xs text-gray-500">Thanh toán tiền mặt trực tiếp cho shipper khi nhận hàng</p>
                    </div>
                </label>

                <label class="flex items-start gap-4 p-4 border border-gray-200 cursor-pointer hover:border-black transition-colors has-[:checked]:border-black has-[:checked]:bg-gray-50">
                    <input type="radio" asp-for="PaymentMethod" value="momo" class="mt-0.5 accent-black" />
                    <div class="flex-1">
                        <div class="flex items-center gap-2 mb-0.5">
                            <span class="inline-flex items-center justify-center w-5 h-5 bg-[#ae2070] text-white font-black text-[9px]">M</span>
                            <p class="text-xs font-black uppercase tracking-widest">Ví điện tử MoMo</p>
                        </div>
                        <p class="text-xs text-gray-500">Chuyển tiền MoMo đến <strong class="text-gray-800">0965481905</strong> — Nguyễn Thế Hoàng Tùng</p>
                    </div>
                </label>

                <label class="flex items-start gap-4 p-4 border border-gray-200 cursor-pointer hover:border-black transition-colors has-[:checked]:border-black has-[:checked]:bg-gray-50">
                    <input type="radio" asp-for="PaymentMethod" value="bank" class="mt-0.5 accent-black" />
                    <div class="flex-1">
                        <div class="flex items-center gap-2 mb-0.5">
                            <span class="inline-flex items-center justify-center w-5 h-5 bg-[#003189] text-white font-black text-[9px]">MB</span>
                            <p class="text-xs font-black uppercase tracking-widest">Chuyển khoản ngân hàng</p>
                        </div>
                        <p class="text-xs text-gray-500">MBBank — <strong class="text-gray-800">0965481905</strong> — Nguyen The Hoang Tung</p>
                    </div>
                </label>
            </div>

            <!-- Submit -->
            <button type="submit"
                    class="w-full bg-black text-white py-4 text-xs font-black tracking-[0.2em] uppercase hover:bg-gray-800 transition-colors flex items-center justify-center gap-2">
                <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                Xác nhận đặt hàng
            </button>

            <p class="text-center text-[10px] text-gray-400 font-medium">
                Bằng cách đặt hàng, bạn đồng ý với <a href="/Privacy" class="underline hover:text-black transition-colors">chính sách bảo mật</a> của chúng tôi.
            </p>
        </form>

        <!-- ── RIGHT: Order Summary ── -->
        <div class="lg:col-span-5">
            <div class="bg-gray-50 border border-gray-100 p-6 sticky top-[108px]">
                <h2 class="text-xs font-black uppercase tracking-[0.18em] mb-5 pb-4 border-b border-gray-200">Đơn hàng của bạn</h2>

                <!-- Items -->
                <div class="space-y-0 divide-y divide-gray-100 max-h-72 overflow-y-auto mb-5">
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="flex gap-3 py-3">
                            <div class="w-14 h-14 bg-gray-100 flex-shrink-0 overflow-hidden">
                                <img src="@item.ProductThumbnail" alt="@item.ProductName" class="w-full h-full object-cover" />
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-xs font-bold uppercase tracking-wide truncate">@item.ProductName</p>
                                <p class="text-[10px] text-gray-400 mt-0.5 uppercase">@item.Color · @item.Size · ×@item.Quantity</p>
                            </div>
                            <p class="text-xs font-black flex-shrink-0 tabular-nums">@item.TotalPrice.ToString("N0")₫</p>
                        </div>
                    }
                </div>

                <!-- Coupon -->
                <div class="border-t border-gray-200 pt-4 mb-4 space-y-2">
                    <p class="text-[10px] font-black uppercase tracking-widest text-gray-500">Mã giảm giá</p>
                    <div class="flex gap-0">
                        <input type="text" id="coupon-code-input" placeholder="Nhập mã..."
                               class="flex-1 border border-gray-200 bg-white px-3 py-2 text-xs font-semibold uppercase outline-none focus:border-black transition-colors" />
                        <button type="button" onclick="applyCoupon()"
                                class="bg-black text-white px-4 py-2 text-[10px] font-black tracking-widest uppercase hover:bg-gray-800 transition-colors flex-shrink-0">
                            Áp dụng
                        </button>
                    </div>
                    <p id="coupon-message" class="text-[10px] font-semibold hidden"></p>
                </div>

                <!-- Totals -->
                <div class="border-t border-gray-200 pt-4 space-y-2.5">
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500">Tạm tính</span>
                        <span class="font-semibold tabular-nums">@Model.TotalPrice.ToString("N0")₫</span>
                    </div>
                    <div id="discount-row" class="flex justify-between text-sm hidden">
                        <span class="text-gray-500">Giảm giá (<span id="applied-code-text" class="font-bold text-black"></span>)</span>
                        <span class="font-semibold text-red-600 tabular-nums">−<span id="discount-amount-text">0</span>₫</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500">Vận chuyển</span>
                        <span class="font-semibold text-emerald-600">Miễn phí</span>
                    </div>
                    <div class="flex justify-between pt-3 border-t border-gray-200">
                        <span class="text-sm font-black uppercase tracking-wide">Tổng cộng</span>
                        <span id="final-total-text" class="text-lg font-black tabular-nums">@Model.TotalPrice.ToString("N0")₫</span>
                    </div>
                </div>

                <!-- Trust -->
                <div class="grid grid-cols-3 gap-2 mt-5 pt-5 border-t border-gray-200 text-center">
                    <div>
                        <i data-lucide="shield-check" class="w-4 h-4 mx-auto text-gray-400 mb-1"></i>
                        <p class="text-[9px] text-gray-400 font-semibold uppercase leading-tight">Bảo mật<br/>thanh toán</p>
                    </div>
                    <div>
                        <i data-lucide="truck" class="w-4 h-4 mx-auto text-gray-400 mb-1"></i>
                        <p class="text-[9px] text-gray-400 font-semibold uppercase leading-tight">Ship toàn<br/>quốc</p>
                    </div>
                    <div>
                        <i data-lucide="refresh-cw" class="w-4 h-4 mx-auto text-gray-400 mb-1"></i>
                        <p class="text-[9px] text-gray-400 font-semibold uppercase leading-tight">Đổi trả<br/>7 ngày</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    async function applyCoupon() {
        const codeInput = document.getElementById('coupon-code-input');
        const code = codeInput.value.trim();
        const messageDiv = document.getElementById('coupon-message');
        const subtotal = @Model.TotalPrice;
        if (!code) {
            messageDiv.textContent = 'Vui lòng nhập mã giảm giá.';
            messageDiv.className = 'text-[10px] font-semibold text-red-600 block';
            return;
        }
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        try {
            const res = await fetch('/Checkout?handler=ApplyCoupon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ code, subtotal })
            });
            const result = await res.json();
            if (result.success) {
                document.getElementById('applied-promo-id').value = result.promoId;
                document.getElementById('applied-code-text').textContent = result.code;
                document.getElementById('discount-amount-text').textContent = result.discountAmount.toLocaleString('vi-VN');
                document.getElementById('final-total-text').textContent = result.finalTotal.toLocaleString('vi-VN') + '₫';
                document.getElementById('discount-row').classList.remove('hidden');
                messageDiv.textContent = result.message;
                messageDiv.className = 'text-[10px] font-semibold text-emerald-600 block';
            } else {
                document.getElementById('applied-promo-id').value = '';
                document.getElementById('discount-row').classList.add('hidden');
                document.getElementById('final-total-text').textContent = subtotal.toLocaleString('vi-VN') + '₫';
                messageDiv.textContent = result.message;
                messageDiv.className = 'text-[10px] font-semibold text-red-600 block';
            }
        } catch {
            messageDiv.textContent = 'Đã xảy ra lỗi. Vui lòng thử lại.';
            messageDiv.className = 'text-[10px] font-semibold text-red-600 block';
        }
    }
</script>
