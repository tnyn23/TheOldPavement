@page
@model Web.Pages.CollabsModel
@{
    ViewData["Title"] = "Collaborations";
}

<main class="pt-24 pb-16">
    <!-- Hero Section -->
    <div class="bg-gradient-to-r from-black to-gray-800 text-white py-20 px-4 md:px-8 lg:px-16 mb-16">
        <div class="max-w-[1400px] mx-auto">
            <div class="inline-flex items-center gap-2 bg-white text-black px-4 py-2 font-bold mb-6 text-sm uppercase tracking-widest">
                <i data-lucide="users" class="w-5 h-5"></i>
                COLLABORATIONS
            </div>
            <h1 class="text-5xl md:text-6xl lg:text-7xl mb-6 tracking-tight font-extrabold max-w-3xl leading-tight">
                TOGETHER WE CREATE STORIES
            </h1>
            <p class="text-xl md:text-2xl font-light opacity-90 max-w-2xl">
                Khám phá các bộ sưu tập hợp tác đặc biệt - nơi The Old Pavement kết nối cùng các nghệ sĩ, thương hiệu và di sản văn hoá độc đáo.
            </p>
        </div>
    </div>

    <div class="px-4 md:px-8 lg:px-16 max-w-[1400px] mx-auto">
        <!-- Featured Collaborations -->
        <div class="mb-20">
            <h2 class="text-3xl md:text-4xl mb-8 tracking-tight font-bold uppercase">FEATURED COLLABORATIONS</h2>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Collab 1: Rolling Stones -->
                <a href="/RollingStones" class="group relative overflow-hidden bg-black text-white aspect-[4/3] block border">
                    <!-- Background Image -->
                    <div class="absolute inset-0">
                        <img src="https://images.unsplash.com/photo-1501612780327-45045538702b?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxyb2NrJTIwY29uY2VydCUyMHN0YWdlfGVufDB8fHx8MTcwMDAwMDAwMHww&ixlib=rb-4.1.0&q=80&w=1920"
                             alt="The Rolling Stones"
                             class="w-full h-full object-cover opacity-60 group-hover:opacity-40 group-hover:scale-105 transition-all duration-500" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
                    </div>

                    <!-- Content -->
                    <div class="relative h-full p-8 flex flex-col justify-end">
                        <div class="mb-4">
                            <div class="inline-block bg-white text-black px-3 py-1 text-xs font-bold mb-3 uppercase">
                                Available Now
                            </div>
                            <div class="text-sm opacity-75 mb-2 font-semibold">2026 Collection</div>
                        </div>
                        <h3 class="text-3xl md:text-4xl font-extrabold mb-2 group-hover:translate-x-2 transition-transform uppercase">
                            The Rolling Stones
                        </h3>
                        <p class="text-lg mb-3 opacity-90 font-medium">Rock 'n' Roll meets Hanoi Street Culture</p>
                        <p class="text-sm opacity-75 leading-relaxed mb-4">
                            Sự kết hợp độc quyền chính thức toàn cầu với ban nhạc Rock huyền thoại, kết tinh vẻ đẹp ngàn năm của phố cổ và tinh thần tự do bất diệt.
                        </p>
                        <div class="flex items-center gap-2 text-sm font-bold tracking-widest group-hover:gap-4 transition-all">
                            <span>XEM COLLECTION</span>
                            <i data-lucide="arrow-right" class="w-5 h-5"></i>
                        </div>
                    </div>
                </a>

                <!-- Collab 2: DirtyCoins -->
                <div class="group relative overflow-hidden bg-black text-white aspect-[4/3] block border">
                    <!-- Background Image -->
                    <div class="absolute inset-0">
                        <img src="https://images.unsplash.com/photo-1558769132-cb1aea0f5012?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxzdHJlZXQlMjBhcnQtdXJiYW58ZW58MHx8fHwxNzAwMDAwMDAwfDA&ixlib=rb-4.1.0&q=80&w=1920"
                             alt="DirtyCoins"
                             class="w-full h-full object-cover opacity-60 group-hover:opacity-40 group-hover:scale-105 transition-all duration-500" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
                    </div>

                    <!-- Content -->
                    <div class="relative h-full p-8 flex flex-col justify-end">
                        <div class="mb-4">
                            <div class="inline-block bg-white text-black px-3 py-1 text-xs font-bold mb-3 uppercase">
                                Available Now
                            </div>
                            <div class="text-sm opacity-75 mb-2 font-semibold">2025 Collection</div>
                        </div>
                        <h3 class="text-3xl md:text-4xl font-extrabold mb-2 group-hover:translate-x-2 transition-transform uppercase">
                            DirtyCoins
                        </h3>
                        <p class="text-lg mb-3 opacity-90 font-medium">Urban Legends Unite</p>
                        <p class="text-sm opacity-75 leading-relaxed mb-4">
                            Hai thế lực thời trang đường phố Việt Nam đồng sáng tạo các ấn phẩm đặc biệt tôn vinh văn hoá đường phố Hà Nội - Sài Gòn.
                        </p>
                        <div class="flex items-center gap-2 text-sm font-bold tracking-widest group-hover:gap-4 transition-all opacity-60">
                            <span>MỞ RỘNG COLLECTION SỚM</span>
                            <i data-lucide="arrow-right" class="w-5 h-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- All Collaborations -->
        <div class="mb-16">
            <h2 class="text-3xl md:text-4xl mb-8 tracking-tight font-bold uppercase">ALL COLLABORATIONS</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Collab Item 3 -->
                <div class="group border-2 border-gray-200 hover:border-black transition-colors p-6 flex gap-6">
                    <div class="w-32 h-32 flex-shrink-0 bg-gray-100 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1569163139394-de4798aa62b1?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxncmFmZml0aSUyMGFydCUyMHN0cmVldHxlbnwwfHx8fDE3MDAwMDAwMDB8MA&ixlib=rb-4.1.0&q=80&w=1920"
                             alt="Local Artists"
                             class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
                    </div>
                    <div class="flex-1 space-y-1">
                        <div class="inline-block px-2 py-1 text-xs font-bold bg-green-100 text-green-800 uppercase">Available Now</div>
                        <div class="text-xs text-gray-500 font-bold">2025</div>
                        <h3 class="text-xl font-bold uppercase group-hover:opacity-60 transition-opacity">Local Artists Collective</h3>
                        <p class="text-sm text-gray-600 font-medium">Art on the Streets</p>
                        <p class="text-sm text-gray-500 leading-relaxed line-clamp-2">Biến những bức vẽ graffiti Hà Nội đầy sắc màu bụi bặm thành thiết kế thời trang hiện đại.</p>
                    </div>
                </div>

                <!-- Collab Item 4 -->
                <div class="group border-2 border-gray-200 hover:border-black transition-colors p-6 flex gap-6">
                    <div class="w-32 h-32 flex-shrink-0 bg-gray-100 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxjb2ZmZWUlMjBzaG9wJTIwdmludGFnZXxlbnwwfHx8fDE3MDAwMDAwMDB8MA&ixlib=rb-4.1.0&q=80&w=1920"
                             alt="Coffee Culture"
                             class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
                    </div>
                    <div class="flex-1 space-y-1">
                        <div class="inline-block px-2 py-1 text-xs font-bold bg-gray-100 text-gray-800 uppercase">Sold Out</div>
                        <div class="text-xs text-gray-500 font-bold">2024</div>
                        <h3 class="text-xl font-bold uppercase group-hover:opacity-60 transition-opacity">Hanoi Coffee Culture</h3>
                        <p class="text-sm text-gray-600 font-medium">Brewing Style</p>
                        <p class="text-sm text-gray-500 leading-relaxed line-clamp-2">Sự giao thoa đầy thú vị tôn vinh nét văn hóa thưởng thức cà phê đường phố đặc sản.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Proposals -->
        <div class="bg-gray-50 p-12 text-center border space-y-6">
            <h3 class="text-3xl font-bold tracking-tight uppercase">ĐỀ XUẤT HỢP TÁC</h3>
            <p class="text-gray-600 mb-8 max-w-2xl mx-auto font-medium">
                Bạn là nghệ sĩ tự do, đại diện thương hiệu hoặc tổ chức sáng tạo có chung nguồn cảm hứng về Việt Nam? Hãy liên hệ với chúng tôi để cùng tạo nên những sản phẩm thời thượng.
            </p>
            <a href="mailto:collabs@vn"
               class="inline-block bg-black text-white px-8 py-4 font-semibold hover:bg-gray-800 transition-colors uppercase text-sm">
                LIÊN HỆ ĐỂ HỢP TÁC
            </a>
        </div>
    </div>
</main>

