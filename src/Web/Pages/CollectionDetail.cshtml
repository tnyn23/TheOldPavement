@page "/Collection/{slug}"
@model Web.Pages.CollectionDetailModel
@{
    ViewData["Title"] = $"{Model.Collection?.Name} - The Old Pavement";
}

<main class="pt-8 px-4 md:px-8 lg:px-16 max-w-[1400px] mx-auto pb-16">
    <!-- Breadcrumb -->
    <nav class="flex mb-8 text-sm font-semibold tracking-wide uppercase" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a href="/" class="text-gray-500 hover:text-black transition-colors">TRANG CHỦ</a>
            </li>
            <li>
                <div class="flex items-center">
                    <span class="mx-2.5 text-gray-400">/</span>
                    <a href="/Collections" class="text-gray-500 hover:text-black transition-colors">BỘ SƯU TẬP</a>
                </div>
            </li>
            <li>
                <div class="flex items-center">
                    <span class="mx-2.5 text-gray-400">/</span>
                    <span class="text-black">@Model.Collection?.Name</span>
                </div>
            </li>
        </ol>
    </nav>

    <!-- Collection Banner/Info -->
    <div class="border border-gray-200 mb-12 bg-white grid grid-cols-1 md:grid-cols-3">
        <div class="md:col-span-2 p-8 md:p-12 flex flex-col justify-center space-y-4">
            <span class="bg-black text-white text-[10px] font-extrabold px-3 py-1 uppercase tracking-widest w-fit">
                @Model.Collection?.Season @Model.Collection?.Year
            </span>
            <h1 class="text-3xl md:text-5xl font-black tracking-tight text-gray-950 uppercase">
                @Model.Collection?.Name
            </h1>
            <p class="text-sm text-gray-600 max-w-2xl leading-relaxed">
                @Model.Collection?.Description
            </p>
        </div>
        <div class="h-48 md:h-auto overflow-hidden relative">
            <img src="@Model.Collection?.HeroImageUrl" alt="@Model.Collection?.Name" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-black/10"></div>
        </div>
    </div>

    <!-- Product Grid -->
    <div>
        <div class="flex items-center justify-between border-b border-gray-200 pb-4 mb-8">
            <span class="text-xs font-black uppercase tracking-wider text-gray-400">Sản phẩm thuộc bộ sưu tập</span>
            <span class="text-xs font-bold text-gray-900">@Model.Products.Count kết quả</span>
        </div>

        @if (Model.Products.Any())
        {
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-12">
                @foreach (var p in Model.Products)
                {
                    <partial name="_ProductCard" model="p" />
                }
            </div>
        }
        else
        {
            <div class="text-center py-20 border border-dashed border-gray-300 bg-gray-50">
                <i data-lucide="package" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                <h3 class="font-bold text-sm text-gray-900 uppercase">Chưa có sản phẩm</h3>
                <p class="text-gray-500 text-xs mt-1">Các sản phẩm đang được cập nhật vào bộ sưu tập này.</p>
            </div>
        }
    </div>
</main>
