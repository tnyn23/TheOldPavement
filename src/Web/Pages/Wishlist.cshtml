@page
@model Web.Pages.WishlistModel
@{
    ViewData["Title"] = "Yêu thích — The Old Pavement";
}

<main class="px-4 md:px-8 lg:px-16 max-w-[1400px] mx-auto py-12 min-h-[70vh]">

    <!-- Header -->
    <div class="border-b border-gray-100 pb-6 mb-10">
        <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-400 mb-1">The Old Pavement</p>
        <h1 class="text-3xl md:text-4xl font-black uppercase tracking-tight">Danh sách yêu thích
            @if (Model.WishlistItems.Any())
            {
                <span class="text-gray-300 font-light ml-2">(@Model.WishlistItems.Count)</span>
            }
        </h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-8 flex items-center gap-3 bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-emerald-800 font-medium">
            <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600 flex-shrink-0"></i>
            <span>@TempData["SuccessMessage"]</span>
            <button onclick="this.parentElement.remove()" class="ml-auto"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>
    }

    @if (!Model.WishlistItems.Any())
    {
        <div class="flex flex-col items-center justify-center py-24 text-center">
            <div class="w-20 h-20 border-2 border-dashed border-gray-200 flex items-center justify-center mb-6">
                <i data-lucide="heart" class="w-8 h-8 text-gray-300"></i>
            </div>
            <h2 class="text-xl font-black uppercase tracking-tight mb-2">Danh sách trống</h2>
            <p class="text-sm text-gray-500 mb-8 max-w-xs">Lưu những sản phẩm yêu thích để dễ dàng mua sắm sau.</p>
            <a href="/Shop" class="inline-flex items-center gap-2 bg-black text-white px-8 py-3 text-xs font-bold tracking-widest uppercase hover:bg-gray-800 transition-colors">
                Khám phá Shop
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-8">
            @foreach (var item in Model.WishlistItems)
            {
                <div class="group relative flex flex-col">
                    <!-- Image -->
                    <div class="relative bg-gray-50 aspect-[3/4] overflow-hidden mb-3">
                        <a href="/Product/@item.Slug">
                            <img src="@item.ImageUrl" alt="@item.ProductName"
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        </a>
                        <!-- Remove -->
                        <form method="post" asp-page-handler="Remove" asp-route-productId="@item.ProductId"
                              class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity">
                            <button type="submit"
                                    class="w-8 h-8 bg-white border border-gray-200 flex items-center justify-center hover:bg-red-50 hover:border-red-200 hover:text-red-500 transition-all"
                                    title="Xoá khỏi yêu thích">
                                <i data-lucide="x" class="w-3.5 h-3.5"></i>
                            </button>
                        </form>
                    </div>

                    <!-- Info -->
                    <div class="flex-1 flex flex-col">
                        <a href="/Product/@item.Slug" class="text-xs font-bold uppercase tracking-wide text-gray-900 hover:opacity-60 transition-opacity line-clamp-2 mb-1">@item.ProductName</a>
                        <p class="text-sm font-black text-gray-900 mb-3 tabular-nums">@item.Price.ToString("N0")₫</p>

                        <div class="mt-auto space-y-2">
                            <form method="post" asp-page-handler="AddToCart">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="name" value="@item.ProductName" />
                                <input type="hidden" name="price" value="@item.Price" />
                                <input type="hidden" name="slug" value="@item.Slug" />
                                <input type="hidden" name="imageUrl" value="@item.ImageUrl" />
                                <button type="submit"
                                        class="w-full bg-black text-white py-2.5 text-[10px] font-black tracking-widest uppercase hover:bg-gray-800 transition-colors flex items-center justify-center gap-2">
                                    <i data-lucide="shopping-bag" class="w-3.5 h-3.5"></i>
                                    Thêm vào giỏ
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Recently Viewed -->
    @if (Model.RecentlyViewedProducts != null && Model.RecentlyViewedProducts.Any())
    {
        <section class="mt-20 pt-12 border-t border-gray-100">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-lg font-black uppercase tracking-tight">Đã xem gần đây</h2>
                <a href="/Shop" class="text-xs font-bold uppercase tracking-widest text-gray-400 hover:text-black transition-colors">Xem tất cả →</a>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-8">
                @foreach (var p in Model.RecentlyViewedProducts)
                {
                    var img = p.ProductImages?.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1651761179569-4ba2aa054997?w=600&q=80";
                    <a href="/Product/@p.Slug" class="group block">
                        <div class="bg-gray-50 aspect-[3/4] overflow-hidden mb-3">
                            <img src="@img" alt="@p.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        </div>
                        <p class="text-xs font-bold uppercase tracking-wide text-gray-900 group-hover:opacity-60 transition-opacity truncate">@p.Name</p>
                        <p class="text-sm font-black text-gray-900 mt-0.5 tabular-nums">@p.Price.ToString("N0")₫</p>
                    </a>
                }
            </div>
        </section>
    }

    <!-- Recommended -->
    @if (Model.RecommendedProducts != null && Model.RecommendedProducts.Any())
    {
        <section class="mt-16 pt-12 border-t border-gray-100">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-lg font-black uppercase tracking-tight">Gợi ý dành cho bạn</h2>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-8">
                @foreach (var p in Model.RecommendedProducts)
                {
                    var img = p.ProductImages?.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1651761179569-4ba2aa054997?w=600&q=80";
                    <a href="/Product/@p.Slug" class="group block">
                        <div class="bg-gray-50 aspect-[3/4] overflow-hidden mb-3 relative">
                            <img src="@img" alt="@p.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                            @if (p.IsCollab == true)
                            {
                                <span class="absolute bottom-2 left-2 bg-black text-white text-[9px] font-black px-2 py-0.5 uppercase tracking-widest">Collab</span>
                            }
                        </div>
                        <p class="text-xs font-bold uppercase tracking-wide text-gray-900 group-hover:opacity-60 transition-opacity truncate">@p.Name</p>
                        <p class="text-sm font-black text-gray-900 mt-0.5 tabular-nums">@p.Price.ToString("N0")₫</p>
                    </a>
                }
            </div>
        </section>
    }
</main>
