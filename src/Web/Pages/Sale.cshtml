@page
@model Web.Pages.SaleModel
@{
    ViewData["Title"] = "Flash Sale — The Old Pavement";

    var saleProducts = Model.Products.Select(p => {
        var clone = new Domain.Models.Product {
            Id = p.Id, Name = p.Name, Slug = p.Slug, Description = p.Description,
            Price = Math.Round(p.Price * 0.8m), OriginalPrice = p.Price,
            DiscountPercentage = 20, IsOnSale = true, Category = p.Category,
            IsCollab = p.IsCollab, CreatedAt = p.CreatedAt,
            ProductImages = p.ProductImages, ProductVariants = p.ProductVariants
        };
        return clone;
    }).ToArray();

    var sortedProducts = Model.SortBy switch {
        "price-low"  => saleProducts.OrderBy(p => p.Price).ToArray(),
        "price-high" => saleProducts.OrderByDescending(p => p.Price).ToArray(),
        _            => saleProducts.OrderByDescending(p => p.DiscountPercentage).ToArray()
    };
}

<main class="pb-20">
    <!-- Hero -->
    <div class="relative bg-black text-white overflow-hidden">
        <div class="absolute inset-0 opacity-20">
            <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=1920&q=80"
                 alt="Sale" class="w-full h-full object-cover" />
        </div>
        <div class="relative z-10 max-w-[1400px] mx-auto px-4 md:px-8 lg:px-16 py-20 md:py-28">
            <div class="max-w-2xl">
                <span class="inline-flex items-center gap-2 bg-white text-black px-4 py-1.5 text-[10px] font-black tracking-[0.2em] uppercase mb-6 rounded-lg">
                    <i data-lucide="zap" class="w-3.5 h-3.5"></i>
                    Flash Sale
                </span>
                <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tight leading-none mb-4">
                    Sale<br/>Up To 30%
                </h1>
                <p class="text-sm text-white/60 uppercase tracking-widest font-medium">
                    Sản phẩm chọn lọc · Số lượng có hạn · Kết thúc 31/05/2026
                </p>
            </div>
        </div>
    </div>

    <div class="max-w-[1400px] mx-auto px-4 md:px-8 lg:px-16 pt-10">


        <!-- Toolbar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-gray-100">
            <p class="text-sm font-semibold text-gray-700">
                <span class="font-black text-black">@sortedProducts.Length</span> sản phẩm đang sale
            </p>
            <div class="flex items-center gap-3">
                <span class="text-xs font-bold uppercase tracking-widest text-gray-400">Sắp xếp</span>
                <select onchange="window.location.href='?sortBy='+this.value"
                        class="border border-gray-200 bg-white px-3 py-2 text-xs font-semibold outline-none focus:border-black cursor-pointer rounded-lg">
                    <option value="discount" selected="@(Model.SortBy == "discount" || string.IsNullOrEmpty(Model.SortBy) ? "selected" : null)">Giảm nhiều nhất</option>
                    <option value="price-low" selected="@(Model.SortBy == "price-low" ? "selected" : null)">Giá: Thấp → Cao</option>
                    <option value="price-high" selected="@(Model.SortBy == "price-high" ? "selected" : null)">Giá: Cao → Thấp</option>
                </select>
            </div>
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-12">
            @foreach (var product in sortedProducts)
            {
                @await Html.PartialAsync("_ProductCard", product)
            }
        </div>
    </div>
</main>

@section Styles {
    <link rel="stylesheet" href="~/css/product-card.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/product-card.js" asp-append-version="true"></script>
}
