@page
@model Web.Pages.Public.Payment.BankTransferModel
@{
    var isMomo = Model.PaymentMethod == "momo";
    ViewData["Title"] = isMomo
        ? "Thanh toán MoMo — The Old Pavement"
        : "Chuyển khoản ngân hàng — The Old Pavement";
}

<main class="max-w-2xl mx-auto px-4 py-16 pb-24">

    <!-- Header -->
    <div class="text-center mb-10">
        <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-400 mb-1">The Old Pavement</p>
        @if (isMomo)
        {
            <div class="flex items-center justify-center gap-3 mb-2">
                <div class="w-10 h-10 bg-[#ae2070] flex items-center justify-center rounded-lg">
                    <span class="text-white font-black text-sm">M</span>
                </div>
                <h1 class="text-2xl md:text-3xl font-black uppercase tracking-tight">Thanh toán MoMo</h1>
            </div>
            <p class="text-sm text-gray-500">Quét mã QR hoặc chuyển khoản MoMo theo thông tin bên dưới</p>
        }
        else
        {
            <h1 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-2">Chuyển khoản ngân hàng</h1>
            <p class="text-sm text-gray-500">Vui lòng chuyển khoản theo thông tin bên dưới để hoàn tất đơn hàng</p>
        }
    </div>

    <!-- Order info banner -->
    <div id="status-banner" class="bg-amber-50 border border-amber-200 px-5 py-4 mb-8 flex items-start gap-3">
        <i data-lucide="clock" class="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5"></i>
        <div>
            <p class="text-xs font-bold text-amber-800 uppercase tracking-wide mb-0.5">Đơn hàng đang chờ thanh toán</p>
            <p class="text-xs text-amber-700">Trang này sẽ tự động cập nhật khi chúng tôi xác nhận giao dịch của bạn.</p>
        </div>
    </div>

    <!-- Success overlay (hidden by default, shown when paid) -->
    <div id="paid-overlay" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm">
        <div class="bg-white border border-gray-200 p-10 max-w-sm w-full mx-4 text-center space-y-5 shadow-2xl">
            <div class="w-16 h-16 bg-emerald-50 rounded-full flex items-center justify-center mx-auto">
                <i data-lucide="check-circle" class="w-8 h-8 text-emerald-500"></i>
            </div>
            <div>
                <h2 class="text-lg font-black uppercase tracking-tight text-gray-900 mb-1">Thanh toán thành công!</h2>
                <p class="text-xs text-gray-500">Đơn hàng <strong id="paid-order-number" class="text-black font-mono"></strong> đã được xác nhận.</p>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-1.5 overflow-hidden">
                <div id="redirect-bar" class="h-full bg-emerald-500 rounded-full transition-none" style="width:0%"></div>
            </div>
            <p class="text-[10px] text-gray-400">Đang chuyển hướng trong <span id="countdown">3</span> giây...</p>
        </div>
    </div>

    <!-- ── Payment cards: MoMo first if momo, Bank first if bank ── -->
    @if (isMomo)
    {
        <!-- MoMo card — PRIMARY (full featured with QR) -->
        <div class="border-2 border-[#ae2070] bg-white mb-4">
            <div class="px-6 py-4 border-b border-[#f5d0e3] flex items-center gap-3 bg-[#fdf2f7]">
                <div class="w-8 h-8 bg-[#ae2070] flex items-center justify-center flex-shrink-0">
                    <span class="text-white font-black text-[10px] tracking-widest">M</span>
                </div>
                <div>
                    <h2 class="text-xs font-black uppercase tracking-[0.15em] text-[#ae2070]">Thanh toán qua MoMo</h2>
                    <p class="text-[10px] text-gray-500 mt-0.5">Quét QR hoặc chuyển khoản ví MoMo</p>
                </div>
            </div>

            <div class="flex flex-col md:flex-row">
                <!-- QR Code -->
                <div class="flex flex-col items-center justify-center px-6 py-6 border-b md:border-b-0 md:border-r border-gray-100 md:w-64 flex-shrink-0 bg-gray-50">
                    <img src="/images/momo-qr.png"
                         alt="QR MoMo — Nguyễn Thế Hoàng Tùng"
                         class="w-48 h-48 object-contain"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                    <div style="display:none" class="w-48 h-48 bg-white border-2 border-dashed border-[#ae2070] flex-col items-center justify-center text-center p-4 gap-2">
                        <span class="text-3xl">📱</span>
                        <p class="text-xs text-gray-500 font-semibold">Mở app MoMo<br/>tìm số <strong class="text-[#ae2070]">0965481905</strong></p>
                    </div>
                    <p class="text-[10px] text-[#ae2070] mt-2 font-bold uppercase tracking-wide">Quét để chuyển tiền</p>
                </div>

                <!-- Account info -->
                <div class="flex-1 divide-y divide-gray-50">
                    <div class="flex items-center justify-between px-6 py-4">
                        <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Số điện thoại</span>
                        <div class="flex items-center gap-2">
                            <span id="momo-number" class="text-sm font-black text-gray-900 font-mono tracking-wider">0965481905</span>
                            <button onclick="copyText('momo-number', this)" class="text-gray-400 hover:text-[#ae2070] transition-colors" title="Sao chép">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                    <div class="flex items-center justify-between px-6 py-4">
                        <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Tên tài khoản</span>
                        <span class="text-sm font-black text-gray-900">Nguyễn Thế Hoàng Tùng</span>
                    </div>
                    <div class="flex items-center justify-between px-6 py-4">
                        <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Số tiền</span>
                        <div class="flex items-center gap-2">
                            <span id="momo-amount-display" class="text-lg font-black text-[#ae2070] tabular-nums">@Model.Amount.ToString("N0")₫</span>
                            <span id="momo-amount-raw" class="hidden">@((long)Model.Amount)</span>
                            <button onclick="copyText('momo-amount-raw', this)" class="text-gray-400 hover:text-[#ae2070] transition-colors" title="Sao chép số tiền">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                    <div class="flex items-center justify-between px-6 py-4">
                        <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Nội dung CK</span>
                        <div class="flex items-center gap-2">
                            <span id="momo-content" class="text-sm font-black text-gray-900 font-mono">@Model.TransferContent</span>
                            <button onclick="copyText('momo-content', this)" class="text-gray-400 hover:text-[#ae2070] transition-colors" title="Sao chép">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MBBank card — SECONDARY (collapsed style) -->
        <div class="border border-gray-200 bg-white mb-6">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-3">
                <div class="w-8 h-8 bg-[#003189] flex items-center justify-center flex-shrink-0">
                    <span class="text-white font-black text-[10px] tracking-widest">MB</span>
                </div>
                <div class="flex-1">
                    <h2 class="text-xs font-black uppercase tracking-[0.15em]">Hoặc chuyển khoản MBBank</h2>
