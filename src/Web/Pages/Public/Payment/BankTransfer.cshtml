    <!-- Important note -->
    <div class="bg-gray-50 border border-gray-200 px-5 py-4 mb-8 space-y-2">
        <p class="text-[10px] font-black uppercase tracking-widest text-gray-500 mb-2">Lưu ý quan trọng</p>
        <div class="space-y-1.5 text-xs text-gray-600">
            <div class="flex items-start gap-2">
                <i data-lucide="check-circle" class="w-3.5 h-3.5 text-emerald-500 flex-shrink-0 mt-0.5"></i>
