                </div>
            </div>
            <div class="flex flex-col md:flex-row">
                <div class="flex flex-col items-center justify-center px-6 py-5 border-b md:border-b-0 md:border-r border-gray-100 md:w-48 flex-shrink-0">
                    <img src="https://img.vietqr.io/image/MB-@(Model.AccountNumber)-compact2.png?amount=@((long)Model.Amount)&addInfo=@(Uri.EscapeDataString(Model.TransferContent))&accountName=@(Uri.EscapeDataString(Model.AccountHolder))"
                         alt="QR MBBank"
                         class="w-32 h-32 object-contain"
                         onerror="this.src='/images/mb-qr.png'; this.onerror=function(){ this.style.display='none'; }" />
                    <p class="text-[10px] text-gray-400 mt-1.5 font-semibold uppercase tracking-wide">Quét VietQR</p>
                </div>
                <div class="flex-1 divide-y divide-gray-50">
                    <div class="flex items-center justify-between px-6 py-3">
                        <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Số tài khoản</span>
                        <div class="flex items-center gap-2">
                            <span id="account-number" class="text-sm font-black text-gray-900 font-mono tracking-wider">@Model.AccountNumber</span>
                            <button onclick="copyText('account-number', this)" class="text-gray-400 hover:text-black transition-colors" title="Sao chép">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                    <div class="flex items-center justify-between px-6 py-3">
                        <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Chủ tài khoản</span>
                        <span class="text-sm font-black text-gray-900 uppercase">@Model.AccountHolder</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- MBBank card — PRIMARY -->
        <div class="border-2 border-[#003189] bg-white mb-4">
            <div class="px-6 py-4 border-b border-blue-100 flex items-center gap-3 bg-blue-50">
                <div class="w-8 h-8 bg-[#003189] flex items-center justify-center flex-shrink-0">
                    <span class="text-white font-black text-[10px] tracking-widest">MB</span>
                </div>
                <div>
                    <h2 class="text-xs font-black uppercase tracking-[0.15em] text-[#003189]">Chuyển khoản MBBank</h2>
                    <p class="text-[10px] text-gray-500 mt-0.5">Ngân hàng TMCP Quân đội</p>
                </div>
            </div>
            <div class="flex flex-col md:flex-row">
                <div class="flex flex-col items-center justify-center px-6 py-6 border-b md:border-b-0 md:border-r border-gray-100 md:w-64 flex-shrink-0 bg-gray-50">
                    <img src="https://img.vietqr.io/image/MB-@(Model.AccountNumber)-compact2.png?amount=@((long)Model.Amount)&addInfo=@(Uri.EscapeDataString(Model.TransferContent))&accountName=@(Uri.EscapeDataString(Model.AccountHolder))"
                         alt="QR MBBank — Nguyễn Thế Hoàng Tùng"
                         class="w-48 h-48 object-contain"
                         onerror="this.src='/images/mb-qr.png'; this.onerror=function(){ this.style.display='none'; this.nextElementSibling.style.display='flex'; }" />
                    <div style="display:none" class="w-48 h-48 bg-white border-2 border-dashed border-[#003189] flex-col items-center justify-center text-center p-4 gap-2">
                        <span class="text-3xl">🏦</span>
                        <p class="text-xs text-gray-500 font-semibold">Chuyển khoản đến số tài khoản <strong class="text-[#003189]">@Model.AccountNumber</strong></p>
                    </div>
                    <p class="text-[10px] text-[#003189] mt-2 font-bold uppercase tracking-wide">Quét VietQR để chuyển tiền</p>
                </div>
                <div class="flex-1 divide-y divide-gray-50">
                    <div class="flex items-center justify-between px-6 py-4">
                        <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Số tài khoản</span>
                        <div class="flex items-center gap-2">
                            <span id="account-number" class="text-sm font-black text-gray-900 font-mono tracking-wider">@Model.AccountNumber</span>
                            <button onclick="copyText('account-number', this)" class="text-gray-400 hover:text-black transition-colors" title="Sao chép">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                    <div class="flex items-center justify-between px-6 py-4">
                        <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Chủ tài khoản</span>
                        <span class="text-sm font-black text-gray-900 uppercase">@Model.AccountHolder</span>
                    </div>
                    <div class="flex items-center justify-between px-6 py-4">
                        <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Số tiền</span>
                        <div class="flex items-center gap-2">
                            <span id="bank-amount-display" class="text-lg font-black text-[#003189] tabular-nums">@Model.Amount.ToString("N0")₫</span>
                            <span id="bank-amount-raw" class="hidden">@((long)Model.Amount)</span>
                            <button onclick="copyText('bank-amount-raw', this)" class="text-gray-400 hover:text-black transition-colors" title="Sao chép số tiền">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                    <div class="flex items-center justify-between px-6 py-4">
                        <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Nội dung CK</span>
                        <div class="flex items-center gap-2">
                            <span id="bank-content" class="text-sm font-black text-gray-900 font-mono">@Model.TransferContent</span>
                            <button onclick="copyText('bank-content', this)" class="text-gray-400 hover:text-black transition-colors" title="Sao chép">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MoMo card — SECONDARY -->
        <div class="border border-gray-200 bg-white mb-6">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-3">
                <div class="w-8 h-8 bg-[#ae2070] flex items-center justify-center flex-shrink-0">
                    <span class="text-white font-black text-[10px] tracking-widest">M</span>
                </div>
                <div>
                    <h2 class="text-xs font-black uppercase tracking-[0.15em]">Hoặc chuyển khoản MoMo</h2>
                    <p class="text-[10px] text-gray-400 mt-0.5">Ví điện tử MoMo</p>
                </div>
            </div>
            <div class="flex flex-col md:flex-row">
                <div class="flex flex-col items-center justify-center px-6 py-5 border-b md:border-b-0 md:border-r border-gray-100 md:w-48 flex-shrink-0">
                    <img src="/images/momo-qr.png" alt="QR MoMo"
                         class="w-32 h-32 object-contain"
                         onerror="this.style.display='none'" />
                    <p class="text-[10px] text-gray-400 mt-1.5 font-semibold uppercase tracking-wide">Quét QR</p>
                </div>
                <div class="flex-1 divide-y divide-gray-50">
                    <div class="flex items-center justify-between px-6 py-3">
                        <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Số điện thoại</span>
                        <div class="flex items-center gap-2">
                            <span id="momo-number" class="text-sm font-black text-gray-900 font-mono">0965481905</span>
                            <button onclick="copyText('momo-number', this)" class="text-gray-400 hover:text-black transition-colors">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                    <div class="flex items-center justify-between px-6 py-3">
                        <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Tên tài khoản</span>
                        <span class="text-sm font-black text-gray-900">Nguyễn Thế Hoàng Tùng</span>
                    </div>
                    <div class="flex items-center justify-between px-6 py-3">
                        <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Nội dung CK</span>
                        <div class="flex items-center gap-2">
                            <span id="momo-content-sec" class="text-sm font-black text-gray-900 font-mono">@Model.TransferContent</span>
                            <button onclick="copyText('momo-content-sec', this)" class="text-gray-400 hover:text-black transition-colors" title="Sao chép">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
