    <!-- Transfer details -->
    <div class="border border-gray-200 bg-white mb-6">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-3">
            <div class="w-8 h-8 bg-black flex items-center justify-center flex-shrink-0">
                <i data-lucide="receipt" class="w-4 h-4 text-white"></i>
            </div>
            <h2 class="text-xs font-black uppercase tracking-[0.15em]">Thông tin chuyển khoản</h2>
        </div>

        <div class="divide-y divide-gray-50">
            <div class="flex items-center justify-between px-6 py-4">
                <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Số tiền</span>
                <span class="text-lg font-black text-gray-900 tabular-nums">@Model.Amount.ToString("N0")₫</span>
            </div>
            <div class="flex items-center justify-between px-6 py-4">
                <span class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Nội dung CK</span>
                <div class="flex items-center gap-2">
                    <span id="transfer-content" class="text-sm font-black text-gray-900 font-mono">@Model.TransferContent</span>
                    <button onclick="copyText('transfer-content', this)" class="text-gray-400 hover:text-black transition-colors" title="Sao chép">
