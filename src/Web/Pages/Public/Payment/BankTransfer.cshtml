    <p class="text-center text-[10px] text-gray-400 mt-6">
        Cần hỗ trợ? Liên hệ chúng tôi qua email
        <a href="mailto:theoldpavement@gmail.com" class="underline hover:text-black transition-colors">theoldpavement@gmail.com</a>
    </p>
</main>

<script>
function copyText(elementId, btn) {
    const text = document.getElementById(elementId).textContent.trim();
    navigator.clipboard.writeText(text).then(function () {
        const icon = btn.querySelector('[data-lucide]');
        if (icon) {
            icon.setAttribute('data-lucide', 'check');
            lucide.createIcons();
            setTimeout(function () {
                icon.setAttribute('data-lucide', 'copy');
                lucide.createIcons();
            }, 1500);
        }
    });
}

// ── Payment status polling ──────────────────────────────────────────────────
(function () {
    const ORDER_NUMBER = '@Model.OrderNumber';
    const POLL_INTERVAL = 4000; // 4 seconds
    const REDIRECT_DELAY = 3000; // 3 seconds countdown before redirect
    let pollTimer = null;
    let stopped = false;

    function showPaidOverlay(orderNumber) {
        stopped = true;
        clearInterval(pollTimer);

        // Clear cart cookie/session via hidden form submit won't work here,
        // so we rely on server-side clear on ThankYouCard load.
        const overlay = document.getElementById('paid-overlay');
        const orderEl = document.getElementById('paid-order-number');
        const bar = document.getElementById('redirect-bar');
        const countdownEl = document.getElementById('countdown');

        if (orderEl) orderEl.textContent = orderNumber;
        if (overlay) overlay.classList.remove('hidden');
        if (window.lucide) lucide.createIcons();

        // Animate progress bar over REDIRECT_DELAY
        let elapsed = 0;
        const step = 50;
        const timer = setInterval(function () {
            elapsed += step;
            const pct = Math.min((elapsed / REDIRECT_DELAY) * 100, 100);
            if (bar) bar.style.width = pct + '%';
            const secs = Math.max(0, Math.ceil((REDIRECT_DELAY - elapsed) / 1000));
            if (countdownEl) countdownEl.textContent = secs;
            if (elapsed >= REDIRECT_DELAY) {
                clearInterval(timer);
                window.location.href = '/ThankYouCard?orderNumber=' + encodeURIComponent(orderNumber);
            }
        }, step);
    }

    async function checkStatus() {
        if (stopped) return;
        try {
            const res = await fetch(
                '/Public/Payment/BankTransfer?handler=CheckStatus&orderNumber=' + encodeURIComponent(ORDER_NUMBER),
                { cache: 'no-store' }
            );
            if (!res.ok) return;
            const data = await res.json();
            if (data.paid) {
                showPaidOverlay(data.orderNumber || ORDER_NUMBER);
            }
        } catch (e) {
            // Network error — silently retry next interval
        }
    }

    // Start polling immediately then every POLL_INTERVAL
    if (ORDER_NUMBER) {
        checkStatus();
        pollTimer = setInterval(checkStatus, POLL_INTERVAL);
    }

    // Stop polling when tab is hidden, resume when visible
    document.addEventListener('visibilitychange', function () {
        if (document.hidden) {
            clearInterval(pollTimer);
        } else if (!stopped) {
            checkStatus();
            pollTimer = setInterval(checkStatus, POLL_INTERVAL);
        }
    });
})();
</script>
