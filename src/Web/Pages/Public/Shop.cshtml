@page "/Shop"
@model Web.Pages.Public.ShopModel
@{
    ViewData["Title"] = "Cửa hàng - Tất cả sản phẩm";
    var bannerProduct = Model.Products.FirstOrDefault(p => p.Slug == "36-pho-phuong");
    var bannerImage = bannerProduct?.ProductImages?.FirstOrDefault()?.ImageUrl
        ?? "https://images.unsplash.com/photo-1521334884684-d80222895322?auto=format&fit=crop&w=1080&q=80";
}

<section class="relative overflow-hidden mb-12">
    <div class="absolute inset-0">
        <img src="@bannerImage" alt="36 Phố Phường" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/40"></div>
    </div>
    <div class="relative z-10 max-w-[1400px] mx-auto px-4 md:px-8 lg:px-16 py-24 md:py-32 lg:py-36 text-center text-white">
        <p class="text-sm tracking-[0.35em] uppercase text-white/80">36 PHỐ PHƯỜNG</p>
        <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tight">Streetwear đậm chất phố cổ Hà Nội</h1>
        <p class="mt-6 max-w-2xl mx-auto text-sm md:text-base text-white/80 leading-relaxed">Bộ sưu tập lấy cảm hứng từ 36 phố phường, hoài niệm Hà Nội và tinh thần streetwear hiện đại.</p>
        <a href="/Product/36-pho-phuong" class="inline-flex items-center justify-center mt-8 rounded-full bg-white text-black px-8 py-3 text-sm font-semibold uppercase tracking-[0.15em] hover:bg-gray-100 transition">Xem ngay</a>
    </div>
</section>

<main class="pt-0 px-4 md:px-8 lg:px-16 max-w-[1400px] mx-auto pb-20">
    
    <!-- Header -->
    <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-black tracking-tighter uppercase mb-4">MUA SẮM</h1>
        <p class="text-gray-500 max-w-xl mx-auto text-sm">Khám phá toàn bộ bộ sưu tập của The Old Pavement. Thiết kế đường phố mang dấu ấn Hà Nội, chất liệu cao cấp và form dáng chuẩn streetwear.</p>
    </div>

    <!-- Advanced Filter Toolbar -->
    <div class="bg-white border border-gray-200 mb-8 sticky top-14 z-20 shadow-sm">
        <form method="get" class="flex flex-wrap items-end gap-0" id="filter-form">
            <!-- Search -->
            <div class="flex-grow min-w-[200px] border-r border-gray-200 p-3">
                <label class="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1.5">Tìm kiếm</label>
                <div class="relative">
                    <i data-lucide="search" class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-400"></i>
                    <input asp-for="SearchQuery" id="shop-search-input" type="text" placeholder="Tên sản phẩm..."
                           class="w-full bg-gray-50 border border-gray-200 pl-8 pr-3 py-2 text-xs font-semibold focus:outline-none focus:border-black focus:bg-white transition-all" />
                </div>
            </div>

            <!-- Category -->
            <div class="min-w-[140px] border-r border-gray-200 p-3">
                <label class="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1.5">Danh mục</label>
                <select asp-for="Category" onchange="document.getElementById('filter-form').submit()"
                        class="w-full bg-gray-50 border border-gray-200 px-3 py-2 text-xs font-bold focus:outline-none focus:border-black cursor-pointer transition-all">
                    <option value="all">Tất cả</option>
                    <option value="Tee">Áo Thun</option>
                    <option value="Pants">Quần</option>
                    <option value="Accessories">Phụ kiện</option>
                    <option value="Outerwear">Áo Khoác</option>
                </select>
            </div>

            <!-- Price Range -->
            <div class="min-w-[220px] border-r border-gray-200 p-3">
                <label class="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1.5">Khoảng giá (₫)</label>
                <div class="flex gap-2 items-center">
                    <input asp-for="MinPrice" type="number" placeholder="0"
                           class="w-full bg-gray-50 border border-gray-200 px-2 py-2 text-xs font-semibold focus:outline-none focus:border-black text-center" />
                    <span class="text-gray-300 font-bold text-xs flex-shrink-0">—</span>
                    <input asp-for="MaxPrice" type="number" placeholder="∞"
                           class="w-full bg-gray-50 border border-gray-200 px-2 py-2 text-xs font-semibold focus:outline-none focus:border-black text-center" />
                </div>
            </div>

            <!-- Sort -->
            <div class="min-w-[150px] border-r border-gray-200 p-3">
                <label class="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1.5">Sắp xếp</label>
                <select asp-for="SortBy" onchange="document.getElementById('filter-form').submit()"
                        class="w-full bg-gray-50 border border-gray-200 px-3 py-2 text-xs font-bold focus:outline-none focus:border-black cursor-pointer transition-all">
                    <option value="newest">Mới nhất</option>
                    <option value="bestselling">Bán chạy</option>
                    <option value="price_asc">Giá: Thấp → Cao</option>
                    <option value="price_desc">Giá: Cao → Thấp</option>
                    <option value="name_asc">Tên: A-Z</option>
                    <option value="name_desc">Tên: Z-A</option>
                </select>
            </div>

            <!-- Actions -->
            <div class="flex items-end gap-2 p-3">
                <button type="submit" class="bg-black text-white px-5 py-2 text-[10px] font-black tracking-widest hover:bg-gray-800 transition-colors uppercase">
                    LỌC
                </button>
                <a href="/Shop" class="bg-gray-100 text-gray-600 px-4 py-2 text-[10px] font-black tracking-widest hover:bg-gray-200 transition-colors uppercase flex items-center gap-1" title="Xóa bộ lọc">
                    <i data-lucide="rotate-ccw" class="w-3 h-3"></i>
                    XÓA
                </a>
            </div>
        </form>

        <!-- Active Filter Tags -->
        @{
            var hasActiveFilters = !string.IsNullOrEmpty(Model.SearchQuery) ||
                                   (Model.Category != null && Model.Category != "all") ||
                                   Model.MinPrice.HasValue || Model.MaxPrice.HasValue ||
                                   (Model.SortBy != null && Model.SortBy != "newest");
        }
        @if (hasActiveFilters)
        {
            <div class="px-4 pb-3 pt-0 flex flex-wrap items-center gap-2 border-t border-gray-100">
                <span class="text-[9px] font-black uppercase tracking-widest text-gray-400">Đang lọc:</span>
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a href="@(Request.Path)?Category=@(Model.Category ?? "all")&SortBy=@(Model.SortBy ?? "newest")@(Model.MinPrice.HasValue ? "&MinPrice="+Model.MinPrice : "")@(Model.MaxPrice.HasValue ? "&MaxPrice="+Model.MaxPrice : "")"
                       class="inline-flex items-center gap-1 bg-black text-white text-[9px] font-black px-2.5 py-1 uppercase tracking-wider hover:bg-gray-700 transition-colors">
                        "«@Model.SearchQuery»"
                        <i data-lucide="x" class="w-2.5 h-2.5"></i>
                    </a>
                }
                @if (Model.Category != null && Model.Category != "all")
                {
                    <a href="@(Request.Path)?SearchQuery=@(Model.SearchQuery)&SortBy=@(Model.SortBy ?? "newest")@(Model.MinPrice.HasValue ? "&MinPrice="+Model.MinPrice : "")@(Model.MaxPrice.HasValue ? "&MaxPrice="+Model.MaxPrice : "")"
                       class="inline-flex items-center gap-1 bg-black text-white text-[9px] font-black px-2.5 py-1 uppercase tracking-wider hover:bg-gray-700 transition-colors">
                        @Model.Category
                        <i data-lucide="x" class="w-2.5 h-2.5"></i>
                    </a>
                }
                @if (Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
                {
                    <a href="@(Request.Path)?SearchQuery=@(Model.SearchQuery)&Category=@(Model.Category ?? "all")&SortBy=@(Model.SortBy ?? "newest")"
                       class="inline-flex items-center gap-1 bg-black text-white text-[9px] font-black px-2.5 py-1 uppercase tracking-wider hover:bg-gray-700 transition-colors">
                        @(Model.MinPrice?.ToString("N0") ?? "0")₫ – @(Model.MaxPrice?.ToString("N0") ?? "∞")₫
                        <i data-lucide="x" class="w-2.5 h-2.5"></i>
                    </a>
                }
            </div>
        }
    </div>

    <!-- Results Overview -->
    <div class="mb-6 flex justify-between items-center">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
            Hiển thị <span class="font-black text-black">@Model.Products.Count</span> sản phẩm
        </p>
    </div>

    <!-- Product Grid -->
    @if (Model.Products.Any())
    {
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-12">
            @foreach (var p in Model.Products)
            {
                @await Html.PartialAsync("_ProductCard", p)
            }
        </div>
    }
    else
    {
        <div class="py-20 text-center border-2 border-dashed border-gray-200">
            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4 text-gray-400">
                <i data-lucide="package-open" class="w-8 h-8"></i>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Không tìm thấy sản phẩm nào!</h3>
            <p class="text-gray-500 text-sm mb-6 max-w-md mx-auto">Bộ lọc của bạn không khớp với bất kỳ sản phẩm nào trong cửa hàng. Vui lòng thử lại với các tiêu chí khác.</p>
            <a href="/Shop" class="inline-block bg-black text-white px-8 py-3 text-xs font-bold tracking-widest hover:bg-gray-800 transition-colors uppercase">
                Xóa bộ lọc
            </a>
        </div>
    }
</main>

@section Styles {
    <link rel="stylesheet" href="~/css/product-card.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/product-card.js" asp-append-version="true"></script>
}


