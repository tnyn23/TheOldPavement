@page "/Shop"
@model Web.Pages.Public.ShopModel
@{
    ViewData["Title"] = "Shop — The Old Pavement";
    var hasActiveFilters = !string.IsNullOrEmpty(Model.SearchQuery)
        || (Model.Category != null && Model.Category != "all")
        || Model.MinPrice.HasValue || Model.MaxPrice.HasValue
        || (Model.SortBy != null && Model.SortBy != "newest");

    // Build base URL for pagination (preserve all filters)
    var qs = new System.Text.StringBuilder("/Shop?");
    if (!string.IsNullOrEmpty(Model.SearchQuery)) qs.Append($"SearchQuery={Uri.EscapeDataString(Model.SearchQuery)}&");
    if (!string.IsNullOrEmpty(Model.Category) && Model.Category != "all") qs.Append($"Category={Uri.EscapeDataString(Model.Category)}&");
    if (Model.MinPrice.HasValue) qs.Append($"MinPrice={Model.MinPrice}&");
    if (Model.MaxPrice.HasValue) qs.Append($"MaxPrice={Model.MaxPrice}&");
    if (!string.IsNullOrEmpty(Model.SortBy) && Model.SortBy != "newest") qs.Append($"SortBy={Model.SortBy}&");
    var shopBaseUrl = qs.ToString().TrimEnd('&', '?');
}

@section Styles {
    <link rel="stylesheet" href="~/css/product-card.css" asp-append-version="true" />
    <style>
        .size-btn { display:inline-flex; align-items:center; justify-content:center; width:40px; height:36px; border:1px solid #e5e7eb; font-size:11px; font-weight:700; cursor:pointer; transition:all 150ms ease; background:#fff; color:#374151; }
        .size-btn:hover, .size-btn.active { border-color:#111827; background:#111827; color:#fff; }
        .color-swatch { width:20px; height:20px; border-radius:50%; border:2px solid transparent; cursor:pointer; transition:all 150ms ease; }
        .color-swatch:hover, .color-swatch.active { border-color:#111827; transform:scale(1.15); }
        .filter-section { border-bottom:1px solid #f3f4f6; padding-bottom:20px; margin-bottom:20px; }
        .filter-section:last-child { border-bottom:none; }
        .filter-label { font-size:11px; font-weight:800; letter-spacing:0.1em; text-transform:uppercase; color:#111827; margin-bottom:12px; display:flex; align-items:center; justify-content:space-between; cursor:pointer; }
        /* Price range */
        input[type=range] { -webkit-appearance:none; width:100%; height:3px; background:#e5e7eb; outline:none; }
        input[type=range]::-webkit-slider-thumb { -webkit-appearance:none; width:14px; height:14px; border-radius:50%; background:#111827; cursor:pointer; }
    </style>
}

<div class="max-w-[1400px] mx-auto px-4 md:px-8 lg:px-16 py-8 pb-24">

    <!-- Page header -->
    <div class="border-b border-gray-100 pb-5 mb-8 flex items-end justify-between">
        <div>
            <p class="text-[10px] font-black tracking-[0.2em] uppercase text-gray-400 mb-1">The Old Pavement</p>
            <h1 class="text-3xl md:text-4xl font-black uppercase tracking-tight">
                @if (!string.IsNullOrEmpty(Model.Category) && Model.Category != "all")
                {
                    @Model.Category
                }
                else
                {
                    <text>Tất cả sản phẩm</text>
                }
            </h1>
        </div>
        <p class="text-xs text-gray-400 font-medium hidden sm:block">
            <span class="font-black text-black">@Model.TotalCount</span> sản phẩm
        </p>
    </div>

    <div class="flex gap-8">

        <!-- ── SIDEBAR FILTER ── -->
        <aside class="hidden lg:block w-56 flex-shrink-0">
            <form method="get" id="filter-form">
                <!-- Search -->
                <div class="filter-section">
                    <p class="filter-label">Tìm kiếm</p>
                    <div class="relative">
                        <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-400 pointer-events-none"></i>
                        <input asp-for="SearchQuery" type="text" placeholder="Tên sản phẩm..."
                               class="w-full border border-gray-200 bg-white pl-9 pr-3 py-2 text-xs font-medium outline-none focus:border-black transition-colors" />
                    </div>
                </div>

                <!-- Category -->
                <div class="filter-section">
                    <p class="filter-label">Danh mục sản phẩm</p>
                    <div class="space-y-1.5">
                        @{
                            var cats = new[] {
                                ("all", "Tất cả"),
                                ("Tee", "Áo Thun"),
                                ("Hoodie", "Hoodie"),
                                ("Pants", "Quần"),
                                ("Jacket", "Áo Khoác"),
                                ("Accessories", "Phụ kiện"),
                            };
                        }
                        @foreach (var (val, label) in cats)
                        {
                            var isActive = (Model.Category ?? "all") == val;
                            <a href="/Shop?Category=@val@(!string.IsNullOrEmpty(Model.SearchQuery) ? "&SearchQuery="+Uri.EscapeDataString(Model.SearchQuery) : "")@(Model.SortBy != "newest" ? "&SortBy="+Model.SortBy : "")"
                               class="flex items-center justify-between py-1.5 text-xs font-medium transition-colors @(isActive ? "text-black font-bold" : "text-gray-500 hover:text-black")">
                                <span>@label</span>
                                @if (isActive) { <span class="w-1.5 h-1.5 bg-black rounded-full"></span> }
                            </a>
                        }
                    </div>
                </div>

                <!-- Price Range -->
                <div class="filter-section">
                    <p class="filter-label">Khoảng giá</p>
                    <div class="space-y-3">
                        <input type="range" id="price-max-slider" min="0" max="2000000" step="50000"
                               value="@(Model.MaxPrice ?? 2000000)"
                               oninput="document.getElementById('price-max-display').textContent = Number(this.value).toLocaleString('vi-VN') + '₫'; document.getElementById('MaxPrice').value = this.value;" />
                        <div class="flex justify-between text-[10px] text-gray-500 font-semibold">
                            <span>0₫</span>
                            <span id="price-max-display">@((Model.MaxPrice ?? 2000000).ToString("N0"))₫</span>
                        </div>
                        <input type="hidden" asp-for="MaxPrice" id="MaxPrice" />
                        <input type="hidden" asp-for="MinPrice" />
                    </div>
                </div>

                <!-- Size -->
                <div class="filter-section">
                    <p class="filter-label">Kích thước</p>
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var sz in new[] { "S", "M", "L", "XL", "XXL" })
                        {
                            <button type="button" class="size-btn" onclick="toggleSizeFilter(this, '@sz')">@sz</button>
                        }
                    </div>
                </div>

                <!-- Sort -->
                <div class="filter-section">
                    <p class="filter-label">Sắp xếp</p>
                    <select asp-for="SortBy" onchange="this.form.submit()"
                            class="w-full border border-gray-200 bg-white px-3 py-2 text-xs font-semibold outline-none focus:border-black cursor-pointer appearance-none">
                        <option value="newest">Mới nhất</option>
                        <option value="bestselling">Bán chạy</option>
                        <option value="price_asc">Giá: Thấp → Cao</option>
                        <option value="price_desc">Giá: Cao → Thấp</option>
                        <option value="name_asc">Tên: A-Z</option>
                    </select>
                </div>

                <button type="submit"
                        class="w-full bg-black text-white py-2.5 text-[10px] font-black tracking-widest uppercase hover:bg-gray-800 transition-colors mb-2">
                    Áp dụng
                </button>
                @if (hasActiveFilters)
                {
                    <a href="/Shop" class="block w-full text-center py-2 text-[10px] font-bold uppercase tracking-widest text-gray-400 hover:text-black transition-colors border border-gray-200 hover:border-black">
                        Xoá bộ lọc
                    </a>
                }
            </form>
        </aside>

        <!-- ── MAIN CONTENT ── -->
        <div class="flex-1 min-w-0">

            <!-- Mobile filter + sort bar -->
            <div class="lg:hidden flex items-center gap-2 mb-5">
                <button onclick="document.getElementById('mobile-filter').classList.toggle('hidden')"
                        class="flex items-center gap-2 border border-gray-200 px-4 py-2 text-xs font-bold uppercase tracking-widest hover:border-black transition-colors">
                    <i data-lucide="sliders-horizontal" class="w-3.5 h-3.5"></i>
                    Bộ lọc
                </button>
                <form method="get" class="flex-1">
                    <input type="hidden" asp-for="SearchQuery" />
                    <input type="hidden" asp-for="Category" />
                    <input type="hidden" asp-for="MinPrice" />
                    <input type="hidden" asp-for="MaxPrice" />
                    <select asp-for="SortBy" onchange="this.form.submit()"
                            class="w-full border border-gray-200 bg-white px-3 py-2 text-xs font-semibold outline-none focus:border-black cursor-pointer appearance-none">
                        <option value="newest">Mới nhất</option>
                        <option value="bestselling">Bán chạy</option>
                        <option value="price_asc">Giá: Thấp → Cao</option>
                        <option value="price_desc">Giá: Cao → Thấp</option>
                    </select>
                </form>
                <p class="text-xs text-gray-400 flex-shrink-0"><span class="font-black text-black">@Model.TotalCount</span> sp</p>
            </div>

            <!-- Mobile filter panel -->
            <div id="mobile-filter" class="hidden lg:hidden mb-5 p-4 bg-gray-50 border border-gray-100">
                <form method="get">
                    <div class="grid grid-cols-2 gap-3 mb-3">
                        <div>
                            <p class="text-[9px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Danh mục</p>
                            <select asp-for="Category" class="w-full border border-gray-200 bg-white px-3 py-2 text-xs font-semibold outline-none focus:border-black cursor-pointer appearance-none">
                                <option value="all">Tất cả</option>
                                <option value="Tee">Áo Thun</option>
                                <option value="Hoodie">Hoodie</option>
                                <option value="Pants">Quần</option>
                                <option value="Jacket">Áo Khoác</option>
                                <option value="Accessories">Phụ kiện</option>
                            </select>
                        </div>
                        <div>
                            <p class="text-[9px] font-black uppercase tracking-widest text-gray-400 mb-1.5">Giá tối đa</p>
                            <input asp-for="MaxPrice" type="number" placeholder="2000000"
                                   class="w-full border border-gray-200 bg-white px-3 py-2 text-xs font-medium outline-none focus:border-black" />
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <button type="submit" class="flex-1 bg-black text-white py-2 text-[10px] font-black tracking-widest uppercase">Lọc</button>
                        <a href="/Shop" class="flex-1 text-center border border-gray-200 py-2 text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:border-black hover:text-black transition-colors">Xoá</a>
                    </div>
                </form>
            </div>

            <!-- Active filter chips -->
            @if (hasActiveFilters)
            {
                <div class="flex flex-wrap items-center gap-2 mb-5">
                    <span class="text-[9px] font-black uppercase tracking-widest text-gray-400">Đang lọc:</span>
                    @if (!string.IsNullOrEmpty(Model.SearchQuery))
                    {
                        <a href="/Shop?Category=@(Model.Category ?? "all")&SortBy=@(Model.SortBy ?? "newest")"
                           class="inline-flex items-center gap-1 bg-gray-900 text-white text-[9px] font-bold px-2.5 py-1 uppercase tracking-wide hover:bg-black transition-colors">
                            "@Model.SearchQuery" <i data-lucide="x" class="w-2.5 h-2.5"></i>
                        </a>
                    }
                    @if (Model.Category != null && Model.Category != "all")
                    {
                        <a href="/Shop?SearchQuery=@(Model.SearchQuery)&SortBy=@(Model.SortBy ?? "newest")"
                           class="inline-flex items-center gap-1 bg-gray-900 text-white text-[9px] font-bold px-2.5 py-1 uppercase tracking-wide hover:bg-black transition-colors">
                            @Model.Category <i data-lucide="x" class="w-2.5 h-2.5"></i>
                        </a>
                    }
                    @if (Model.MaxPrice.HasValue)
                    {
                        <a href="/Shop?SearchQuery=@(Model.SearchQuery)&Category=@(Model.Category ?? "all")&SortBy=@(Model.SortBy ?? "newest")"
                           class="inline-flex items-center gap-1 bg-gray-900 text-white text-[9px] font-bold px-2.5 py-1 uppercase tracking-wide hover:bg-black transition-colors">
                            ≤ @Model.MaxPrice.Value.ToString("N0")₫ <i data-lucide="x" class="w-2.5 h-2.5"></i>
                        </a>
                    }
                </div>
            }

            <!-- Product Grid -->
            @if (Model.Products.Any())
            {
                <div class="grid grid-cols-2 md:grid-cols-3 gap-x-4 gap-y-12">
                    @foreach (var p in Model.Products)
                    {
                        @await Html.PartialAsync("_ProductCard", p)
                    }
                </div>

                @await Html.PartialAsync("_Pagination", new Web.Models.PaginationModel {
                    CurrentPage = Model.Page,
                    TotalPages  = Model.TotalPages,
                    BaseUrl     = shopBaseUrl,
                    PageParam   = "Page"
                })
            }
            else
            {
                <div class="py-24 text-center border-2 border-dashed border-gray-200">
                    <div class="w-16 h-16 border border-gray-200 flex items-center justify-center mx-auto mb-5">
                        <i data-lucide="package-open" class="w-7 h-7 text-gray-300"></i>
                    </div>
                    <h3 class="text-sm font-black uppercase tracking-widest text-gray-900 mb-2">Không tìm thấy sản phẩm</h3>
                    <p class="text-xs text-gray-400 mb-6 max-w-xs mx-auto">Thử lại với tiêu chí khác.</p>
                    <a href="/Shop" class="inline-block bg-black text-white px-8 py-3 text-xs font-bold tracking-widest uppercase hover:bg-gray-800 transition-colors">
                        Xoá bộ lọc
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/product-card.js" asp-append-version="true"></script>
    <script>
    function toggleSizeFilter(btn, size) {
        btn.classList.toggle('active');
        // Could extend to filter client-side or add to form
    }
    </script>
}
