@page
@model Web.Pages.Customer.ProfileModel
@{
    ViewData["Title"] = "Tài khoản — The Old Pavement";
}

<main class="max-w-[1400px] mx-auto px-4 md:px-8 lg:px-16 py-12 pb-20 min-h-[70vh]">

    <!-- Header -->
    <div class="border-b border-gray-100 pb-6 mb-10">
        <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-400 mb-1">The Old Pavement</p>
        <h1 class="text-3xl md:text-4xl font-black uppercase tracking-tight">Tài khoản của tôi</h1>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="flex items-center gap-3 bg-emerald-50 border border-emerald-200 px-4 py-3 mb-8 text-sm text-emerald-800 font-medium">
            <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600 flex-shrink-0"></i>
            @Model.SuccessMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="flex items-center gap-3 bg-red-50 border border-red-200 px-4 py-3 mb-8 text-sm text-red-700 font-medium">
            <i data-lucide="alert-circle" class="w-4 h-4 text-red-500 flex-shrink-0"></i>
            @Model.ErrorMessage
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">

        <!-- Profile info -->
        <div class="border border-gray-100 bg-white">
            <div class="flex items-center gap-3 px-6 py-4 border-b border-gray-100">
                <i data-lucide="user" class="w-4 h-4 text-gray-500"></i>
                <h2 class="text-xs font-black uppercase tracking-[0.18em]">Thông tin cá nhân</h2>
            </div>
            <form method="post" asp-page-handler="UpdateProfile" class="p-6 space-y-4">
                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Email</label>
                    <input type="email" value="@Model.Email" disabled
                           class="w-full border border-gray-100 bg-gray-50 px-4 py-3 text-sm text-gray-400 cursor-not-allowed" />
                    <p class="text-[10px] text-gray-400 mt-1">Email không thể thay đổi.</p>
                </div>
                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Họ và tên</label>
                    <input type="text" asp-for="UserProfile.FullName" placeholder="Nhập họ và tên"
                           class="w-full border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-black transition-colors" />
                </div>
                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Số điện thoại</label>
                    <input type="tel" asp-for="UserProfile.PhoneNumber" placeholder="Nhập số điện thoại"
                           class="w-full border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-black transition-colors" />
                </div>
                <button type="submit"
                        class="w-full bg-black text-white py-3 text-xs font-black tracking-[0.18em] uppercase hover:bg-gray-800 transition-colors">
                    Cập nhật thông tin
                </button>
            </form>
        </div>

        <!-- Change password -->
        <div class="border border-gray-100 bg-white">
            <div class="flex items-center gap-3 px-6 py-4 border-b border-gray-100">
                <i data-lucide="lock" class="w-4 h-4 text-gray-500"></i>
                <h2 class="text-xs font-black uppercase tracking-[0.18em]">Đổi mật khẩu</h2>
            </div>
            <form method="post" asp-page-handler="ChangePassword" class="p-6 space-y-4">
                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Mật khẩu hiện tại</label>
                    <input type="password" asp-for="PasswordModel.OldPassword" placeholder="••••••••"
                           class="w-full border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-black transition-colors" />
                </div>
                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Mật khẩu mới</label>
                    <input type="password" asp-for="PasswordModel.NewPassword" placeholder="••••••••"
                           class="w-full border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-black transition-colors" />
                </div>
                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-gray-500 mb-1.5">Xác nhận mật khẩu mới</label>
                    <input type="password" asp-for="PasswordModel.ConfirmPassword" placeholder="••••••••"
                           class="w-full border border-gray-200 bg-white px-4 py-3 text-sm outline-none focus:border-black transition-colors" />
                </div>
                <button type="submit"
                        class="w-full bg-black text-white py-3 text-xs font-black tracking-[0.18em] uppercase hover:bg-gray-800 transition-colors">
                    Đổi mật khẩu
                </button>
            </form>
        </div>
    </div>

    <!-- Quick links -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/Customer/Orders" class="group flex items-center gap-4 border border-gray-100 bg-white p-5 hover:border-black transition-colors">
            <div class="w-10 h-10 bg-gray-50 border border-gray-100 flex items-center justify-center flex-shrink-0 group-hover:bg-black group-hover:text-white group-hover:border-black transition-all">
                <i data-lucide="package" class="w-4 h-4"></i>
            </div>
            <div>
                <p class="text-xs font-black uppercase tracking-widest">Đơn hàng của tôi</p>
                <p class="text-[10px] text-gray-400 mt-0.5">Xem lịch sử mua sắm</p>
            </div>
            <i data-lucide="arrow-right" class="w-4 h-4 text-gray-300 ml-auto group-hover:text-black transition-colors"></i>
        </a>
        <a href="/Wishlist" class="group flex items-center gap-4 border border-gray-100 bg-white p-5 hover:border-black transition-colors">
            <div class="w-10 h-10 bg-gray-50 border border-gray-100 flex items-center justify-center flex-shrink-0 group-hover:bg-black group-hover:text-white group-hover:border-black transition-all">
                <i data-lucide="heart" class="w-4 h-4"></i>
            </div>
            <div>
                <p class="text-xs font-black uppercase tracking-widest">Yêu thích</p>
                <p class="text-[10px] text-gray-400 mt-0.5">Sản phẩm đã lưu</p>
            </div>
            <i data-lucide="arrow-right" class="w-4 h-4 text-gray-300 ml-auto group-hover:text-black transition-colors"></i>
        </a>
        <a href="/Shop" class="group flex items-center gap-4 border border-gray-100 bg-white p-5 hover:border-black transition-colors">
            <div class="w-10 h-10 bg-gray-50 border border-gray-100 flex items-center justify-center flex-shrink-0 group-hover:bg-black group-hover:text-white group-hover:border-black transition-all">
                <i data-lucide="shopping-bag" class="w-4 h-4"></i>
            </div>
            <div>
                <p class="text-xs font-black uppercase tracking-widest">Tiếp tục mua sắm</p>
                <p class="text-[10px] text-gray-400 mt-0.5">Khám phá bộ sưu tập</p>
            </div>
            <i data-lucide="arrow-right" class="w-4 h-4 text-gray-300 ml-auto group-hover:text-black transition-colors"></i>
        </a>
    </div>
</main>
