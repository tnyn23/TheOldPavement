@page
@model Web.Pages.Customer.ProfileModel
@{
    ViewData["Title"] = "Tài khoản của tôi - The Old Pavement";
}

<main class="pt-8 px-4 md:px-8 lg:px-16 max-w-[1400px] mx-auto pb-16 min-h-[70vh]">
    <div class="border-b border-gray-200 pb-6 mb-10">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight uppercase">TÀI KHOẢN CỦA TÔI</h1>
        <p class="text-gray-500 mt-2">Quản lý thông tin cá nhân và bảo mật tài khoản.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="bg-emerald-50 border border-emerald-300 text-emerald-800 px-6 py-4 mb-8 text-sm font-medium flex items-center gap-3 rounded-lg">
            <i data-lucide="check-circle" class="w-5 h-5 stroke-[1.5]"></i>
            @Model.SuccessMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-300 text-red-800 px-6 py-4 mb-8 text-sm font-medium flex items-center gap-3 rounded-lg">
            <i data-lucide="alert-circle" class="w-5 h-5 stroke-[1.5]"></i>
            @Model.ErrorMessage
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- Profile Information Card -->
        <div class="border border-gray-200 bg-white rounded-lg overflow-hidden">
            <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                <h2 class="font-bold text-lg uppercase tracking-wider flex items-center gap-2">
                    <i data-lucide="user" class="w-5 h-5 stroke-[1.5]"></i>
                    Thông tin cá nhân
                </h2>
            </div>
            <form method="post" asp-page-handler="UpdateProfile" class="p-6 space-y-5">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Email</label>
                    <input type="email" value="@Model.Email" disabled
                           class="w-full border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-500 rounded cursor-not-allowed" />
                    <p class="text-xs text-gray-400 mt-1">Email không thể thay đổi.</p>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Họ và tên</label>
                    <input type="text" asp-for="UserProfile.FullName" placeholder="Nhập họ và tên"
                           class="w-full border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent rounded transition-all" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Số điện thoại</label>
                    <input type="tel" asp-for="UserProfile.PhoneNumber" placeholder="Nhập số điện thoại"
                           class="w-full border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent rounded transition-all" />
                </div>
                <button type="submit"
                        class="w-full bg-black text-white py-3.5 text-sm font-bold tracking-wider uppercase hover:bg-gray-800 transition-colors rounded">
                    Cập nhật thông tin
                </button>
            </form>
        </div>

        <!-- Change Password Card -->
        <div class="border border-gray-200 bg-white rounded-lg overflow-hidden">
            <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                <h2 class="font-bold text-lg uppercase tracking-wider flex items-center gap-2">
                    <i data-lucide="lock" class="w-5 h-5 stroke-[1.5]"></i>
                    Đổi mật khẩu
                </h2>
            </div>
            <form method="post" asp-page-handler="ChangePassword" class="p-6 space-y-5">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Mật khẩu hiện tại</label>
                    <input type="password" asp-for="PasswordModel.OldPassword" placeholder="Nhập mật khẩu hiện tại"
                           class="w-full border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent rounded transition-all" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Mật khẩu mới</label>
                    <input type="password" asp-for="PasswordModel.NewPassword" placeholder="Nhập mật khẩu mới"
                           class="w-full border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent rounded transition-all" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Xác nhận mật khẩu mới</label>
                    <input type="password" asp-for="PasswordModel.ConfirmPassword" placeholder="Nhập lại mật khẩu mới"
                           class="w-full border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent rounded transition-all" />
                </div>
                <button type="submit"
                        class="w-full bg-black text-white py-3.5 text-sm font-bold tracking-wider uppercase hover:bg-gray-800 transition-colors rounded">
                    Đổi mật khẩu
                </button>
            </form>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/Customer/Orders" class="border border-gray-200 bg-white rounded-lg p-6 hover:shadow-md transition-all group">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-gray-50 border border-gray-100 flex items-center justify-center rounded-lg group-hover:bg-black group-hover:text-white transition-colors">
                    <i data-lucide="package" class="w-5 h-5 stroke-[1.5]"></i>
                </div>
                <div>
                    <h3 class="font-bold text-sm uppercase tracking-wide">Đơn hàng của tôi</h3>
                    <p class="text-xs text-gray-500 mt-0.5">Xem lịch sử mua sắm</p>
                </div>
            </div>
        </a>
        <a href="/Wishlist" class="border border-gray-200 bg-white rounded-lg p-6 hover:shadow-md transition-all group">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-gray-50 border border-gray-100 flex items-center justify-center rounded-lg group-hover:bg-black group-hover:text-white transition-colors">
                    <i data-lucide="heart" class="w-5 h-5 stroke-[1.5]"></i>
                </div>
                <div>
                    <h3 class="font-bold text-sm uppercase tracking-wide">Danh sách yêu thích</h3>
                    <p class="text-xs text-gray-500 mt-0.5">Sản phẩm bạn đã lưu</p>
                </div>
            </div>
        </a>
        <a href="/" class="border border-gray-200 bg-white rounded-lg p-6 hover:shadow-md transition-all group">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-gray-50 border border-gray-100 flex items-center justify-center rounded-lg group-hover:bg-black group-hover:text-white transition-colors">
                    <i data-lucide="shopping-bag" class="w-5 h-5 stroke-[1.5]"></i>
                </div>
                <div>
                    <h3 class="font-bold text-sm uppercase tracking-wide">Tiếp tục mua sắm</h3>
                    <p class="text-xs text-gray-500 mt-0.5">Khám phá bộ sưu tập mới</p>
                </div>
            </div>
        </a>
    </div>
</main>
