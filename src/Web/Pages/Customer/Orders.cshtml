@page
@model Web.Pages.Customer.OrdersModel
@{
    ViewData["Title"] = "Đơn hàng — The Old Pavement";
}

<main class="max-w-[1400px] mx-auto px-4 md:px-8 lg:px-16 py-12 pb-20 min-h-[70vh]">

    <!-- Header -->
    <div class="border-b border-gray-100 pb-6 mb-10 flex items-end justify-between">
        <div>
            <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-400 mb-1">The Old Pavement</p>
            <h1 class="text-3xl md:text-4xl font-black uppercase tracking-tight">Đơn hàng của tôi</h1>
        </div>
        <a href="/Shop" class="hidden sm:flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-gray-400 hover:text-black transition-colors">
            <i data-lucide="shopping-bag" class="w-3.5 h-3.5"></i>
            Tiếp tục mua sắm
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="flex items-center gap-3 bg-emerald-50 border border-emerald-200 px-4 py-3 mb-8 text-sm text-emerald-800 font-medium">
            <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600 flex-shrink-0"></i>
            @Model.SuccessMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="flex items-center gap-3 bg-red-50 border border-red-200 px-4 py-3 mb-8 text-sm text-red-700 font-medium">
            <i data-lucide="alert-circle" class="w-4 h-4 text-red-500 flex-shrink-0"></i>
            @Model.ErrorMessage
        </div>
    }

    @if (!Model.Orders.Any())
    {
        <div class="flex flex-col items-center justify-center py-24 text-center">
            <div class="w-20 h-20 border-2 border-dashed border-gray-200 flex items-center justify-center mb-6">
                <i data-lucide="package" class="w-8 h-8 text-gray-300"></i>
            </div>
            <h2 class="text-xl font-black uppercase tracking-tight mb-2">Chưa có đơn hàng nào</h2>
            <p class="text-sm text-gray-500 mb-8 max-w-xs">Hãy khám phá bộ sưu tập và bắt đầu hành trình phong cách của bạn.</p>
            <a href="/Shop" class="inline-flex items-center gap-2 bg-black text-white px-8 py-3 text-xs font-bold tracking-widest uppercase hover:bg-gray-800 transition-colors">
                Mua sắm ngay
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
        </div>
    }
    else
    {
        <div class="space-y-5">
            @foreach (var order in Model.Orders)
            {
                var status = order.Status?.ToLower() ?? "pending";
                var (statusBg, statusText, statusLabel) = status switch {
                    "delivered"  => ("bg-emerald-50 text-emerald-700 border-emerald-200", "text-emerald-700", "Đã giao"),
                    "shipped"    => ("bg-blue-50 text-blue-700 border-blue-200",           "text-blue-700",    "Đang giao"),
                    "cancelled"  => ("bg-red-50 text-red-700 border-red-200",              "text-red-700",     "Đã hủy"),
                    "processing" => ("bg-gray-100 text-gray-700 border-gray-200",          "text-gray-700",    "Đang xử lý"),
                    _            => ("bg-amber-50 text-amber-700 border-amber-200",        "text-amber-700",   "Chờ xử lý")
                };

                <div class="border border-gray-100 bg-white overflow-hidden">
                    <!-- Order header -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-5 py-4 bg-gray-50 border-b border-gray-100">
                        <div class="flex flex-wrap items-center gap-x-6 gap-y-1.5">
                            <div>
                                <p class="text-[9px] font-black uppercase tracking-widest text-gray-400">Mã đơn</p>
                                <p class="text-xs font-black text-gray-900 font-mono">@order.OrderNumber</p>
                            </div>
                            <div>
                                <p class="text-[9px] font-black uppercase tracking-widest text-gray-400">Ngày đặt</p>
                                <p class="text-xs font-semibold text-gray-700">@(order.CreatedAt?.ToString("dd/MM/yyyy") ?? "—")</p>
                            </div>
                            <div>
                                <p class="text-[9px] font-black uppercase tracking-widest text-gray-400">Thanh toán</p>
                                <p class="text-xs font-semibold text-gray-700 uppercase">@order.PaymentMethod</p>
                            </div>
                        </div>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 border text-[10px] font-black uppercase tracking-widest @statusBg">
                            @statusLabel
                        </span>
                    </div>

                    <!-- Timeline -->
                    @if (status != "cancelled")
                    {
                        var steps = new[] { "pending", "shipped", "delivered" };
                        var stepLabels = new[] { "Đặt hàng", "Đang giao", "Hoàn thành" };
                        var stepIcons = new[] { "package", "truck", "check-circle" };
                        var currentStep = Array.IndexOf(steps, status);
                        if (currentStep < 0) currentStep = 0;

                        <div class="px-5 py-5 border-b border-gray-50">
                            <div class="relative flex items-start max-w-sm">
                                <div class="absolute left-4 right-4 top-4 h-px bg-gray-200"></div>
                                <div class="absolute left-4 top-4 h-px bg-black transition-all duration-700"
                                     style="width: calc(@currentStep * ((100% - 2rem) / @(steps.Length - 1)))"></div>
                                @for (int i = 0; i < steps.Length; i++)
                                {
                                    var done = i < currentStep;
                                    var curr = i == currentStep;
                                    <div class="flex-1 flex flex-col items-center relative z-10">
                                        <div class="w-8 h-8 flex items-center justify-center flex-shrink-0 transition-all
                                                    @(done || curr ? "bg-black text-white" : "bg-white border-2 border-gray-200 text-gray-400")
                                                    @(curr ? "ring-4 ring-gray-100" : "")">
                                            <i data-lucide="@stepIcons[i]" class="w-3.5 h-3.5"></i>
                                        </div>
                                        <span class="mt-2 text-[9px] font-black uppercase tracking-wider text-center @(done || curr ? "text-gray-900" : "text-gray-400")">
                                            @stepLabels[i]
                                        </span>
                                        @if (curr)
                                        {
                                            <span class="text-[8px] font-bold text-black uppercase tracking-wide mt-0.5">● Hiện tại</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="px-5 py-3 border-b border-gray-50">
                            <div class="flex items-center gap-2 text-xs text-red-600 font-bold uppercase tracking-wide">
                                <i data-lucide="ban" class="w-3.5 h-3.5"></i>
                                Đơn hàng đã bị hủy — Tồn kho đã được hoàn lại.
                            </div>
                        </div>
                    }

                    <!-- Items -->
                    <div class="divide-y divide-gray-50 px-5">
                        @foreach (var item in order.OrderItems)
                        {
                            <div class="flex items-center justify-between gap-4 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-12 h-12 bg-gray-50 border border-gray-100 flex items-center justify-center flex-shrink-0 text-lg">
                                        👕
                                    </div>
                                    <div>
                                        <p class="text-xs font-bold uppercase tracking-wide text-gray-900">@item.ProductName</p>
                                        <p class="text-[10px] text-gray-400 mt-0.5 uppercase">@item.Size · @item.Color · ×@item.Quantity</p>
                                    </div>
                                </div>
                                <div class="text-right flex-shrink-0">
                                    <p class="text-sm font-black tabular-nums">@item.Subtotal.ToString("N0")₫</p>
                                    <p class="text-[10px] text-gray-400 tabular-nums">@item.UnitPrice.ToString("N0")₫/cái</p>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Footer -->
                    <div class="flex items-center justify-between px-5 py-4 bg-gray-50 border-t border-gray-100">
                        <div>
                            @if (status == "pending")
                            {
                                <form method="post" asp-page-handler="CancelOrder"
                                      onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này?')">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <button type="submit"
                                            class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-red-600 border border-red-200 px-4 py-2 hover:bg-red-50 transition-colors">
                                        <i data-lucide="x" class="w-3.5 h-3.5"></i>
                                        Hủy đơn
                                    </button>
                                </form>
                            }
                        </div>
                        <div class="text-right">
                            <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Tổng cộng</p>
                            <p class="text-xl font-black tabular-nums">@order.TotalAmount.ToString("N0")₫</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</main>
