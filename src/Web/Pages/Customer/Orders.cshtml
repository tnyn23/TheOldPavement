@page
@model Web.Pages.Customer.OrdersModel
@{
    ViewData["Title"] = "Đơn hàng của tôi - The Old Pavement";
}

<main class="pt-8 px-4 md:px-8 lg:px-16 max-w-[1400px] mx-auto pb-16 min-h-[70vh]">
    <div class="border-b border-gray-200 pb-6 mb-10">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight uppercase">ĐƠN HÀNG CỦA TÔI</h1>
        <p class="text-gray-500 mt-2">Xem lịch sử mua sắm và theo dõi trạng thái đơn hàng của bạn.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="bg-emerald-50 border border-emerald-300 text-emerald-800 px-6 py-4 mb-8 text-sm font-medium flex items-center gap-3 rounded-lg">
            <i data-lucide="check-circle" class="w-5 h-5 stroke-[1.5]"></i>
            @Model.SuccessMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-300 text-red-800 px-6 py-4 mb-8 text-sm font-medium flex items-center gap-3 rounded-lg">
            <i data-lucide="alert-circle" class="w-5 h-5 stroke-[1.5]"></i>
            @Model.ErrorMessage
        </div>
    }

    @if (!Model.Orders.Any())
    {
        <div class="text-center py-20 border border-dashed border-gray-300 bg-gray-50 max-w-2xl mx-auto rounded-lg">
            <i data-lucide="package" class="w-16 h-16 mx-auto text-gray-300 mb-6 stroke-1"></i>
            <h2 class="text-2xl font-semibold mb-2">Bạn chưa có đơn hàng nào</h2>
            <p class="text-gray-500 max-w-md mx-auto mb-8 text-sm">Hãy sắm ngay những chiếc áo thun phong cách để bắt đầu hành trình phong cách của riêng bạn.</p>
            <a href="/" class="inline-block bg-black text-white px-8 py-3.5 text-sm font-semibold tracking-wider hover:bg-gray-800 transition-colors uppercase">
                Mua sắm ngay
            </a>
        </div>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var order in Model.Orders)
            {
                var status = order.Status?.ToLower() ?? "pending";
                <div class="border border-gray-200 bg-white hover:shadow-md transition-shadow duration-200 rounded-lg overflow-hidden">
                    <!-- Order Header -->
                    <div class="bg-gray-50 px-6 py-4 border-b border-gray-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
                            <div>
                                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Mã đơn hàng</span>
                                <span class="font-bold text-gray-900">@order.OrderNumber</span>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Ngày đặt hàng</span>
                                <span class="font-medium text-gray-800">@(order.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? DateTime.Now.ToString("dd/MM/yyyy"))</span>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Phương thức</span>
                                <span class="font-medium text-gray-800 uppercase text-sm">@order.PaymentMethod</span>
                            </div>
                            <div>
                                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Thanh toán</span>
                                @if (order.PaymentStatus?.ToLower() == "paid")
                                {
                                    <span class="text-xs bg-emerald-50 text-emerald-700 px-2.5 py-1 font-bold border border-emerald-300 rounded uppercase">Đã thanh toán</span>
                                }
                                else
                                {
                                    <span class="text-xs bg-amber-50 text-amber-700 px-2.5 py-1 font-bold border border-amber-300 rounded uppercase">Chờ xử lý</span>
                                }
                            </div>
                        </div>

                        <div class="flex items-center gap-4">
                            <!-- Status Badge -->
                            <div>
                                @if (status == "delivered")
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 uppercase tracking-wide">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                        Đã giao hàng
                                    </span>
                                }
                                else if (status == "shipped")
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800 uppercase tracking-wide">
                                        <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                                        Đang vận chuyển
                                    </span>
                                }
                                else if (status == "cancelled")
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-red-100 text-red-800 uppercase tracking-wide">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
                                        Đã hủy
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 uppercase tracking-wide">
                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
                                        Đang xử lý
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Order Timeline -->
                    <div class="px-6 py-4 border-b border-gray-100">
                        <div class="flex items-center justify-between max-w-lg">
                            @{
                                var steps = new[] { "pending", "shipped", "delivered" };
                                var stepLabels = new[] { "Đặt hàng", "Vận chuyển", "Giao hàng" };
                                var stepIcons = new[] { "package", "truck", "check-circle" };
                                var currentStepIndex = status == "cancelled" ? -1 : Array.IndexOf(steps, status);
                            }
                            @for (int i = 0; i < steps.Length; i++)
                            {
                                var isActive = i <= currentStepIndex && status != "cancelled";
                                var isCurrent = i == currentStepIndex && status != "cancelled";
                                <div class="flex flex-col items-center text-center flex-1">
                                    <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold @(isActive ? "bg-black text-white" : "bg-gray-200 text-gray-400") @(status == "cancelled" ? "bg-red-100 text-red-400" : "")">
                                        <i data-lucide="@stepIcons[i]" class="w-4 h-4 stroke-[1.5]"></i>
                                    </div>
                                    <span class="text-[10px] font-semibold mt-1.5 uppercase tracking-wider @(isActive ? "text-gray-900" : "text-gray-400") @(status == "cancelled" ? "text-red-400" : "")">@stepLabels[i]</span>
                                </div>
                                @if (i < steps.Length - 1)
                                {
                                    <div class="flex-1 h-0.5 mt-[-12px] @(i < currentStepIndex && status != "cancelled" ? "bg-black" : "bg-gray-200")"></div>
                                }
                            }
                        </div>
                        @if (status == "cancelled")
                        {
                            <p class="text-xs text-red-500 mt-2 font-medium">Đơn hàng này đã bị hủy. Tồn kho đã được hoàn lại.</p>
                        }
                    </div>

                    <!-- Order Items -->
                    <div class="px-6 py-4 divide-y divide-gray-100">
                        @foreach (var item in order.OrderItems)
                        {
                            <div class="py-4 flex items-center justify-between gap-6">
                                <div class="flex items-center gap-4">
                                    <div class="w-14 h-14 bg-gray-50 border border-gray-100 flex-shrink-0 flex items-center justify-center font-bold">
                                        👕
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-gray-900 leading-tight">@item.ProductName</h4>
                                        <p class="text-xs text-gray-500 mt-1">
                                            Kích thước: <span class="font-semibold text-gray-700">@item.Size</span> |
                                            Màu sắc: <span class="font-semibold text-gray-700">@item.Color</span> |
                                            Số lượng: <span class="font-semibold text-gray-700">@item.Quantity</span>
                                        </p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="font-bold text-gray-900">@item.Subtotal.ToString("N0")₫</p>
                                    <p class="text-xs text-gray-400 mt-0.5">@item.UnitPrice.ToString("N0")₫ / cái</p>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Order Footer -->
                    <div class="bg-gray-50/50 px-6 py-4 border-t border-gray-100 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            @if (status == "pending")
                            {
                                <form method="post" asp-page-handler="CancelOrder" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?');">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <button type="submit"
                                            class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold border border-red-300 text-red-700 bg-red-50 hover:bg-red-100 rounded transition-colors uppercase tracking-wider">
                                        <i data-lucide="x-circle" class="w-3.5 h-3.5 stroke-[1.5]"></i>
                                        Hủy đơn hàng
                                    </button>
                                </form>
                            }
                            @if (!string.IsNullOrEmpty(order.Note))
                            {
                                <span class="text-sm text-gray-500 font-medium italic">Ghi chú: "@order.Note"</span>
                            }
                        </div>
                        <div class="text-right flex items-center gap-2">
                            <span class="font-semibold text-gray-600">Tổng cộng:</span>
                            <span class="text-2xl font-extrabold text-gray-950">@order.TotalAmount.ToString("N0")₫</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</main>
