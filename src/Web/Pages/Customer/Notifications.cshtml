@page
@model Web.Pages.Customer.NotificationsModel
@{
    ViewData["Title"] = "Thông báo của tôi";
}

<div class="max-w-4xl mx-auto px-4 md:px-8 py-10 mt-10">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-2xl font-black uppercase tracking-widest text-[#3E503C]">Thông báo của tôi</h1>
        @if (Model.Notifications.Any(n => n.IsRead != true))
        {
            <form method="post" asp-page-handler="MarkAllAsRead">
                <button type="submit" class="text-xs font-bold uppercase tracking-wider underline text-[#7F886A] hover:text-[#3E503C] transition-colors">
                    Đánh dấu đã đọc tất cả
                </button>
            </form>
        }
    </div>

    @if (!Model.Notifications.Any())
    {
        <div class="text-center py-16 bg-[#faf7f2] border border-[#3E503C]/10 rounded-lg">
            <i data-lucide="bell-off" class="w-12 h-12 mx-auto text-[#7F886A] mb-4 opacity-50"></i>
            <p class="text-sm text-[#7F886A]">Bạn chưa có thông báo nào.</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var notification in Model.Notifications)
            {
                <a href="@(notification.Link ?? "#")" class="block p-5 rounded-lg border transition-all duration-300 @(notification.IsRead == true ? "bg-white border-[#3E503C]/10 opacity-70" : "bg-[#faf7f2] border-[#3E503C]/30 shadow-sm") hover:-translate-y-0.5 hover:shadow-md">
                    <div class="flex gap-4">
                        <div class="flex-shrink-0 pt-1">
                            @if (notification.Type == "order_update")
                            {
                                <div class="w-10 h-10 rounded-full flex items-center justify-center bg-[#3E503C]/10 text-[#3E503C]">
                                    <i data-lucide="package" class="w-5 h-5"></i>
                                </div>
                            }
                            else if (notification.Type == "promotion")
                            {
                                <div class="w-10 h-10 rounded-full flex items-center justify-center bg-[#FF6F3D]/10 text-[#FF6F3D]">
                                    <i data-lucide="tag" class="w-5 h-5"></i>
                                </div>
                            }
                            else
                            {
                                <div class="w-10 h-10 rounded-full flex items-center justify-center bg-[#7F886A]/10 text-[#7F886A]">
                                    <i data-lucide="bell" class="w-5 h-5"></i>
                                </div>
                            }
                        </div>
                        <div class="flex-1">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <h3 class="text-sm font-bold text-[#1a1f19] mb-1">
                                        @notification.Title
                                        @if (notification.IsRead != true)
                                        {
                                            <span class="inline-block w-2 h-2 rounded-full bg-[#FF6F3D] ml-2"></span>
                                        }
                                    </h3>
                                    <p class="text-sm text-[#3E503C]/80 leading-relaxed">@notification.Message</p>
                                </div>
                                <span class="text-[10px] font-bold text-[#7F886A] uppercase tracking-wider whitespace-nowrap">
                                    @notification.CreatedAt?.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>
