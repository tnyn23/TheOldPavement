@using System.Linq
@model Domain.Models.Product

@functions {
    // Returns URL with specified width/quality (Unsplash-aware)
    static string OptimizeImageUrl(string? url, int width = 400, int quality = 70)
    {
        if (string.IsNullOrWhiteSpace(url)) return "";
        if (url.Contains("unsplash.com"))
        {
            var uri = url.Split('?')[0];
            return $"{uri}?auto=format&fit=crop&w={width}&q={quality}";
        }
        return url;
    }

    // Returns srcset string for Unsplash images
    static string? BuildSrcset(string? url)
    {
        if (string.IsNullOrWhiteSpace(url) || !url.Contains("unsplash.com")) return null;
        var base_ = url.Split('?')[0];
        return $"{base_}?auto=format&fit=crop&w=300&q=70 300w, "
             + $"{base_}?auto=format&fit=crop&w=400&q=70 400w, "
             + $"{base_}?auto=format&fit=crop&w=600&q=65 600w";
    }
}

@{
    var firstImg = OptimizeImageUrl(Model.ProductImages?.ElementAtOrDefault(0)?.ImageUrl);
    var mainImage = (!string.IsNullOrWhiteSpace(firstImg))
        ? firstImg
        : "https://images.unsplash.com/photo-1521334884684-d80222895322?auto=format&fit=crop&w=400&q=70";

    var secondImg = OptimizeImageUrl(Model.ProductImages?.ElementAtOrDefault(1)?.ImageUrl);
    var hoverImage = (!string.IsNullOrWhiteSpace(secondImg))
        ? secondImg
        : mainImage;

    var isSale       = Model.IsOnSale == true || (Model.DiscountPercentage.GetValueOrDefault() > 0);
    var isNew        = (DateTime.Now - Model.CreatedAt.GetValueOrDefault(DateTime.Now)).TotalDays < 14;
    var isCollab     = Model.IsCollab == true;
    var discountPct  = Model.DiscountPercentage.GetValueOrDefault(0);
    var hasOriginal  = isSale && Model.OriginalPrice.GetValueOrDefault() > 0;

    // Determine primary badge priority: Sale > Collab > New
    string? primaryBadgeText   = isSale ? $"-{discountPct}%" : isCollab ? "COLLAB" : isNew ? "NEW IN" : null;
    string  primaryBadgeStyle  = isSale   ? "bg-[#D0151C] text-white"
                               : isCollab ? "bg-black text-white border border-white/20"
                               : isNew    ? "bg-gray-900 text-white"
                               : "";
}

<article class="product-card-card product-card-clickable group" data-product-url="/Product/@Model.Slug" tabindex="0">
    <div class="product-card-media">
        @{
            var mainSrcset  = BuildSrcset(Model.ProductImages?.ElementAtOrDefault(0)?.ImageUrl);
            var hoverSrcset = BuildSrcset(Model.ProductImages?.ElementAtOrDefault(1)?.ImageUrl);
        }
        <img src="@mainImage"
             @(mainSrcset != null ? $"srcset=\"{mainSrcset}\" sizes=\"(max-width:640px) 50vw, 25vw\"" : "")
             alt="@Model.Name"
             class="product-card-image product-card-image-main"
             loading="lazy"
             decoding="async"
             width="400" height="500" />
        <img src="@hoverImage"
             @(hoverSrcset != null ? $"srcset=\"{hoverSrcset}\" sizes=\"(max-width:640px) 50vw, 25vw\"" : "")
             alt="@Model.Name alternate view"
             class="product-card-image product-card-image-back"
             loading="lazy"
             decoding="async"
             width="400" height="500" />

        <!-- Premium Badges Stack -->
        <div class="product-card-badges">
            @if (primaryBadgeText != null)
            {
                <span class="product-card-badge @primaryBadgeStyle font-black tracking-widest text-[9px] uppercase px-2 py-0.5">
                    @primaryBadgeText
                </span>
            }
            @if (isSale && isCollab)
            {
                <!-- Secondary collab badge when also on sale -->
                <span class="product-card-badge bg-black text-white font-black tracking-widest text-[9px] uppercase px-2 py-0.5">
                    COLLAB
                </span>
            }
            @if (isSale && isNew)
            {
                <span class="product-card-badge bg-gray-800 text-white font-black tracking-widest text-[9px] uppercase px-2 py-0.5">
                    NEW
                </span>
            }
        </div>

        <!-- Hover Overlay -->
        <div class="product-card-overlay">
            <div class="overlay-copy">
                <span class="overlay-label">Xem nhanh</span>
                <strong class="overlay-title">Thêm vào giỏ</strong>
            </div>
            <form method="post" asp-page="/Product/Detail" asp-page-handler="AddToCart" asp-route-slug="@Model.Slug" class="card-action-button">
                <button type="submit" class="overlay-button" aria-label="Thêm @Model.Name vào giỏ">
                    Thêm vào giỏ
                </button>
            </form>
        </div>
    </div>

    <div class="product-card-body">
        <div class="product-card-intro">
            <span class="product-card-tag">@Model.Category</span>
            <h3 class="product-card-title">@Model.Name</h3>
        </div>

        <div class="product-card-footer">
            <div class="product-card-price-group">
                <span class="product-card-price @(isSale ? "text-[#D0151C]" : "")">@Model.Price.ToString("N0")₫</span>
                @if (hasOriginal)
                {
                    <span class="product-card-original line-through text-gray-400">@Model.OriginalPrice?.ToString("N0")₫</span>
                }
            </div>
            @if (isCollab)
            {
                <span class="text-[9px] font-black tracking-widest text-gray-400 uppercase">LIMITED EDITION</span>
            }
            else
            {
                <span class="product-card-meta">Minimal streetwear silhouette</span>
            }
        </div>
    </div>
</article>
