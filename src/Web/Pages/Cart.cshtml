@page
@model Web.Pages.CartModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<main class="pt-24 px-4 md:px-8 lg:px-16 max-w-[1400px] mx-auto pb-16 min-h-[70vh]">
    <h1 class="text-4xl md:text-5xl mb-8 tracking-tight font-light">GIỎ HÀNG CỦA BẠN</h1>

    @if (Model.CartItems.Count == 0)
    {
        <div class="text-center py-20">
            <i data-lucide="shopping-bag" class="w-24 h-24 mx-auto mb-6 text-gray-300"></i>
            <h2 class="text-3xl mb-4 font-light">GIỎ HÀNG TRỐNG</h2>
            <p class="text-gray-600 mb-8">Chưa có sản phẩm nào trong giỏ hàng của bạn.</p>
            <a href="/" class="inline-flex items-center gap-2 bg-black text-white px-8 py-3 font-semibold hover:bg-gray-800 transition-colors">
                TIẾP TỤC MUA SẮM
                <i data-lucide="arrow-right" class="w-5 h-5"></i>
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            <!-- Cart Items -->
            <div class="lg:col-span-2 space-y-6">
                @foreach (var item in Model.CartItems)
                {
                    <div class="flex gap-6 border-b border-gray-200 pb-6 items-center">
                        <!-- Product Image -->
                        <div class="w-28 h-28 bg-gray-100 flex-shrink-0">
                            <img src="@item.ProductThumbnail" alt="@item.ProductName" class="w-full h-full object-cover" />
                        </div>

                        <!-- Product Info -->
                        <div class="flex-1 space-y-2">
                            <h3 class="font-semibold text-lg uppercase tracking-wide">@item.ProductName</h3>
                            <div class="text-sm text-gray-600 space-y-1">
                                <p>MÀU SẮC: <span class="font-normal text-black uppercase">@item.Color</span></p>
                                <p>KÍCH THƯỚC: <span class="font-normal text-black">@item.Size</span></p>
                                <p class="font-semibold text-black text-base">@item.UnitPrice.ToString("N0")₫</p>
                            </div>

                            <!-- Quantity & Action Form -->
                            <div class="flex items-center gap-4">
                                <form method="post" asp-page-handler="UpdateQuantity" class="flex items-center gap-2">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="w-8 h-8 border border-gray-300 hover:border-black transition-colors font-semibold flex items-center justify-center">−</button>
                                    <span class="w-10 text-center font-medium">@item.Quantity</span>
                                    <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="w-8 h-8 border border-gray-300 hover:border-black transition-colors font-semibold flex items-center justify-center">+</button>
                                </form>

                                <form method="post" asp-page-handler="Remove" class="ml-auto">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <button type="submit" class="text-red-600 hover:text-red-800 transition-colors flex items-center gap-2">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        <span class="text-sm font-semibold">Xoá</span>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Subtotal -->
                        <div class="text-right">
                            <p class="font-semibold text-lg">@item.TotalPrice.ToString("N0")₫</p>
                        </div>
                    </div>
                }
            </div>

            <!-- Order Summary -->
            <div class="lg:col-span-1">
                <div class="bg-gray-50 p-8 sticky top-28 border border-gray-200">
                    <h2 class="text-2xl font-semibold mb-6 tracking-tight">TỔNG ĐƠN HÀNG</h2>

                    <div class="space-y-4 mb-6">
                        <div class="flex justify-between">
                            <span class="text-gray-600">Tổng sản phẩm (@Model.TotalItems)</span>
                            <span class="font-medium">@Model.TotalPrice.ToString("N0")₫</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Phí vận chuyển</span>
                            <span class="font-medium text-green-600">Miễn phí</span>
                        </div>
                        <div class="border-t border-gray-200 pt-4">
                            <div class="flex justify-between text-xl font-bold">
                                <span>Tổng cộng</span>
                                <span>@Model.TotalPrice.ToString("N0")₫</span>
                            </div>
                        </div>
                    </div>

                    <a href="/Checkout" class="block w-full bg-black text-white text-center py-4 font-semibold tracking-wider hover:bg-gray-800 transition-colors mb-4 uppercase">
                        TIẾN HÀNH THANH TOÁN
                    </a>

                    <a href="/" class="block w-full text-center py-3 border-2 border-black font-semibold hover:bg-black hover:text-white transition-colors uppercase">
                        TIẾP TỤC MUA SẮM
                    </a>

                    <!-- Promo Code -->
                    <div class="mt-8 pt-8 border-t border-gray-200">
                        <p class="font-semibold mb-3 tracking-wide">MÃ GIẢM GIÁ</p>
                        <div class="flex gap-2">
                            <input type="text" placeholder="Nhập mã" class="flex-1 border border-gray-300 px-4 py-2 outline-none focus:border-black text-sm" />
                            <button type="button" class="bg-black text-white px-6 py-2 font-semibold hover:bg-gray-800 transition-colors text-sm">ÁP DỤNG</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</main>

