@page
@model Web.Pages.CartModel
@{
    ViewData["Title"] = "Giỏ hàng — The Old Pavement";
}

<main class="px-4 md:px-8 lg:px-16 max-w-[1400px] mx-auto py-12 min-h-[70vh]">

    <!-- Page header -->
    <div class="border-b border-gray-100 pb-6 mb-10">
        <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-400 mb-1">The Old Pavement</p>
        <h1 class="text-3xl md:text-4xl font-black uppercase tracking-tight">Giỏ hàng
            @if (Model.CartItems.Count > 0)
            {
                <span class="text-gray-300 font-light ml-2">(@Model.TotalItems)</span>
            }
        </h1>
    </div>

    @if (Model.CartItems.Count == 0)
    {
        <!-- Empty state -->
        <div class="flex flex-col items-center justify-center py-24 text-center">
            <div class="w-20 h-20 border-2 border-dashed border-gray-200 flex items-center justify-center mb-6">
                <i data-lucide="shopping-bag" class="w-8 h-8 text-gray-300"></i>
            </div>
            <h2 class="text-xl font-black uppercase tracking-tight mb-2">Giỏ hàng trống</h2>
            <p class="text-sm text-gray-500 mb-8 max-w-xs">Chưa có sản phẩm nào. Khám phá bộ sưu tập của chúng tôi.</p>
            <a href="/Shop" class="inline-flex items-center gap-2 bg-black text-white px-8 py-3 text-xs font-bold tracking-widest uppercase hover:bg-gray-800 transition-colors">
                Khám phá Shop
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

            <!-- Cart items -->
            <div class="lg:col-span-7 xl:col-span-8 space-y-0 divide-y divide-gray-100">
                @foreach (var item in Model.CartItems)
                {
                    <div class="flex gap-5 py-6 items-start">
                        <!-- Image -->
                        <div class="w-24 h-24 md:w-28 md:h-28 bg-gray-50 border border-gray-100 flex-shrink-0 overflow-hidden">
                            <img src="@item.ProductThumbnail" alt="@item.ProductName" class="w-full h-full object-cover" />
                        </div>

                        <!-- Info -->
                        <div class="flex-1 min-w-0">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <p class="text-sm font-bold uppercase tracking-wide text-gray-900 line-clamp-2">@item.ProductName</p>
                                    <p class="text-xs text-gray-400 mt-1 uppercase tracking-wider font-medium">@item.Color · Size @item.Size</p>
                                </div>
                                <p class="text-sm font-black text-gray-900 flex-shrink-0 tabular-nums">@item.TotalPrice.ToString("N0")₫</p>
                            </div>

                            <div class="flex items-center justify-between mt-4">
                                <!-- Qty -->
                                <form method="post" asp-page-handler="UpdateQuantity" class="flex items-center gap-0 border border-gray-200">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <button type="submit" name="quantity" value="@(item.Quantity - 1)"
                                            class="w-8 h-8 flex items-center justify-center text-gray-500 hover:bg-gray-100 transition-colors text-sm font-bold">−</button>
                                    <span class="w-10 text-center text-sm font-semibold border-x border-gray-200 h-8 flex items-center justify-center tabular-nums">@item.Quantity</span>
                                    <button type="submit" name="quantity" value="@(item.Quantity + 1)"
                                            class="w-8 h-8 flex items-center justify-center text-gray-500 hover:bg-gray-100 transition-colors text-sm font-bold">+</button>
                                </form>

                                <!-- Remove -->
                                <form method="post" asp-page-handler="Remove">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <button type="submit" class="text-xs text-gray-400 hover:text-red-500 transition-colors flex items-center gap-1.5 font-medium">
                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                        Xoá
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }

                <!-- Continue shopping -->
                <div class="pt-6">
                    <a href="/Shop" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-gray-500 hover:text-black transition-colors">
                        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                        Tiếp tục mua sắm
                    </a>
                </div>
            </div>

            <!-- Order summary -->
            <div class="lg:col-span-5 xl:col-span-4">
                <div class="bg-gray-50 border border-gray-100 p-6 sticky top-28">
                    <h2 class="text-xs font-black uppercase tracking-[0.18em] text-gray-900 mb-6 pb-4 border-b border-gray-200">Tóm tắt đơn hàng</h2>

                    <div class="space-y-3 mb-6">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500">Tạm tính (@Model.TotalItems sản phẩm)</span>
                            <span class="font-semibold tabular-nums">@Model.TotalPrice.ToString("N0")₫</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500">Phí vận chuyển</span>
                            <span class="font-semibold text-emerald-600">Miễn phí</span>
                        </div>
                    </div>

                    <div class="border-t border-gray-200 pt-4 mb-6">
                        <div class="flex justify-between">
                            <span class="text-sm font-black uppercase tracking-wide">Tổng cộng</span>
                            <span class="text-lg font-black tabular-nums">@Model.TotalPrice.ToString("N0")₫</span>
                        </div>
                    </div>

                    <a href="/Checkout"
                       class="block w-full bg-black text-white text-center py-3.5 text-xs font-black uppercase tracking-[0.18em] hover:bg-gray-800 transition-colors mb-3">
                        Tiến hành thanh toán
                    </a>

                    <!-- Trust badges -->
                    <div class="grid grid-cols-3 gap-2 mt-5 pt-5 border-t border-gray-200">
                        <div class="text-center">
                            <i data-lucide="shield-check" class="w-4 h-4 mx-auto text-gray-400 mb-1"></i>
                            <p class="text-[9px] text-gray-400 font-semibold uppercase tracking-wide leading-tight">Thanh toán<br/>bảo mật</p>
                        </div>
                        <div class="text-center">
                            <i data-lucide="refresh-cw" class="w-4 h-4 mx-auto text-gray-400 mb-1"></i>
                            <p class="text-[9px] text-gray-400 font-semibold uppercase tracking-wide leading-tight">Đổi trả<br/>7 ngày</p>
                        </div>
                        <div class="text-center">
                            <i data-lucide="truck" class="w-4 h-4 mx-auto text-gray-400 mb-1"></i>
                            <p class="text-[9px] text-gray-400 font-semibold uppercase tracking-wide leading-tight">Ship toàn<br/>quốc</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</main>
