@page
@model TheOldPavement.Web.Pages.Public.Payment.MomoSimulateModel
@{
    ViewData["Title"] = "Cổng Thanh Toán MoMo";
    var amount = Request.Query["amount"].ToString();
    var orderId = Request.Query["orderId"].ToString();
    var orderInfo = Request.Query["orderInfo"].ToString();
    var amountFormatted = decimal.TryParse(amount, out var amt) ? amt.ToString("N0") : amount;
}

<style>
    body { background: #f5f5f5; }
    .momo-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f5f5f5 0%, #ffe6f0 100%);
        padding: 2rem 1rem;
    }
    .momo-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(163, 13, 82, 0.15);
        max-width: 480px;
        width: 100%;
        overflow: hidden;
    }
    .momo-header {
        background: linear-gradient(135deg, #ae0051 0%, #d0006f 50%, #e8006f 100%);
        padding: 2rem;
        text-align: center;
        color: white;
    }
    .momo-logo {
        width: 70px;
        height: 70px;
        background: white;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 1.5rem;
        font-weight: 900;
        color: #ae0051;
        letter-spacing: -1px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
    .momo-header h1 { font-size: 1.1rem; opacity: 0.9; margin: 0; font-weight: 600; letter-spacing: 1px; }
    .momo-body { padding: 2rem; }
    .order-info-block {
        background: #fef6f9;
        border: 1px solid #fce4ef;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
    }
    .order-info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.4rem 0;
        font-size: 0.875rem;
        border-bottom: 1px dashed #fce4ef;
    }
    .order-info-row:last-child { border-bottom: none; }
    .order-info-row .label { color: #888; }
    .order-info-row .value { font-weight: 700; color: #1a1a1a; }
    .amount-big { font-size: 2rem; font-weight: 900; color: #ae0051; text-align: center; padding: 1rem 0 1.5rem; letter-spacing: -1px; }
    .dev-notice {
        background: #fff8e1;
        border: 1px dashed #ffc107;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 0.75rem;
        color: #856404;
        margin-bottom: 1.5rem;
        text-align: center;
    }
    .btn-momo-success {
        display: block;
        width: 100%;
        background: linear-gradient(135deg, #ae0051, #d0006f);
        color: white;
        text-align: center;
        padding: 1rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        letter-spacing: 0.5px;
        transition: all 0.2s ease;
        margin-bottom: 0.75rem;
        border: none;
        cursor: pointer;
    }
    .btn-momo-success:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(174,0,81,0.4); color: white; text-decoration: none; }
    .btn-momo-cancel {
        display: block;
        width: 100%;
        background: white;
        color: #ae0051;
        text-align: center;
        padding: 0.9rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        border: 2px solid #ae0051;
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .btn-momo-cancel:hover { background: #fef6f9; color: #ae0051; text-decoration: none; }
    .spinner {
        display: none;
        width: 20px;
        height: 20px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top: 2px solid white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .momo-footer { text-align: center; padding: 1rem 2rem 1.5rem; font-size: 0.7rem; color: #bbb; }
</style>

<div class="momo-container">
    <div class="momo-card">
        <div class="momo-header">
            <div class="momo-logo">mo<br>mo</div>
            <h1>CỔNG THANH TOÁN MOMO</h1>
        </div>
        <div class="momo-body">
            <div class="order-info-block">
                <div class="order-info-row">
                    <span class="label">Nhà cung cấp</span>
                    <span class="value">The Old Pavement Store</span>
                </div>
                <div class="order-info-row">
                    <span class="label">Mã đơn hàng</span>
                    <span class="value">@orderId</span>
                </div>
                <div class="order-info-row">
                    <span class="label">Mô tả</span>
                    <span class="value" style="max-width:200px;text-align:right;font-size:0.8rem">@orderInfo</span>
                </div>
            </div>

            <div class="amount-big">@amountFormatted₫</div>

            <div class="dev-notice">
                🧪 <strong>Môi trường thử nghiệm (Demo Mode)</strong><br>
                Chọn kết quả giao dịch bên dưới để kiểm tra luồng hoạt động của hệ thống.
            </div>

            <a id="btn-success"
               href="/Public/Payment/MomoSimulate?handler=Success&orderId=@orderId&amount=@amount&orderInfo=@Uri.EscapeDataString(orderInfo)"
               class="btn-momo-success"
               onclick="showSpinner(this)">
                ✅ &nbsp; Giả lập thanh toán thành công
            </a>

            <a id="btn-cancel"
               href="/Public/Payment/MomoSimulate?handler=Cancel&orderId=@orderId&amount=@amount&orderInfo=@Uri.EscapeDataString(orderInfo)"
               class="btn-momo-cancel">
                ✕ &nbsp; Hủy giao dịch
            </a>
        </div>
        <div class="momo-footer">© 2024 · Cổng thanh toán MoMo · Demo Mode</div>
    </div>
</div>

<script>
    function showSpinner(btn) {
        btn.innerHTML = '<div class="spinner" style="display:inline-block"></div>';
        btn.style.pointerEvents = 'none';
    }
</script>
