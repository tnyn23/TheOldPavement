@page
@model TheOldPavement.Web.Pages.Public.Account.RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="flex items-center justify-center min-h-[70vh] bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-white p-8 border border-gray-200 rounded-lg shadow-sm">
        <div>
            <h2 class="mt-2 text-center text-3xl font-extrabold text-gray-900 tracking-tight">
                Tạo tài khoản mới
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                Đã có tài khoản?
                <a href="/Public/Account/Login" class="font-medium text-black hover:underline">
                    Đăng nhập tại đây
                </a>
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-md text-sm">
                @Model.ErrorMessage
            </div>
        }
        
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="bg-green-50 border border-green-200 text-green-600 px-4 py-3 rounded-md text-sm">
                @Model.SuccessMessage
            </div>
        }

        <form class="mt-8 space-y-6" method="post">
            <div class="space-y-4">
                <div>
                    <label for="fullName" class="block text-sm font-medium text-gray-700">Họ và tên</label>
                    <input id="fullName" name="FullName" type="text" required asp-for="FullName"
                           class="mt-1 appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-black focus:border-black focus:z-10 sm:text-sm"
                           placeholder="Nguyễn Văn A">
                    <span asp-validation-for="FullName" class="text-xs text-red-500"></span>
                </div>
                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
                    <input id="email" name="Email" type="email" autocomplete="email" required asp-for="Email"
                           class="mt-1 appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-black focus:border-black focus:z-10 sm:text-sm"
                           placeholder="Địa chỉ email">
                    <span asp-validation-for="Email" class="text-xs text-red-500"></span>
                </div>
                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700">Mật khẩu</label>
                    <input id="password" name="Password" type="password" required asp-for="Password"
                           class="mt-1 appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-black focus:border-black focus:z-10 sm:text-sm"
                           placeholder="Mật khẩu (ít nhất 6 ký tự)">
                    <span asp-validation-for="Password" class="text-xs text-red-500"></span>
                </div>
                <div>
                    <label for="confirmPassword" class="block text-sm font-medium text-gray-700">Xác nhận mật khẩu</label>
                    <input id="confirmPassword" name="ConfirmPassword" type="password" required asp-for="ConfirmPassword"
                           class="mt-1 appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-black focus:border-black focus:z-10 sm:text-sm"
                           placeholder="Nhập lại mật khẩu">
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-red-500"></span>
                </div>
            </div>

            <div>
                <button type="submit"
                        class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-black hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-black transition-colors uppercase tracking-wide">
                    Đăng ký
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
