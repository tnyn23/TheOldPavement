@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!-- Hero Section -->
<section class="relative h-[70vh] min-h-[500px] bg-gray-100 flex items-center justify-center overflow-hidden mb-16">
    <div class="absolute inset-0">
        <img src="https://images.unsplash.com/photo-1754593656047-c46db5ead9dc?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxwbGFpbiUyMHdoaXRlJTIwdGVlJTIwcHJvZHVjdCUyMHBob3RvZ3JhcGh5fGVufDF8fHx8MTc3MzY3NDM4N3ww&ixlib=rb-4.1.0&q=80&w=1080"
             alt="The Old Pavement Collection"
             class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/20"></div>
    </div>
    <div class="relative z-10 text-center px-4">
        <h1 class="text-5xl md:text-7xl lg:text-8xl mb-6 tracking-tight text-white font-bold">
            36 PHỐ PHƯỜNG
        </h1>
        <p class="text-lg md:text-xl mb-8 tracking-wide max-w-2xl mx-auto text-white drop-shadow-md">
            Streetwear lấy cảm hứng từ văn hóa phố cổ Hà Nội - Vintage yet modern
        </p>
        <a href="/product/36-pho-phuong"
           class="inline-block bg-black text-white px-12 py-4 font-semibold tracking-wide hover:bg-gray-800 transition-colors">
            KHÁM PHÁT NGAY
        </a>
    </div>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="max-w-[1400px] mx-auto px-4 md:px-8 lg:px-16 pt-24 -mb-16">
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4" role="alert">
            <p class="font-bold">Thành công</p>
            <p>@TempData["SuccessMessage"]</p>
        </div>
    </div>
}

<!-- Product Grid -->
<div class="px-4 md:px-8 lg:px-16 max-w-[1400px] mx-auto pb-16">
    <div class="flex justify-between items-end mb-8">
        <h2 class="text-2xl font-bold tracking-tight uppercase">Sản phẩm nổi bật</h2>
        <a href="/shop" class="text-sm font-semibold underline hover:opacity-60 transition-opacity">Xem tất cả</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-12">
        @foreach (var product in Model.FeaturedProducts)
        {
            var imageUrl = product.ProductImages?.FirstOrDefault(img => img.IsPrimary == true)?.ImageUrl 
                ?? product.ProductImages?.FirstOrDefault()?.ImageUrl 
                ?? "https://images.unsplash.com/photo-1651761179569-4ba2aa054997?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080";

            <div class="group cursor-pointer relative">
                <a href="/Product/@product.Slug" class="block">
                    <!-- Product Image -->
                    <div class="relative bg-gray-50 mb-4 overflow-hidden aspect-square">
                        <img src="@imageUrl"
                             alt="@product.Name"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                        
                        @if (product.IsCollab == true)
                        {
                            <div class="absolute bottom-3 left-3 bg-black text-white px-3 py-1 text-xs font-bold tracking-wide">
                                Collab
                            </div>
                        }
                    </div>
                </a>

                <!-- Floating Quick Add Button Form -->
                <form method="post" asp-page-handler="QuickAdd" class="absolute bottom-16 right-4 z-20">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <input type="hidden" name="productName" value="@product.Name" />
                    <input type="hidden" name="price" value="@product.Price" />
                    <input type="hidden" name="slug" value="@product.Slug" />
                    <button type="submit" 
                            class="bg-black text-white p-3 rounded-full shadow-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 hover:bg-gray-800 hover:scale-110 flex items-center justify-center"
                            title="Thêm nhanh vào giỏ hàng">
                        <i data-lucide="shopping-bag" class="w-5 h-5"></i>
                    </button>
                </form>

                <a href="/Product/@product.Slug" class="block">
                    <!-- Product Info -->
                    <div class="space-y-2">
                        <h3 class="text-sm font-medium leading-tight uppercase tracking-wide group-hover:opacity-60 transition-opacity">
                            @product.Name
                        </h3>
                        <p class="font-semibold">@product.Price.ToString("N0")₫</p>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<!-- Newsletter -->
<section class="bg-black text-white py-24">
    <div class="px-4 md:px-8 lg:px-16 max-w-2xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 tracking-tight">NHẬN BẢN TIN TỪ THE OLD PAVEMENT</h2>
        <p class="text-gray-400 mb-8 leading-relaxed">
            Đăng ký để nhận thông tin về các bộ sưu tập mới, đợt restock và ưu đãi độc quyền.
        </p>
        <form class="flex flex-col sm:flex-row gap-4" action="/subscribe" method="post">
            <input type="email" name="email" placeholder="Địa chỉ email của bạn" required
                   class="flex-1 bg-transparent border border-white/20 px-4 py-3 outline-none focus:border-white transition-colors" />
            <button type="submit" class="bg-white text-black px-8 py-3 font-semibold hover:bg-gray-200 transition-colors uppercase tracking-wide">
                Đăng ký
            </button>
        </form>
    </div>
</section>
